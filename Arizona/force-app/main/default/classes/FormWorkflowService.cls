/**
 * FormWorkflowService
 * -----------------------------------------------------------------------
 * Persistence and routing for the "Certificate and Documents" form list.
 *
 * THE WORKFLOW (v10 - current)
 *
 *   None                                    starting state
 *     |  staff clicks "Send the Form"
 *     |  -> TS Documents generates a PDF, it's emailed to the Contact
 *     |     as an attachment, along with a public "Open Document" link
 *     |     so they can view it in their browser without logging in
 *     v
 *   Sent                                    waiting on the contact
 *     |  contact reviews/signs the PDF and returns it (email reply,
 *     |  upload, etc. - outside this class), OR staff uploads the
 *     |  signed copy on their behalf
 *     v
 *   Pending -> Completed                    via the manual upload path
 *              below (uploadFormFile / promoteSignedToFinal)
 *
 * WHERE STATE LIVES
 *   Status : the Contact field named by the form's apiName
 *   Files  : ContentDocument linked to the Contact, titled after the form
 *
 * v10 - PORTAL/TOKEN FLOW REMOVED, PUBLIC FILE LINK INSTEAD
 * Previously, sendFormToContact() created a Form_Request__c with a
 * random token and emailed a link to an Experience Cloud page
 * (CustomerFormController + customFormPage LWC) where the contact could
 * edit the PDF's own fields in-browser via pdf-lib. That required a
 * dedicated site page and Guest User profile configuration (object/field
 * access, Apex class access) to work for unauthenticated visitors.
 *
 * That whole path has been replaced with Salesforce's built-in
 * ContentDistribution "public link" feature: the same ContentVersion
 * that's attached to the email also gets a public, Salesforce-hosted
 * share link (view/download only, no login). This link is generated by
 * the staff member's own (already-authenticated) session when they
 * click "Send the Form", so no Guest User / Experience Cloud
 * configuration is required at all.
 *
 * Trade-off: the contact can view/download the PDF online, but can no
 * longer fill in its fields and submit them back in-browser the way the
 * portal page allowed. If that capability is needed again later,
 * CustomerFormController / customFormPage / Form_Request__c are the
 * building blocks to reintroduce - they were simply not wired up here
 * anymore as of v10.
 *
 * v9 - GOOGLE DOCS PATH REMOVED
 * Every form is now PDF only, no exceptions. Previously,
 * sendFormToContact() had a fallback branch that would email a raw
 * Google Doc edit link (target.mode == 'gdoc') if TSDocumentService
 * could not produce a PDF for the requested template. That branch, the
 * retired saveEditableCopy() method (v3-v5), and their dependencies
 * (PerContactDocumentService, GoogleDriveService) have all been deleted.
 * If a PDF cannot be generated/found, sendFormToContact() now throws
 * instead of ever emailing a Google Doc link.
 *
 * v6 - MANUAL UPLOAD, PDF REQUIRED
 * uploadFormFile() rejects anything that isn't a .pdf for the
 * "signed"/"final" stages (AuraHandledException with instructions to
 * download as PDF from Google Docs first).
 *
 * v7 - NO SECOND UPLOAD TO REACH COMPLETED
 * promoteSignedToFinal() copies the "Signed" PDF straight into the
 * "<label> - Final" slot and flips status to Completed in one step - no
 * file picker involved for that step.
 *
 * v15 - PORTAL-SAFE PDF OPENING
 * openBasedFormForContact() now uses TSDocumentService.getExistingPdfOnly()
 * instead of getReviewTarget(), so portal users never trigger Google
 * authentication. Contacts can now safely click "Review and Complete"
 * without risking a 400 error if Google auth fails.
 */
public with sharing class FormWorkflowService {

    private static final Map<String, List<String>> STATUS_CANDIDATES =
        new Map<String, List<String>>{
            'None'      => new List<String>{ 'None', 'Not Started', 'New' },
            'Sent'      => new List<String>{ 'Sent', 'Sent to Contact', 'Awaiting Contact', 'Pending' },
            'Pending'   => new List<String>{ 'Pending', 'In Review', 'Awaiting Review' },
            'Completed' => new List<String>{ 'Completed', 'Complete', 'Approved' },
            'Rejected'  => new List<String>{ 'Rejected', 'Declined' },
            'Expired'   => new List<String>{ 'Expired' },
            'Not Needed' => new List<String>{ 'Not Needed' }    
        };
    private static final String SUFFIX_CONTACT  = ' - Signed';
    private static final String SUFFIX_FINAL    = ' - Final';
    private static final String SUFFIX_UPLOADED = ' - Uploaded';

    /** Titles of legacy per-contact Google Doc reference files that may
     *  still exist on older records - filtered out of the file list.
     *  (PerContactDocumentService, which used to own this constant, has
     *  been removed along with the Google Doc flow.) */
    private static final String LEGACY_GDOC_LINK_SUFFIX = ' - GDoc Link';

    public class FormWorkflowException extends Exception {}

    public class FormFile {
        @AuraEnabled public String  contentDocumentId;
        @AuraEnabled public String  name;
        @AuraEnabled public String  url;
        @AuraEnabled public String  stage;
        @AuraEnabled public Datetime createdDate;
    }

    public class FormState {
        @AuraEnabled public String  fieldApiName;
        @AuraEnabled public String  label;
        @AuraEnabled public String  status;
        @AuraEnabled public String  rawStatus;
        @AuraEnabled public Boolean fieldExists;
        @AuraEnabled public Boolean canUpload;
        @AuraEnabled public Boolean canSend;
        @AuraEnabled public String  nextAction;
        @AuraEnabled public List<FormFile> files;
        @AuraEnabled public String  message;
        @AuraEnabled public String  documentUrl;
        @AuraEnabled public String  documentMode;
        @AuraEnabled public String  uploadLabel;
        @AuraEnabled public String  openContentDocumentId;
        @AuraEnabled public Boolean emailSent;
        @AuraEnabled public String  templateName;
    }

    @AuraEnabled
    public static List<FormState> getFormStates(
        Id recordId, List<String> fields, List<String> labels
    ) {
        List<FormState> out = new List<FormState>();
        if (recordId == null) {
            return out;
        }
        if (fields == null || fields.isEmpty()) {
            if (labels == null || labels.isEmpty()) {
                return out;
            }
            fields = new List<String>();
            for (Integer i = 0; i < labels.size(); i++) {
                fields.add('');
            }
        }
        Schema.SObjectType objType = recordId.getSObjectType();
        Map<String, Schema.SObjectField> fieldMap =
            objType.getDescribe().fields.getMap();
        List<String> queryable = new List<String>();
        for (String f : fields) {
            if (String.isBlank(f)) {
                continue;
            }
            Schema.SObjectField token = fieldMap.get(f.toLowerCase());
            if (token != null && token.getDescribe().isAccessible()) {
                queryable.add(f);
            }
        }
        SObject record;
        if (!queryable.isEmpty()) {
            String soql = 'SELECT Id, ' + String.join(new List<String>(
                    new Set<String>(queryable)), ', ')
                + ' FROM ' + objType.getDescribe().getName()
                + ' WHERE Id = :recordId LIMIT 1';
            List<SObject> rows = Database.query(soql);
            record = rows.isEmpty() ? null : rows[0];
        }
        List<ContentDocumentLink> allFiles = [
            SELECT ContentDocumentId,
                   ContentDocument.Title,
                   ContentDocument.FileExtension,
                   ContentDocument.CreatedDate
            FROM ContentDocumentLink
            WHERE LinkedEntityId = :recordId
            ORDER BY ContentDocument.CreatedDate DESC
        ];
        for (Integer i = 0; i < fields.size(); i++) {
            String field = fields[i];
            String label = (labels != null && i < labels.size()) ? labels[i] : field;
            FormState st = new FormState();
            st.fieldApiName = field;
            st.label        = label;
            st.files        = filesForLabel(allFiles, label);
            Schema.SObjectField token =
                String.isBlank(field) ? null : fieldMap.get(field.toLowerCase());
            if (token == null) {
                st.fieldExists = false;
                st.status      = deriveStatusFromFiles(st.files);
                if (String.isNotBlank(field)) {
                    st.message = 'No field named "' + field + '" on '
                               + objType.getDescribe().getName()
                               + ' - status is derived from the uploaded files.';
                }
            } else {
                st.fieldExists = true;
                Object raw = (record == null) ? null : record.get(field);
                st.rawStatus = (raw == null) ? null : String.valueOf(raw);
                st.status    = toLogicalStatus(st.rawStatus);
            }
            applyTransitions(st);
            out.add(st);
        }
        return out;
    }

    @AuraEnabled
    public static List<FormState> getFilesByLabel(Id recordId, List<String> labels) {
        List<String> blankFields = new List<String>();
        for (Integer i = 0; i < (labels == null ? 0 : labels.size()); i++) {
            blankFields.add('');
        }
        return getFormStates(recordId, blankFields, labels);
    }

    private static String resolveTemplateName(String formLabel, Id recordId) {
        if (String.isBlank(formLabel)) {
            return formLabel;
        }
        try {
            Map<String, String> matched = TSDocumentService.matchTemplates(
                new List<String>{ formLabel },
                String.valueOf(recordId.getSObjectType())
            );
            if (matched != null && matched.containsKey(formLabel)) {
                return matched.get(formLabel);
            }
        } catch (Exception ignored) {
            // fall through to the label
        }
        return formLabel;
    }

    /* =====================================================================
     * ACTION 1 - send the form to the contact
     * v10: PDF is attached AND a public "Open Document" view link is
     * generated via ContentDistribution. If TSDocumentService cannot
     * produce a PDF for the template, this throws - it never falls back
     * to a Google Doc link.
     * ===================================================================== */
    @AuraEnabled
    public static FormState sendFormToContact(
        Id recordId, String fieldApiName, String formLabel, String templateName
    ) {
        Contact who = loadContact(recordId);
        if (String.isBlank(who.Email)) {
            throw new AuraHandledException(
                who.Name + ' has no email address, so the form cannot be sent. '
                + 'Add one to the Contact first.'
            );
        }

        String resolvedTemplate = String.isBlank(templateName)
            ? resolveTemplateName(formLabel, recordId)
            : templateName;

        String attachedContentDocumentId;

        TSDocumentService.GeneratedDocument generated;
        try {
            generated = TSDocumentService.generateDocument(recordId, resolvedTemplate);
        } catch (Exception e) {
            generated = null;
        }

        if (generated != null
            && generated.unsupported != true
            && generated.pending != true
            && String.isNotBlank(generated.contentDocumentId)) {

            attachedContentDocumentId = generated.contentDocumentId;

        } else if (generated != null && generated.pending == true) {

            setStatus(recordId, fieldApiName, 'Sent');
            FormState pendingState = singleState(recordId, fieldApiName, formLabel);
            pendingState.message = 'Generating "' + formLabel + '" - it will be '
                + 'emailed to ' + who.Email + ' as soon as it is ready.';
            pendingState.emailSent = false;
            return pendingState;

        } else {

            TSDocumentService.ReviewTarget target =
                TSDocumentService.getReviewTarget(recordId, resolvedTemplate);

            // PDF only - if the target isn't a real file, we do not fall
            // back to a Google Doc / other link. Fail loudly instead.
            if (target == null || !target.available || target.mode != 'file') {
                throw new AuraHandledException(
                    (target != null && String.isNotBlank(target.message))
                        ? target.message
                        : 'No PDF is available for "' + formLabel + '" yet. '
                          + 'Generate the document before sending.'
                );
            }

            attachedContentDocumentId = target.contentDocumentId;
        }

        Messaging.EmailFileAttachment attachment;
        String attachedName;
        String documentUrl;

        if (String.isNotBlank(attachedContentDocumentId)) {
            List<ContentVersion> versions = [
                SELECT Id, Title, FileExtension, VersionData
                FROM ContentVersion
                WHERE ContentDocumentId = :attachedContentDocumentId
                  AND IsLatest = true
                LIMIT 1
            ];
            if (!versions.isEmpty()) {
                ContentVersion cv = versions[0];
                attachedName = fileNameWithExtension(cv.Title, cv.FileExtension);
                attachment = new Messaging.EmailFileAttachment();
                attachment.setFileName(attachedName);
                attachment.setBody(cv.VersionData);

                documentUrl = buildPublicDocumentUrl(cv.Id);
            }
        }

        sendEmail(
            new List<String>{ who.Email },
            formLabel + ' - please review and complete',
            buildContactEmailBody(who, formLabel, documentUrl),
            attachment,
            recordId
        );

        setStatus(recordId, fieldApiName, 'Sent');

        FormState st = singleState(recordId, fieldApiName, formLabel);
        st.message = 'Sent to ' + who.Email
                   + (attachedName == null ? '' : ' with ' + attachedName + ' attached.');
        st.documentMode = 'pdf';
        st.documentUrl  = documentUrl;
        return st;
    }

    /**
     * Generates a Salesforce-hosted public share link for a file, so the
     * contact can open/view the PDF straight in their browser with no
     * login, no Guest User, no custom portal page required. Created by
     * the staff member's own authenticated session, so no Experience
     * Cloud / Guest User configuration is needed for this to work.
     */
    private static String buildPublicDocumentUrl(Id contentVersionId) {
        ContentDistribution cd = new ContentDistribution();
        cd.Name                             = 'Form Document';
        cd.ContentVersionId                 = contentVersionId;
        cd.PreferencesAllowViewInBrowser    = true;
        cd.PreferencesAllowOriginalDownload = true;
        cd.PreferencesPasswordRequired      = false;
        cd.PreferencesNotifyOnVisit         = false;
        insert cd;

        cd = [
            SELECT DistributionPublicUrl
            FROM ContentDistribution
            WHERE Id = :cd.Id
            LIMIT 1
        ];
        return cd.DistributionPublicUrl;
    }

    /**
     * v15 - Portal self-service "Review and Complete the form"
     * 
     * PORTAL-SAFE: Uses getExistingPdfOnly() instead of getReviewTarget()
     * to ONLY open PDFs that have already been generated (by staff via
     * "Send the Form"). Never attempts a live Google Doc export, so portal
     * users cannot trigger Google authentication errors.
     *
     * If no PDF exists yet, returns a friendly message asking them to
     * check back later - no Google error, just a plain user message.
     *
     * Saves a "<label> - Signed" tagged copy of the PDF, which makes
     * deriveStatusFromFiles() report the row as Pending (awaiting staff
     * review) the moment the response comes back - appropriate since the
     * contact has just engaged with the form.
     *
     * Returns the ContentDocumentId to open in the PDF viewer.
     */
    @AuraEnabled
    public static FormState openBasedFormForContact(
        Id recordId, String formLabel, String templateName
    ) {
        if (String.isBlank(formLabel)) {
            throw new AuraHandledException('No form label was supplied.');
        }

        String resolvedTemplate = String.isBlank(templateName)
            ? resolveTemplateName(formLabel, recordId)
            : templateName;

        // PORTAL-SAFE: Use getExistingPdfOnly() - no Google auth attempt
        TSDocumentService.ReviewTarget target =
            TSDocumentService.getExistingPdfOnly(recordId, resolvedTemplate);

        if (target == null || !target.available || target.mode != 'file') {
            throw new AuraHandledException(
                (target != null && String.isNotBlank(target.message))
                    ? target.message
                    : 'This form has not been generated yet. '
                      + 'Please check back later or contact support.'
            );
        }

        Id viewableDocId = target.contentDocumentId;

        List<ContentVersion> versions = [
            SELECT VersionData
            FROM ContentVersion
            WHERE ContentDocumentId = :target.contentDocumentId
              AND IsLatest = true
            LIMIT 1
        ];

        if (!versions.isEmpty()) {
            String pendingTitle = formLabel + SUFFIX_CONTACT; // ' - Signed'
            Id existingPendingDocId = findDocumentByTitle(recordId, pendingTitle);

            ContentVersion cv = new ContentVersion();
            cv.Title          = pendingTitle;
            cv.PathOnClient   = pendingTitle + '.pdf';
            cv.VersionData    = versions[0].VersionData;
            cv.IsMajorVersion = true;
            if (existingPendingDocId != null) {
                cv.ContentDocumentId = existingPendingDocId;
            }
            insert cv;

            if (existingPendingDocId == null) {
                Id newDocId = [
                    SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id
                ].ContentDocumentId;
                insert new ContentDocumentLink(
                    ContentDocumentId = newDocId,
                    LinkedEntityId    = recordId,
                    ShareType         = 'V',
                    Visibility        = 'AllUsers'
                );
            }
        }

        FormState st = singleState(recordId, null, formLabel);
        st.documentMode          = 'pdf';
        st.openContentDocumentId = viewableDocId;
        st.message               = 'Form opened successfully.';
        return st;
    }

    /* =====================================================================
     * ACTION 2 & 3 - manual uploads (fallback path)
     * ===================================================================== */
    @AuraEnabled
    public static FormState uploadFormFile(
        Id recordId, String fieldApiName, String formLabel,
        String fileName, String base64Data, String stage
    ) {
        if (String.isBlank(base64Data)) {
            throw new AuraHandledException('No file content was received.');
        }
        Boolean isFinal  = (stage == 'final');
        Boolean isPlain  = (stage == 'upload');
        String title = formLabel
            + (isPlain ? SUFFIX_UPLOADED : (isFinal ? SUFFIX_FINAL : SUFFIX_CONTACT));
        Blob body;
        try {
            body = EncodingUtil.base64Decode(base64Data);
        } catch (Exception e) {
            throw new AuraHandledException('The uploaded file could not be read.');
        }
        String extension = extensionOf(fileName);
        if (!isPlain && !'pdf'.equalsIgnoreCase(extension)) {
            throw new AuraHandledException(
                'Please upload a PDF file.'
            );
        }
        ContentVersion cv = new ContentVersion();
        cv.Title          = title;
        cv.PathOnClient   = title + (String.isBlank(extension) ? '' : '.' + extension);
        cv.VersionData    = body;
        cv.IsMajorVersion = true;
        Id existingDocId = findDocumentByTitle(recordId, title);
        if (existingDocId != null) {
            cv.ContentDocumentId = existingDocId;
        }
        insert cv;
        Id contentDocId = [
            SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id
        ].ContentDocumentId;
        if (existingDocId == null) {
            insert new ContentDocumentLink(
                ContentDocumentId = contentDocId,
                LinkedEntityId    = recordId,
                ShareType         = 'V',
                Visibility        = 'AllUsers'
            );
        }
        String note;
        if (isPlain) {
            FormState plainState = singleState(recordId, fieldApiName, formLabel);
            plainState.message = 'Saved to this contact\'s files.';
            return plainState;
        }
        setStatus(recordId, fieldApiName, isFinal ? 'Completed' : 'Pending');
        if (!isFinal) {
            Contact who;
            String ownerEmail;
            try {
                who = loadContact(recordId);
                ownerEmail = who.Owner != null ? who.Owner.Email : null;
            } catch (Exception e) {
                who = null;
                ownerEmail = null;
            }
            if (String.isNotBlank(ownerEmail)) {
                sendEmail(
                    new List<String>{ ownerEmail },
                    'Review needed: ' + formLabel + ' for ' + who.Name,
                    buildOwnerEmailBody(who, formLabel, contentDocId),
                    null,
                    recordId
                );
                note = 'Saved. ' + ownerEmail + ' has been asked to review it.';
            } else {
                note = 'Saved, but the Contact Owner has no email address, '
                     + 'so no review notification was sent.';
            }
        } else {
            note = 'Final copy saved to Files.';
        }
        FormState st = singleState(recordId, fieldApiName, formLabel);
        st.message = note;
        return st;
    }

    @AuraEnabled
    public static FormState promoteSignedToFinal(
        Id recordId, String fieldApiName, String formLabel
    ) {
        String signedTitle = formLabel + SUFFIX_CONTACT;
        String finalTitle  = formLabel + SUFFIX_FINAL;

        Id signedDocId = findDocumentByTitle(recordId, signedTitle);
        if (signedDocId == null) {
            throw new AuraHandledException(
                'No signed PDF has been uploaded yet for "' + formLabel + '". '
                + 'Click "Upload signed form" first.'
            );
        }

        List<ContentVersion> signedVersions = [
            SELECT VersionData
            FROM ContentVersion
            WHERE ContentDocumentId = :signedDocId AND IsLatest = true
            LIMIT 1
        ];
        if (signedVersions.isEmpty() || signedVersions[0].VersionData == null) {
            throw new AuraHandledException(
                'The signed PDF for "' + formLabel + '" could not be read.'
            );
        }

        ContentVersion cv = new ContentVersion();
        cv.Title          = finalTitle;
        cv.PathOnClient   = finalTitle + '.pdf';
        cv.VersionData    = signedVersions[0].VersionData;
        cv.IsMajorVersion = true;

        Id existingFinalDocId = findDocumentByTitle(recordId, finalTitle);
        if (existingFinalDocId != null) {
            cv.ContentDocumentId = existingFinalDocId;
        }
        insert cv;

        if (existingFinalDocId == null) {
            Id contentDocId = [
                SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id
            ].ContentDocumentId;
            insert new ContentDocumentLink(
                ContentDocumentId = contentDocId,
                LinkedEntityId    = recordId,
                ShareType         = 'V',
                Visibility        = 'AllUsers'
            );
        }

        setStatus(recordId, fieldApiName, 'Completed');

        FormState st = singleState(recordId, fieldApiName, formLabel);
        st.message = 'Final PDF saved to Files.';
        return st;
    }

    /* =====================================================================
     * STATUS
     * ===================================================================== */
    @AuraEnabled
    public static FormState setFormStatus(
        Id recordId, String fieldApiName, String formLabel, String logicalStatus
    ) {
        setStatus(recordId, fieldApiName, logicalStatus);
        return singleState(recordId, fieldApiName, formLabel);
    }

    private static void setStatus(Id recordId, String fieldApiName, String logicalStatus) {
        if (String.isBlank(fieldApiName)) {
            return;
        }
        Schema.SObjectType objType = recordId.getSObjectType();
        Schema.SObjectField token =
            objType.getDescribe().fields.getMap().get(fieldApiName.toLowerCase());
        if (token == null) {
            return;
        }
        Schema.DescribeFieldResult dfr = token.getDescribe();
        if (!dfr.isUpdateable()) {
            throw new AuraHandledException(
                'You do not have permission to update "' + dfr.getLabel() + '".'
            );
        }
        String value = pickStatusValue(dfr, logicalStatus);
        if (value == null) {
            throw new AuraHandledException(
                'None of the expected values for "' + logicalStatus + '" exist on the '
                + dfr.getLabel() + ' picklist. Add one of: '
                + String.join(STATUS_CANDIDATES.get(logicalStatus), ', ')
            );
        }
        SObject rec = objType.newSObject(recordId);
        rec.put(dfr.getName(), value);
        update rec;
    }

    private static String pickStatusValue(
        Schema.DescribeFieldResult dfr, String logicalStatus
    ) {
        List<String> candidates = STATUS_CANDIDATES.get(logicalStatus);
        if (candidates == null) {
            candidates = new List<String>{ logicalStatus };
        }
        if (dfr.getType() != Schema.DisplayType.PICKLIST
            && dfr.getType() != Schema.DisplayType.MULTIPICKLIST) {
            return candidates[0];
        }
        Set<String> available = new Set<String>();
        for (Schema.PicklistEntry entry : dfr.getPicklistValues()) {
            if (entry.isActive()) {
                available.add(entry.getValue().toLowerCase());
            }
        }
        for (String candidate : candidates) {
            if (available.contains(candidate.toLowerCase())) {
                return candidate;
            }
        }
        return null;
    }

    private static String toLogicalStatus(String raw) {
        if (String.isBlank(raw)) {
            return 'None';
        }
        String v = raw.toLowerCase();
        for (String logical : STATUS_CANDIDATES.keySet()) {
            for (String candidate : STATUS_CANDIDATES.get(logical)) {
                if (candidate.equalsIgnoreCase(v)) {
                    return logical;
                }
            }
        }
        return raw;
    }

    private static String deriveStatusFromFiles(List<FormFile> files) {
        if (files == null || files.isEmpty()) {
            return 'None';
        }
        Boolean hasSent = false;
        Boolean hasSigned = false;
        for (FormFile f : files) {
            if (f.stage == 'final') {
                return 'Completed';
            }
            if (f.stage == 'signed') {
                hasSigned = true;
            }
            if (f.stage == 'sent') {
                hasSent = true;
            }
        }
        if (hasSigned) {
            return 'Pending';
        }
        return hasSent ? 'Sent' : 'None';
    }

    private static void applyTransitions(FormState st) {
    String s = st.status;
    if (s == 'Completed') {
        st.canSend = false;  st.canUpload = false; st.nextAction = 'done';
    } else if (s == 'Pending') {
        st.canSend = false;  st.canUpload = true;  st.nextAction = 'uploadFinal';
    } else if (s == 'Sent') {
        st.canSend = true;   st.canUpload = true;  st.nextAction = 'uploadSigned';
    } else if (s == 'Rejected' || s == 'Expired') {
        st.canSend = true;   st.canUpload = true;  st.nextAction = 'send';
    } else if (s == 'Not Needed') {  // ◄── NEW CONDITION
        st.canSend = false;  st.canUpload = false; st.nextAction = 'notNeeded';  // ◄── NEW LINE
    } else {
        st.canSend = true;   st.canUpload = false; st.nextAction = 'send';
    }
    st.uploadLabel = (st.nextAction == 'uploadFinal')
        ? 'Upload final copy'
        : 'Upload signed form';
}

    /* =====================================================================
     * HELPERS
     * ===================================================================== */
    private static Contact loadContact(Id recordId) {
        List<Contact> rows = [
            SELECT Id, Name, FirstName, Email, OwnerId, Owner.Email, Owner.Name
            FROM Contact
            WHERE Id = :recordId
            LIMIT 1
        ];
        if (rows.isEmpty()) {
            throw new AuraHandledException('Contact not found.');
        }
        return rows[0];
    }

    private static FormState singleState(Id recordId, String fieldApiName, String label) {
        List<FormState> states = getFormStates(
            recordId,
            new List<String>{ fieldApiName },
            new List<String>{ label }
        );
        return states.isEmpty() ? new FormState() : states[0];
    }

    private static List<FormFile> filesForLabel(
        List<ContentDocumentLink> allFiles, String label
    ) {
        List<FormFile> out = new List<FormFile>();
        String key = normalize(label);
        if (String.isBlank(key)) {
            return out;
        }
        for (ContentDocumentLink link : allFiles) {
            String title = link.ContentDocument.Title;
            if (String.isBlank(title)) {
                continue;
            }
            if (title.endsWithIgnoreCase(LEGACY_GDOC_LINK_SUFFIX)) {
                continue;
            }
            String titleKey = normalize(title);
            if (!titleKey.startsWith(key) && !key.startsWith(titleKey)) {
                continue;
            }
            FormFile f = new FormFile();
            f.contentDocumentId = link.ContentDocumentId;
            f.name        = fileNameWithExtension(title, link.ContentDocument.FileExtension);
            f.url         = '/lightning/r/ContentDocument/' + link.ContentDocumentId + '/view';
            f.createdDate = link.ContentDocument.CreatedDate;
            String lower = title.toLowerCase();
            f.stage = lower.contains('final')  ? 'final'
                    : lower.contains('signed') ? 'signed'
                    : 'sent';
            out.add(f);
        }
        return out;
    }

    private static Id findDocumentByTitle(Id recordId, String title) {
        for (ContentDocumentLink link : [
            SELECT ContentDocumentId, ContentDocument.Title
            FROM ContentDocumentLink
            WHERE LinkedEntityId = :recordId
            ORDER BY ContentDocument.CreatedDate DESC
        ]) {
            if (title.equalsIgnoreCase(link.ContentDocument.Title)) {
                return link.ContentDocumentId;
            }
        }
        return null;
    }

    private static String fileNameWithExtension(String title, String extension) {
        if (String.isBlank(title)) {
            return '';
        }
        if (String.isBlank(extension)) {
            return title;
        }
        return title.endsWithIgnoreCase('.' + extension)
            ? title
            : title + '.' + extension;
    }

    private static String extensionOf(String fileName) {
        if (String.isBlank(fileName) || !fileName.contains('.')) {
            return '';
        }
        return fileName.substringAfterLast('.');
    }

    private static String normalize(String value) {
        if (String.isBlank(value)) {
            return '';
        }
        String key = value.toLowerCase().trim();
        key = key.replaceAll('\\.(pdf|png|jpe?g|docx?)$', '');
        key = key.replace('&', ' and ');
        key = key.replaceAll('\\s*[-]\\s*(english|spanish|espanol|signed|final)\\s*$', '');
        key = key.replaceAll('[^a-z0-9]', '');
        return key;
    }

    private static void sendEmail(
        List<String> to, String subject, String htmlBody,
        Messaging.EmailFileAttachment attachment, Id whatId
    ) {
        Messaging.SingleEmailMessage mail = new Messaging.SingleEmailMessage();
        mail.setToAddresses(to);
        mail.setSubject(subject);
        mail.setHtmlBody(htmlBody);
        mail.setSaveAsActivity(false);
        if (attachment != null) {
            mail.setFileAttachments(
                new List<Messaging.EmailFileAttachment>{ attachment }
            );
        }
        List<Messaging.SendEmailResult> results =
            Messaging.sendEmail(new List<Messaging.SingleEmailMessage>{ mail }, false);
        if (!results.isEmpty() && !results[0].isSuccess()) {
            throw new AuraHandledException(
                'The email could not be sent: '
                + results[0].getErrors()[0].getMessage()
            );
        }
    }

    /**
     * v10: same wording as before - greeting, "Please review and
     * complete the attached form: <label>.", instruction to return the
     * completed copy, sign-off. The PDF is attached to the email (see
     * sendFormToContact()) and, when a public view link was generated,
     * an "Open Document" link is folded into the same sentence about
     * returning it, so the contact has both options: view/download it
     * online, or work from the attached PDF directly and send it back.
     */
    private static String buildContactEmailBody(
        Contact who, String formLabel, String documentUrl
    ) {
        String greeting = String.isBlank(who.FirstName) ? 'Hello' : 'Hello ' + who.FirstName;
        String body = '<p>' + greeting + ',</p>'
            + '<p>Please review and complete the attached form: <b>'
            + htmlEncode(formLabel) + '</b>.</p>';
        if (String.isNotBlank(documentUrl)) {
            body += '<p>Once completed, please return the signed copy to us, '
                 +  'or <a href="' + documentUrl + '">Open Document</a> to view it online.</p>';
        } else {
            body += '<p>Once completed, please return the signed copy to us.</p>';
        }
        body += '<p>Thank you,<br/>Arizona Lionhearts</p>';
        return body;
    }

    private static String buildOwnerEmailBody(
        Contact who, String formLabel, Id contentDocId
    ) {
        String orgDomain = System.URL.getOrgDomainUrl().toExternalForm();
        String fileLink    = orgDomain + '/lightning/r/ContentDocument/'
                           + contentDocId + '/view';
        String contactLink = orgDomain + '/lightning/r/Contact/'
                           + who.Id + '/view';
        return '<p>Hello,</p>'
            + '<p><b>' + htmlEncode(who.Name) + '</b> has returned '
            + '<b>' + htmlEncode(formLabel) + '</b>. It is now pending your review.</p>'
            + '<p><a href="' + fileLink + '">Open the uploaded file</a><br/>'
            + '<a href="' + contactLink + '">Open the contact record</a></p>'
            + '<p>After reviewing, upload the final copy on the Forms tab '
            + 'of the contact record to mark this form complete.</p>';
    }

    private static String htmlEncode(String value) {
        return String.isBlank(value) ? '' : value.escapeHtml4();
    }

    /* =====================================================================
     * DIAGNOSTIC
     * ===================================================================== */
    @AuraEnabled
    public static String describeStatusFields(String objectApiName, List<String> fields) {
        Schema.SObjectType objType =
            Schema.getGlobalDescribe().get(objectApiName);
        if (objType == null) {
            return 'No such object: ' + objectApiName;
        }
        Map<String, Schema.SObjectField> fieldMap =
            objType.getDescribe().fields.getMap();
        List<String> lines = new List<String>();
        for (String field : fields) {
            Schema.SObjectField token =
                String.isBlank(field) ? null : fieldMap.get(field.toLowerCase());
            if (token == null) {
                lines.add('MISSING   ' + field);
                continue;
            }
            Schema.DescribeFieldResult dfr = token.getDescribe();
            List<String> values = new List<String>();
            for (Schema.PicklistEntry e : dfr.getPicklistValues()) {
                if (e.isActive()) {
                    values.add(e.getValue());
                }
            }
            List<String> missingStages = new List<String>();
            for (String stage : new List<String>{ 'None', 'Sent', 'Pending', 'Completed' }) {
                if (pickStatusValue(dfr, stage) == null) {
                    missingStages.add(stage);
                }
            }
            lines.add(
                (missingStages.isEmpty() ? 'OK        ' : 'INCOMPLETE ')
                + field
                + ' | type=' + dfr.getType()
                + ' | updateable=' + dfr.isUpdateable()
                + ' | values=[' + String.join(values, ', ') + ']'
                + (missingStages.isEmpty()
                        ? ''
                        : ' | NO VALUE FOR: ' + String.join(missingStages, ', '))
            );
        }
        return String.join(lines, '\n');
    }
