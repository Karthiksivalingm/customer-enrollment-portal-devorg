<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Next_90_Day_ATC_Monitoring_Meeting_Date__c</fullName>
    <formula>IF(
ISBLANK(Last_90_Day_ATC_Monitoring_Meeting_Date__c),
NULL,
Last_90_Day_ATC_Monitoring_Meeting_Date__c + 90
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Next 90 Day ATC Monitoring Meeting Date</label>
    <required>false</required>
    <type>Date</type>
</CustomField>
