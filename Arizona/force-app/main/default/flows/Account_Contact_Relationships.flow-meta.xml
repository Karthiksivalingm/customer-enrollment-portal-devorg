        <defaultConnector>
            <targetReference>Create_Account_Contact_Relation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Primary Account</defaultConnectorLabel>
        <rules>
            <name>No_Primary_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SelectedContactDetails.AccountId</leftValueReference>
                <operator>IsNull</operator>
