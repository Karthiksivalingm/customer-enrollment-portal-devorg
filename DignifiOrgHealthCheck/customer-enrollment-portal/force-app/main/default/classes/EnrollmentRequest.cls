/**
 * Shape of the JSON the public enrollment form sends to
 * EnrollmentSubmissionController.submitEnrollment. Unknown properties are ignored.
 */
public with sharing class EnrollmentRequest {
  /** UUID generated by the form; reused on retries so a submission is saved only once. */
  public String submissionKey;
  /** Milliseconds the visitor spent on the form (bot signal). */
  public Long elapsedMs;
  /** Hidden honeypot field; real visitors leave it empty. */
  public String faxNumber;
  public Company company;
  public List<EnrollmentPerson> people;

  public class Company {
    public String companyName;
    public String website;
    public String companyEmail;
    public String companyPhone;
    public String street;
    public String city;
    public String stateCode;
    public String countryCode;
    public String postalCode;
  }
}
