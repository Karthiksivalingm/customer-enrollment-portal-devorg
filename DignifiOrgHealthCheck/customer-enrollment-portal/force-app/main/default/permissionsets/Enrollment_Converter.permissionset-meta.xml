<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Internal users who view submitted enrollment people on Leads and convert enrollment Leads into one Account and multiple Contacts.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Enrollment Converter</label>
    <classAccesses>
        <apexClass>EnrollmentConversionController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EnrollmentPeopleController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EnrollmentSubmissionController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Convert_Enrollment_Leads</name>
    </customPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Enrollment_Channel__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Enrollment_People__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Enrollment_Person_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Enrollment_Submission_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Enrollment_Submitted_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Enrollment_Person_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Enrollment_Source_Lead__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
