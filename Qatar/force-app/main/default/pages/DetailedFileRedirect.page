<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" contentType="text/html">
<html>
<head>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{display:flex;justify-content:center;align-items:center;height:100vh;background:#f4f4f4;font-family:Arial,sans-serif;}
.box{text-align:center;}
.spinner{width:50px;height:50px;border:5px solid #e0e0e0;border-top:5px solid #0070d2;border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 16px;}
@keyframes spin{0%{transform:rotate(0deg);}100%{transform:rotate(360deg);}}
p{color:#444;font-size:15px;margin-top:10px;}
.back-btn{margin-top:20px;padding:8px 20px;background:#fff;color:#0070d2;border:1px solid #0070d2;border-radius:4px;font-size:13px;cursor:pointer;}
</style>
</head>
<body>
<div class="box">
    <div class="spinner"></div>
    <p>Opening Guest Profile...</p>
    <button class="back-btn" onclick="window.history.back()">&#8592; Go Back</button>
</div>
<script>
var contactId = '{!$CurrentPage.parameters.id}';
var pdfUrl = '/apex/PDFGeneratorContact?id=' + contactId;
var newTab = window.open(pdfUrl, '_blank');
if(newTab) {
    newTab.focus();
    window.history.back();
} else {
    window.location.href = pdfUrl;
}
</script>
</body>
</html>
</apex:page>