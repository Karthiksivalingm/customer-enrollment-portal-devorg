            <apex:commandButton value="Upload" action="{!uploadMeetingminutes}" onclick="setFileType('Meeting Minutes', 'fileTypeMeetingMinutes'); return true;" />
        </apex:form>
        <apex:pageBlockTable value="{!meetingMinutesContentDocumentLinks}" var="contentDocumentLink" id="meetingMinutesTable">
            <apex:column headerValue="File Name">
                <apex:outputLink value="/lightning/r/ContentDocument/{!contentDocumentLink.ContentDocumentId}/view" target="_blank">
