        <apex:pageBlockTable value="{!itineraryContentDocumentLinks}" var="contentDocumentLink" id="itinerariesTable">
            <apex:column headerValue="File Name">
                <apex:outputLink value="/lightning/r/ContentDocument/{!contentDocumentLink.ContentDocumentId}/view" target="_blank">
                    {!contentDocumentLink.ContentDocument.Title}
                </apex:outputLink>
            </apex:column>
            <apex:column headerValue="Uploaded Date">
                <apex:outputText value="{0, date, MMMM d',' yyyy hh:mm a}">
                    <apex:param value="{!contentDocumentLink.ContentDocument.LatestPublishedVersion.CreatedDate}" />
                </apex:outputText>
            </apex:column>
            <apex:column headerValue="Uploaded By">
                <apex:outputText value="{!contentDocumentLink.ContentDocument.LatestPublishedVersion.CreatedBy.Name}"/>
            </apex:column>
            
        </apex:pageBlockTable>
    </apex:pageBlock>

    <!-- Gifts Section -->
    <apex:pageBlock title="Gifts" id="gifts">
        <apex:form id="uploadFormGifts" enctype="multipart/form-data">
            <apex:inputHidden value="{!fileType}" id="fileTypeGifts"/>
            <apex:inputFile value="{!fileBody}" filename="{!fileName}" id="fileInputGifts"/>
            <apex:commandButton value="Upload" action="{!uploadGift}" onclick="setFileType('Gifts', 'fileTypeGifts'); return true;" />
        </apex:form>
        <apex:pageBlockTable value="{!giftContentDocumentLinks}" var="contentDocumentLink" id="giftsTable">
            <apex:column headerValue="File Name">
