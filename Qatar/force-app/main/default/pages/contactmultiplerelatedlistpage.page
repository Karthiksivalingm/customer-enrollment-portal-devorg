        </apex:pageBlockTable>
    </apex:pageBlock>

    <!-- JavaScript to set fileType -->
    <script>
        function setFileType(fileType, hiddenFieldId) {
            document.getElementById(hiddenFieldId).value = fileType;
        }
    </script>
</apex:page>