<apex:page standardController="Account" sidebar="False" showHeader="False" tabstyle="PromoAccountJunction__c" tabStyle="PromoAccountJunction__c">
    <br/>
  <apex:pageblock Title="{!account.name}">

<b>Subsidy:</b>{!account.Subsidy_Amount__c}<br/>
<b>Return Rate (30 Days):</b> {!account.Return_Rate_30_Days__c}<br/>
<b>Lifetime Leads Purchased:</b>{!account.Total_Leads_Purchased__c}<br/>
<b>Cap Filled Rate:</b>{!account.Cap_Filled_Rate__c}
  <br/><br/>
    <font size="2"><b>Current Lead Types</b></font><br/>

<apex:outputText rendered="{!If(account.Premium__c=true,TRUE,FALSE)}" value="Premium"/>
<apex:outputText rendered="{!If(account.Preferred__c=true,TRUE,FALSE)}" value="|Preferred"/>
 <apex:outputText rendered="{!If(account.Non_Standard__c=true,TRUE,FALSE)}" value="|Non Standard"/>
 <apex:outputText rendered="{!If(account.Standard__c=true,TRUE,FALSE)}" value="|Standard"/>


<br/><b> Exclusive Lead Types:</b><br/>
<apex:outputText rendered="{!If(account.Premium_Exclusive__c=true,TRUE,FALSE)}" value="Premium"/>
<apex:outputText rendered="{!If(account.Preferred_Exclusive__c=true,TRUE,FALSE)}" value="|Preferred"/>
 <apex:outputText rendered="{!If(account.Non_Standard_Exclusive__c=true,TRUE,FALSE)}" value="|Non Standard"/>
 <apex:outputText rendered="{!If(account.Standard_Exclusive__c=true,TRUE,FALSE)}" value="|Standard"/><br/>
  <br/>
    <font size="2"><b>Hours of Operation</b></font><br/>
    <b>Monday:</b> {!account.Hours_Monday__c}<BR/>
    <b>Tuesday:</b> {!account.Hours_Tuesday__c}<br/>
    <b>Wednesday:</b> {!account.Hours_Wednesday__c}<br/>
    <b>Thursday:</b> {!account.Hours_Thursday__c}<br/>
   <b> Friday:</b> {!account.Hours_Friday__c}<br/>
   <b>Saturday:</b> {!account.Hours_Saturday__c}<br/>
   <b>Sunday:</b> {!account.Hours_Sunday__c}<br/>
   <br/>
   
     <font size="2"><b>Current Volume Caps</b></font><br/>
     <b>Weekday:</b>{!account.weekday_cap__c}<br/>
     <b>Saturday:</b>{!account.saturday_cap__c}<br/>
     <b>Sunday:</b> {!account.Sunday_Cap__c}<br/><br/>

        <font size="2"><b>Promos</b></font><br/>
  <apex:relatedList list="promoaccountjunction__r">
<apex:facet name="header"><font size="2"><b>Promos</b></font></apex:facet>
<style type="text/css">
.actionColumn {display:none; visibility:hidden}
</style>
</apex:relatedlist>


    </apex:pageblock>
  <!-- End Default Content REMOVE THIS -->
</apex:page>