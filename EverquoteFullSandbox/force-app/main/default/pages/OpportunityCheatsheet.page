<apex:page controller="OpportunityCheatsheetController">
    <head>
        <script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js" ></script>
        <script src="//maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js" ></script>
        <link href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" />  
    </head>
    <body>
        <apex:pageMessages />
        <apex:outputPanel rendered="{!opportunity != null}">
        <div class="row">
            <div class="col-sm-12">
                <c:OpportunityDetail opportunity="{!opportunity}"
                                     contact="{!contact}"
                                     account="{!account}"
                                     save="{!save}" cancel="{!cancel}"
                                     edit="{!edit}" isEditing="{!isEditing}" />
            </div>

            <div class="col-sm-3">
                <div style="overflow: scroll">
                    <c:OpportunityColleaguesInTheState colleaguesInTheState="{!colleaguesInTheState}" />
                    <c:LeadFamiliarNames familiarNames="{!familiarNames}" distance="{!distance}" />
                    <c:LeadCurrentPromo carrier="{!carrier}" />
                </div>
            </div>

            <div class="col-sm-9">
                <div style="overflow: scroll">
                    <c:OpportunityRelatedContacts contactList="{!relatedContactList}"/>
                </div>
            </div>
            <div class="col-sm-9">
                <div style="overflow: scroll; height: 600px">
                    <c:OpportunityOpenActivities opportunity="{!opportunity}" openActivities="{!openActivities}" />
                    <c:OpportunityActivityHistories activityHistories="{!activityHistories}" />
                    <c:OpportunityNotes noteList="{!noteList}" />
                    <c:OpportunityCampaignHistories campaignHistories="{!campaignHistories}" />
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div style="overflow: scroll">
                            <c:OpportunityMarketplaceStats opportunity="{!opportunity}" marketplaceStats="{!marketplaceStats}" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                           <c:OpportunityCalculator vplclegs="{!vplclegs}" />
                    </div>
                </div>
                <div style="overflow: scroll;">
                    <c:OpportunityStageHistories stageHistories="{!opportunityStageHistories}"/>
                </div>
            </div>
      	</div>
        </apex:outputPanel>
    </body>
</apex:page>