<apex:page sidebar="false" showHeader="false"
           standardController="Opportunity"
           extensions="CrossUpsellInfoController" >
    <style>
        .infoTable {
            width: 100%;
        }
        .infoTable  th, .infoTable  td {
            border: 1px solid black;
            border-collapse: collapse;  
            text-align:center;
        }
    </style>

    <apex:tabPanel switchType="client" selectedTab="auto" id="theTabPanel"
                   tabClass="activeTab" inactiveTabClass="inactiveTab">
        <apex:tab label="Auto" name="auto" id="tabAuto">
            <apex:pageBlock >
                <apex:pageBlockSection title="Dummy" rendered="false"></apex:pageBlockSection>
                <c:CUCampaigns upsell="{!autoUpsell}" vertical="Auto"/>
                <c:CULeadType upsell="{!autoUpsell}" vertical="Auto"/>
                <c:CUGeo upsell="{!autoUpsell}" vertical="Auto" />
                <c:CUVolumeCap upsell="{!autoUpsell}" vertical="Auto" />
                <c:CUHoursOfOperation upsell="{!autoUpsell}" vertical="Auto" />
            </apex:pageBlock>
        </apex:tab>
        
        <apex:tab label="Home" name="home" id="tabHome">
            <apex:pageBlock >
                <c:CUCampaigns upsell="{!homeUpsell}" vertical="Home"/>
                <c:CULeadType upsell="{!homeUpsell}" vertical="Home" />
                <c:CUGeo upsell="{!homeUpsell}" vertical="Home" />
                <c:CUVolumeCap upsell="{!homeUpsell}" vertical="Home" />
                <c:CUHoursOfOperation upsell="{!homeUpsell}" vertical="Home" />
            </apex:pageBlock>
        </apex:tab>
        
        <apex:tab label="Life" name="life" id="tabLife">
            <apex:pageBlock >
                
                <c:CUCampaigns upsell="{!lifeUpsell}" vertical="Life"/>
                <c:CULeadType upsell="{!lifeUpsell}" vertical="Life" />
                <c:CUGeo upsell="{!lifeUpsell}" vertical="Life" />
                <c:CUVolumeCap upsell="{!lifeUpsell}" vertical="Life" />
                <c:CUHoursOfOperation upsell="{!lifeUpsell}" vertical="Life" />
               
            </apex:pageBlock>
        </apex:tab> 
    </apex:tabPanel>
</apex:page>