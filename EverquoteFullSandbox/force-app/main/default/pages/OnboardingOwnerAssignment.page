<apex:page sidebar="false" id="pg" Controller="OnboardingOwnerAssignmentCtrl" tabstyle="Onboarding_Management_Console__tab" action="{!onLoad}">

<script>
	window.onload = function() {
  		if(document.getElementById("pg:frm:pb:usr_top") != null) {
    		document.getElementById("pg:frm:pb:usr_top").style.display = "inline";
  		}
  		if(document.getElementById("pg:frm:pb:usr_mlktp") != null) {
    		document.getElementById("pg:frm:pb:usr_mlktp").style.display = "none";
  		}
  
	} 
</script>
  
<apex:form id="frm">

	<apex:pageBlock title="Management Console: Onboarding Owner Assignment" id="pb">
		<apex:commandButton value="Save Changes" action="{!save}" rerender="in,outStatus" status="outStatus" />&nbsp;&nbsp;
		<apex:commandButton value="Cancel" action="{!queryLeadRecipients}" rerender="in,outStatus" status="outStatus"/>&nbsp;&nbsp;
		<apex:commandButton value="Add CSR Recipient" action="{!add}" rerender="in,outStatus" status="outStatus"/>&nbsp;&nbsp;
		<apex:inputField value="{!csr.User__c}" id="usr"/>
		
		<br/><br/>

		<apex:outputPanel id="in" >
			<apex:pageMessages />
			<apex:actionStatus startText="Working...." id="outStatus">
				<apex:facet name="stop">
					<apex:repeat value="{!LeadRecipients}" var="type">
						<apex:pageBlockSection title="{!type}" columns="1" >
							<apex:dataTable value="{!LeadRecipients[type]}" var="lr" styleClass="list" border="0" >
								<apex:variable var="rowNum" value="{!0}"/>
								<apex:column headerValue="CSR (User)"><apex:outputField value="{!lr.User__c}"/></apex:column>
								<apex:column headerValue="Role">
									<apex:outputPanel rendered="{!lr.User_Role__c == null}">
										<apex:outputField value="{!lr.User__r.UserRole.Name}"/>
									</apex:outputPanel>
									<apex:outputPanel rendered="{!lr.User_Role__c != null}">
										<apex:outputField value="{!lr.User_Role__c}"/>
									</apex:outputPanel>
								</apex:column>
								<apex:column headerValue="Onboarding Type"><apex:inputField value="{!lr.Onboarding_Type__c}"/></apex:column>
								<apex:column headerValue="Assigned Opps"><apex:outputField value="{!lr.OpenOpps__c}"/></apex:column>
								<apex:column headerValue="Available"><apex:inputField value="{!lr.Available__c}" /></apex:column>
								<apex:column headerValue="Next Up"><apex:outputField value="{!lr.NextUp__c}" /></apex:column>
							</apex:dataTable>
						</apex:pageBlockSection>
					</apex:repeat>
				</apex:facet>
			</apex:actionStatus>
		</apex:outputPanel>

	</apex:pageBlock>
</apex:form>

</apex:page>