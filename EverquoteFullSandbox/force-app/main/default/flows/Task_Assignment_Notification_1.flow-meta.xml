    <description>Migrated from the Task Assignment Notification process using multiple criteria.
Replace default notifications when a task is assigned</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
    NOT(TEXT({!$Record.Status})  = &apos;Completed&apos;),
    ISNEW(), 
    NOT({!$Record.CreatedBy.Id} = {!$Record.Owner:User.Id} ),
    OR(
       BEGINS({!$Record.Subject}, &apos;Sage - Hot Lead Assigned&apos; ),
       BEGINS({!$Record.Subject}, &apos;Sage - Fresh Lead Assigned&apos; ) 
  )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT({!$Record.Status})  = &apos;Completed&apos;),
   ISNEW(),
   NOT({!$Record.CreatedBy.Id} = {!$Record.Owner:User.Id} )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT({!$Record.Status})  = &apos;Completed&apos;),
   NOT(ISNEW()),
   {!$Record.Owner:User.Id} &lt;&gt; PRIORVALUE({!$Record.Owner:User.Id}), 
   {!$Record.Owner:User.Id} &lt;&gt; {!$Record.LastModifiedBy.Id} 
)</expression>
    </formulas>
    <formulas>
