<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_List_of_Accounts_to_Update</name>
        <label>Add to List of Accounts to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Update_Account_Hierarchy</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Account_Hierarchy</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Triggering_Account_to</name>
        <label>Add Triggering Account to AccountsToUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Accounts_in_Hierarchy</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Save the name of the flow and component that failed</description>
        <name>Assign_Failing_Flow_Component</name>
        <label>Assign Failing Flow Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailingFlowComponent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Account_ChildAccount_UpdateRecordType,Type,SupportRep - Update List AccountsToUpdate</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the Record Type, Type, and Support Rep from the Account Hierarchy&apos;s top account to every Account in the hierarchy that may be below the triggering account.</description>
        <name>Assign_Record_Type_Type_and_Support_Rep</name>
        <label>Assign Record Type, Type and Support Rep</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Update_Account_Hierarchy.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Update_Account_Hierarchy.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Update_Account_Hierarchy.Support_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Support_Rep__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_List_of_Accounts_to_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Record_Type_Type_and_Support_Rep_to_Account_from_Top_Account</name>
        <label>Assign Record Type, Type, and Support Rep to Account from Top Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Support_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Support_Rep__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Triggering_Account_to</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Changing the value of this field bypasses the valdiation rule: Account_TopAccountOnly_ChangeTypeOrRep which would otherwise prevent the Account Record Type, Type, and Support Rep from updating a child account.</description>
        <name>Change_BypassAccountValidation</name>
        <label>Change BypassAccountValidation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.BypassAccountValidation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ChangeBypassAccountValidation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Top_Parent_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Does_triggering_account_have_children</name>
        <label>Does triggering account have children?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_List_AccountsToUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has No Children</defaultConnectorLabel>
        <rules>
            <name>Has_Children</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accounts_in_Hierarchy</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Hierarchy</targetReference>
            </connector>
            <label>Has Children</label>
        </rules>
    </decisions>
    <description>When an Account is newly created and has a parent account listed or if an Account&apos;s Parent Account changes, update the Account&apos;s Record Type, Type, and Support Rep to match the Top Parent Account in its hierarchy</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns the opposite of the current value of BypassAcountValidation</description>
        <name>ChangeBypassAccountValidation</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.BypassAccountValidation__c} = TRUE, FALSE, TRUE)</expression>
    </formulas>
    <interviewLabel>Account_ChildAccount_UpdateRecordType,Type,SupportRep {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_ChildAccount_UpdateRecordType,Type,SupportRep</label>
    <loops>
        <name>Update_Account_Hierarchy</name>
        <label>Update Account Hierarchy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Accounts_in_Hierarchy</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Record_Type_Type_and_Support_Rep</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_List_AccountsToUpdate</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all Accounts in the triggering Account&apos;s hierarchy that are not at the same level of the hierarchy as the triggering account and are not the top account</description>
        <name>Get_Accounts_in_Hierarchy</name>
        <label>Get Accounts in Hierarchy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_triggering_account_have_children</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Top_Parent_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Find the Top Account in the Account&apos;s Hierarchy</description>
        <name>Get_Top_Parent_Account</name>
        <label>Get Top Parent Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Record_Type_Type_and_Support_Rep_to_Account_from_Top_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update all of the Accounts that have been assigned new values by the flow</description>
        <name>Update_List_AccountsToUpdate</name>
        <label>Update List AccountsToUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Failing_Flow_Component</targetReference>
        </faultConnector>
        <inputReference>AccountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Change_BypassAccountValidation</targetReference>
        </connector>
        <filterFormula>/* If an Account has a parent account and it is either new or the parent account was changed*/
AND(
         NOT(ISBLANK({!$Record.ParentId})),
          OR(
                  ISNEW(),
                  ISCHANGED({!$Record.ParentId})
         )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
                <elementReference>FailingFlowComponent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>AccountsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>FailingFlowComponent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
