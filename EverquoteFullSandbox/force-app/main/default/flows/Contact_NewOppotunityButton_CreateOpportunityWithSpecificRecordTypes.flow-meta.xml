    <formulas>
        <description>The record type selected by the user</description>
        <name>FinalRecordTypeID</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Account.In_Accelerated_Lockout_Period__c} = True, 
   {!SelectOpportunityType_NotAccelerated}, 
   {!SelectOpportunityType_AllTypes}
)</expression>
    </formulas>
    <formulas>
        <name>FinalRecordTypeName</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Account.In_Accelerated_Lockout_Period__c} = True, 
   {!SelectOpportunityType_NotAccelerated}, 
   {!SelectOpportunityType_AllTypes}
)</expression>
    </formulas>
