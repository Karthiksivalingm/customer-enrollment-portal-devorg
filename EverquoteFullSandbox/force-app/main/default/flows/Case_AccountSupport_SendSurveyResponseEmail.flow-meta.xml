    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Save the name of the component where the flow failed</description>
        <name>Assign_Failing_Flow_Component</name>
        <label>Assign Failing Flow Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailingComponentName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Case_AccountSupport_SendSurveyResponse Email - Send_Typeform_Survey_Email</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <description>When an Account Support case is changed to Closed (not &quot;Left VM&quot;, not &quot;Do Not Send Automated Email&quot;, Topic is not &quot;Duplicate Case&quot;), send the Contact an email with the Typeform survey embedded. Sent from customersupport@everquote.com.
Response to this survey is stored in the Survey Response object.

S3P-785 - Created.
S3P-971 - Left VM cannot be true and Topic cannot be duplicate case. Also added fault path. 
S3P-1005 - Added to start criteria so not triggered if Contact&apos;s Email IsEmailBounced.
S3P-1146 - Added to start criteria so not triggered if &quot;Do Not Send Automated Email&quot; is checked.</description>
    <environments>Default</environments>
    <interviewLabel>Case_Account Support_SendSurveyResponseEmail {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case_AccountSupport_SendSurveyResponseEmail</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Email_Template</name>
        <label>Get Email Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Send_Typeform_Survey_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>FlowEmail_TypeformIntegration_StarterCSATSurvey</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailTemplate</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Email_Template</targetReference>
        </connector>
        <filterFormula>/* A Case with Accounts Support record type, is changed to Closed status, and has a Contact with an email address
Does not have:  Left VM checked, Duplicate Case as the Topic, or Do Not Send Automated Email checked */
AND(
         {!$Record.RecordType.DeveloperName} = &apos;Account_Support&apos;,
         ISPICKVAL( {!$Record.Status}, &apos;Closed&apos;),
         ISCHANGED({!$Record.Status}),
         NOT(ISBLANK({!$Record.ContactId})),
         NOT(ISBLANK({!$Record.Contact.Email})),
         {!$Record.Left_VM__c} = FALSE,
         NOT( ISPICKVAL({!$Record.Topic__c}, &apos;Duplicate Case&apos;)),
         ISBLANK({!$Record.Contact.EmailBouncedReason}),
         {!$Record.Do_Not_Send_Automated_Email__c} = FALSE
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
