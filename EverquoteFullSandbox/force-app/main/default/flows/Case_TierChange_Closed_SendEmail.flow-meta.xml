    <decisions>
        <description>Does the contact have an email that is not bounced?</description>
        <name>Is_Contact_Emailable</name>
        <label>Is Contact Emailable?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Non_bounced_email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.EmailBouncedReason</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_is_the_Case_Subject</targetReference>
            </connector>
            <label>Non-bounced email</label>
        </rules>
    </decisions>
    <decisions>
        <description>We will assign the correct email subject, body, and cc recipient based on the Case&apos;s Subject</description>
        <name>What_is_the_Case_Subject</name>
        <label>What is the Case Subject?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>AGP_to_Premier</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP to Accelerated-AGP Premier</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Body_Subject_AGP_to_Premier</targetReference>
            </connector>
            <label>AGP to Premier</label>
        </rules>
        <rules>
            <name>Premier_to_AGP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP Premier to Accelerated-AGP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Body_Subject_Premier_to_AGP</targetReference>
            </connector>
            <label>Premier to AGP</label>
        </rules>
        <rules>
            <name>AGP_Premier_to_Starter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>to Starter</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Body_Subject_To_Starter</targetReference>
            </connector>
            <label>AGP/Premier to Starter</label>
        </rules>
    </decisions>
    <description>When a Case of Project Account Tier Change is closed, send an email if the subject indicates a tier change that requires an email.
-AGP to Premier
-Premier to AGP
- AGP to Starter
S3P-1432 - Created.</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_ActiveAccountWithSupportRep</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    AND(
             OR(
                     ISPICKVAL({!$Record.Account.Type}, &quot;Core&quot;),
                     ISPICKVAL({!$Record.Account.Type}, &quot;Accelerated-AGP&quot;),
                     ISPICKVAL({!$Record.Account.Type}, &quot;Accelerated-AGP Premier&quot;)
              ),
             NOT(ISBLANK({!$Record.Account.Support_Rep__c})),
             {!$Record.Account.Support_Rep__r.IsActive}
     ),
TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <description>If the Account has a support rep, display their calendar link to be added at the bottom of the email body. Otherwise display nothing.</description>
        <name>Formula_EmailBody_CalendarLink</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Formula_ActiveAccountWithSupportRep},
    &quot;&lt;a href=&apos;&quot; + {!$Record.Account.Support_Rep__r.Salesforce_Meeting_Link__c} + &quot;&apos; target=&apos;_blank&apos;&gt;Book time with me&lt;/a&gt;&quot;,
    null
)</expression>
    </formulas>
    <formulas>
        <description>If the Account has an active support rep (and is currently Core, AGP, or Premier), the email signature should be the Support Rep, otherwise it should be &quot;The EverQuote Customer Support Team&quot;</description>
        <name>Formula_EmailBody_Signer</name>
        <dataType>String</dataType>
        <expression>IF({!Formula_ActiveAccountWithSupportRep}, {!$Record.Account.Support_Rep__r.FirstName} &amp; &quot; &quot; &amp;{!$Record.Account.Support_Rep__r.LastName},
&quot;The EverQuote Customer Support Team&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Returns either the Account Support Rep or blank depending on the Account Type</description>
        <name>Formula_EmailCC</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Formula_ActiveAccountWithSupportRep},
     {!$Record.Account.Support_Rep__r.Email}, /*CC account support rep if Account Type is Core or AGP */
      &quot;&quot; /* Leave CC blank because Starter accounts shouldn&apos;t CC anyone */
)</expression>
    </formulas>
