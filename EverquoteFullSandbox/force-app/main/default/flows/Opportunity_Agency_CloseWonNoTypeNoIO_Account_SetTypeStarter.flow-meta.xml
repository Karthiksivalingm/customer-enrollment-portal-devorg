<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Save the name of the flow element that failed</description>
        <name>Assign_Failing_Component_Name</name>
        <label>Assign Failing Component Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailingComponentName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Opportunity_Agency_CloseWonNoTypeNoIO_Account_SetTypeStarter - Update Account Record Type and Type</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_the_Top_Parent_Account_Open</name>
        <label>Is the Top Parent Account Open?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Agency_Account_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_is_open_AGP_Core_Starter</name>
            <conditionLogic>1 AND (2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Top_Parent_Account.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Top_Parent_Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Top_Parent_Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Top_Parent_Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Starter</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Top_Parent_Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP Premier</stringValue>
                </rightValue>
            </conditions>
            <label>Account is open AGP/Core/Starter</label>
        </rules>
    </decisions>
    <description>When an Agency Opportunity is Closed Won without Insertion Order Attached, if the Account doesn&apos;t already have a type of Starter, Core, or AGP, set it Starter with the Account Agency Record Type. 

S3P-970 - Created.
S3P-1037 - Corrected filter for Account Type so this only runs when Account is not Starter, Core, or AGP already.
S3P-1141 - Check that the Account is not OPEN Starter/Core/AGP
S3P-1207 - Checks and updates the Top Parent Account in the hierarchy instead of the Account related to the opp.
S3P-851 - Added criteria to ensure the Account isn&apos;t Accelerated-AGP Premier.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity_Agency_CloseWonNoTypeNoIO_Account_SetTypeStarter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity_Agency_CloseWonNoTypeNoIO_Account_SetTypeStarter</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Agency_Account_Record_Type</name>
        <label>Get Agency Account Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Account_Record_Type_and_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Agency</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the Account and the top of the triggering Account&apos;s hierarchy.</description>
        <name>Get_Top_Parent_Account</name>
        <label>Get Top Parent Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_the_Top_Parent_Account_Open</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>If an Agency opportunity is Closed Won without an Insertion Order and the related Account&apos;s Type isn&apos;t already set to Starter, Core, or AGP. Set it to Core.</description>
        <name>Update_Account_Record_Type_and_Type</name>
        <label>Update Account Record Type and Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Failing_Component_Name</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Top_Parent_Account.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Agency_Account_Record_Type.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Starter</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Top_Parent_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Agency</stringValue>
            </value>
        </filters>
        <filters>
            <field>Insertion_Order_Attached__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
                <elementReference>FailingComponentName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>Used to store name of flow element that failed and triggered the fault path</description>
        <name>FailingComponentName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
