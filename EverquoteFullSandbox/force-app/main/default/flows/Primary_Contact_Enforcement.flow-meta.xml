<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_to_Collection</name>
        <label>Add Contact to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Contacts_To_Update_Record</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_primary_contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_primary_contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the flow and component name to be passed to the fault path subflow</description>
        <name>Assign_Failed_Component</name>
        <label>Assign Failed Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailingComponent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Primary_Contact_Enforcement - Remove Other Primary Contacts</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Unset_Primary_Checkbox</name>
        <label>Unset Primary Checkbox</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_through_primary_contacts.Primary_Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Contact_to_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if Contacts were found in the previous get records, if not, do nothing.</description>
        <name>Does_the_Account_have_Other_Primary_Contacts</name>
        <label>Does the Account have Other Primary Contacts?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Triggering Contacts is only Primary Contact</defaultConnectorLabel>
        <rules>
            <name>Other_Primary_Contacts_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Primary_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_primary_contacts</targetReference>
            </connector>
            <label>Other Primary Contacts Found</label>
        </rules>
    </decisions>
    <description>Added fault path and modified criteria so it is only run when Contact is newly set to Primary Contact.</description>
    <environments>Default</environments>
    <interviewLabel>Primary Contact Enforcement {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Primary Contact Enforcement</label>
    <loops>
        <name>Loop_through_primary_contacts</name>
        <label>Loop through primary contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Existing_Primary_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Unset_Primary_Checkbox</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Primary_Contacts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Find all Contacts related to the triggering Contact&apos;s Account that are also marked as &quot;Primary Contact&quot;.</description>
        <name>Get_Existing_Primary_Contacts</name>
        <label>Get Existing Primary Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_the_Account_have_Other_Primary_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Uncheck &quot;Primary Contact&quot; from all Contacts other than the Contact that triggered this flow.</description>
        <name>Update_Primary_Contacts</name>
        <label>Remove Other Primary Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Failed_Component</targetReference>
        </faultConnector>
        <inputReference>Contacts_To_Update_Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Primary_Contacts</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Sends email about error to Admin</description>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
                <elementReference>FailingComponent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>Contacts_To_Update_Record</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>FailingComponent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
