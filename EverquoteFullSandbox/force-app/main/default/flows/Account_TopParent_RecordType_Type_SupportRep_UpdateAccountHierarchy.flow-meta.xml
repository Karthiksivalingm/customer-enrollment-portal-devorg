<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Add Account to collection that will be updated later</description>
        <name>Add_Account_to_Collection</name>
        <label>Add Account to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Accounts_in_Hierarchy</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Accounts_in_Hierarchy</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign Top Parent Account&apos;s Record Type, Type and Support Rep to every Account in the hierarchy</description>
        <name>Assign_Record_Type_Type_and_Support_Rep</name>
        <label>Assign Record Type, Type, and Support Rep</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.Support_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Support_Rep__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.BypassAccountValidation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopChangeBypassAccountValidation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Account_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Changing the value of this field bypasses the valdiation rule: Account_TopAccountOnly_ChangeTypeOrRep which would otherwise prevent the Account Record Type, Type, and Support Rep from updating a child account.</description>
        <name>Change_BypassAccountValidations</name>
        <label>Change BypassAccountValidations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.BypassAccountValidation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ChangeBypassAccountValidation</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Accounts</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Are_there_Accounts_in_the_Hierarchy</name>
        <label>Are there Accounts in the Hierarchy?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Solo Account</defaultConnectorLabel>
        <rules>
            <name>Accounts_in_Hierarchy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accounts_in_Hierarchy</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Accounts_in_Hierarchy</targetReference>
            </connector>
            <label>Accounts in Hierarchy</label>
        </rules>
    </decisions>
    <description>When a Top Parent Account Record Type, Type, or Support Rep is changed, update all of the Accounts in the hierarchy to match.</description>
    <environments>Default</environments>
    <formulas>
        <description>Return the opposite of BypassAccountValidation&apos;s current value</description>
        <name>ChangeBypassAccountValidation</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.BypassAccountValidation__c} = TRUE, FALSE, TRUE)</expression>
    </formulas>
    <formulas>
        <description>Returns the opposite value of BypassAccountValidation for the current Account in the loop</description>
        <name>LoopChangeBypassAccountValidation</name>
        <dataType>Boolean</dataType>
        <expression>IF( {!Loop_Accounts_in_Hierarchy.BypassAccountValidation__c} =TRUE, FALSE, TRUE)</expression>
    </formulas>
    <interviewLabel>Account_TopParent_RecordType,Type,SupportRep_UpdateAccountHierarchy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_TopParent_RecordType,Type,SupportRep_UpdateAccountHierarchy</label>
    <loops>
        <name>Loop_Accounts_in_Hierarchy</name>
        <label>Loop Accounts in Hierarchy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Accounts_in_Hierarchy</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Record_Type_Type_and_Support_Rep</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Change_BypassAccountValidations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Accounts_in_Hierarchy</name>
        <label>Get Accounts in Hierarchy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_there_Accounts_in_the_Hierarchy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Top_Parent_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
        <queriedFields>BypassAccountValidation__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Accounts</name>
        <label>Update Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>AccountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Accounts_in_Hierarchy</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Support_Rep__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>AccountsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
