    <description>Routes each call to the default queue (Inbound Support) and, if the agent accepts, screen pops the new case for this call and identifies the caller.
S3P-859: Get Account Support case record type, assign that case record type to the case being created for Customer Support calls. Make sure Contact is accurately getting assigned.
Fixed issue with recordtypeid</description>
    <environments>Default</environments>
    <formulas>
        <name>areaCode</name>
        <dataType>String</dataType>
        <expression>MID({!IncomingCallPhoneNumber}, 3,3)</expression>
    </formulas>
    <formulas>
        <description>create the subject for the case</description>
        <name>caseSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Inbound call from: &quot; &amp; {!IncomingCallPhoneNumber}</expression>
    </formulas>
    <formulas>
        <name>convertPhoneNumber</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!IncomingCallPhoneNumber}, &apos;+1&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>lastFour</name>
        <dataType>String</dataType>
        <expression>RIGHT({!IncomingCallPhoneNumber}, 4)</expression>
    </formulas>
    <formulas>
        <name>phoneWithParenthesis</name>
        <dataType>String</dataType>
        <expression>&quot;(&quot; &amp; MID({!IncomingCallPhoneNumber}, 3, 3) &amp; &quot;) &quot; &amp; MID({!IncomingCallPhoneNumber}, 6, 3) &amp; &quot;-&quot; &amp; RIGHT({!IncomingCallPhoneNumber}, 4)</expression>
    </formulas>
