<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set the &quot;Accelerated Lockout Period End Date&quot; to 90 days after the Pro Account Cancelled Date.</description>
        <name>Assign_Accelerated_Lockout_Period_End_Date</name>
        <label>Assign Accelerated Lockout Period End Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Accelerated_Lockout_Period_End_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ProAccountCancelledDateplus90</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>When an Account with the Type AGP or AGP-Premier is updated with a Pro Account Cancelled Date, set the Account&apos;s Accelerated Lockout Period End Date to 90 days after the Pro Account Cancelled Date.

S3P-1158 - Created.</description>
    <environments>Default</environments>
    <formulas>
        <description>90 days after the Pro Account Cancelled Date</description>
        <name>ProAccountCancelledDateplus90</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Pro_Account_Cancelled_Date__c} + 90</expression>
    </formulas>
    <interviewLabel>Account_ProAccountCancelledDateWithTypeAGP_UpdateAcceleratedLockoutPeriodEndDate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_ProAccountCancelledDateWithTypeAGP_UpdateAcceleratedLockoutPeriodEndDate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Accelerated_Lockout_Period_End_Date</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Pro_Account_Cancelled_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accelerated-AGP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accelerated-AGP Premier</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
