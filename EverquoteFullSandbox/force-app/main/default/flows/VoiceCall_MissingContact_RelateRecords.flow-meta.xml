    <description>When a VoiceCall is created or updated and is missing a related Contact record, try to find and relate contact, Account, or Leads. Make sure the Related Record Id is populated.
S3P-1267 - Created.</description>
    <environments>Default</environments>
    <formulas>
        <name>areacode</name>
        <dataType>String</dataType>
        <expression>MID({!$Record.FromPhoneNumber},3,3)</expression>
    </formulas>
    <formulas>
        <name>areaCodeToNumber</name>
        <dataType>String</dataType>
        <expression>MID({!$Record.ToPhoneNumber},3,3)</expression>
    </formulas>
    <formulas>
        <description>For inbound calls, return the Caller Contact Info
For outbounds, return the Recipient Contact Info</description>
        <name>CallerRecipientbyCallType</name>
        <dataType>String</dataType>
        <expression>IF( ISPICKVAL({!$Record.CallType}, &quot;Outbound&quot;), {!$Record.ToPhoneNumber},
{!$Record.FromPhoneNumber})</expression>
    </formulas>
    <formulas>
        <name>lastfour</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.FromPhoneNumber},4)</expression>
    </formulas>
    <formulas>
        <name>lastFourToNumber</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.ToPhoneNumber},4)</expression>
    </formulas>
    <formulas>
        <name>phonenumber</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.FromPhoneNumber},7)</expression>
    </formulas>
    <interviewLabel>VoiceCall_MissingContact_RelateRecords {!$Flow.CurrentDateTime}</interviewLabel>
    <label>VoiceCall_MissingContact_RelateRecords</label>
