            <value>
                <elementReference>CallerRecipientbyCallType</elementReference>
            </value>
        </filters>
        <filters>
            <field>Normalized_AltPhone__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CallerRecipientbyCallType</elementReference>
            </value>
        </filters>
        <filters>
            <field>Normalized_AccountPhone__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CallerRecipientbyCallType</elementReference>
            </value>
        </filters>
        <filters>
            <field>Normalized_Alt_Phone_2__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CallerRecipientbyCallType</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastName</field>
            <operator>StartsWith</operator>
