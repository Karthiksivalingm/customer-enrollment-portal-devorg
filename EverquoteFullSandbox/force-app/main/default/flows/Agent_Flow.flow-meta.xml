        <fields>
            <name>PreQualClass</name>
            <fieldText>&lt;p&gt;&lt;b style=&quot;font-size: 16px; font-family: sans-serif; color: black;&quot;&gt;PreQual (Classification)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;[Start by asking] &lt;/b&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Are you taking any medications?&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;[if Yes] &lt;/b&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Ok, what is that for?&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Standard If…&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;[Ever…]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Parkinson’s&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Permanent paralysis or amputation caused by disease?&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;[In Last 2 years…]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Aneurysm, heart attack, any circulatory disorder, stroke or TIA&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Chronic kidney disease&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Internal cancer, melanoma or leukemia&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Cerebral palsy, multiple sclerosis, muscular dystrophy&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;More than 4 moving violations&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;DUI &amp;gt;1 time, alcohol/drug treatment&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Felony or been on probation/parole&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Tobacco if…&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Used within the past 12 months&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Modified If…&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;[Ever…]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Bone marrow, stem cell or organ transplant&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Kidney disease/dialysis&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Alzheimer’s, dementia&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Lou Gehrig’s disease (ALS)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;HIV, AIDS&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: black; font-family: sans-serif; font-size: 14px;&quot;&gt;[In Last 12 months…]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Heart attack, heart blockage, stroke or TIA&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Lung disease&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Cancer&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif;&quot;&gt;•&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: black;&quot;&gt;Chronic pancreatitis, chronic hepatitis or cirrhosis?&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
