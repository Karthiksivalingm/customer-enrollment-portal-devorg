<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Save_CHS_Prior_Value_to_Previous_CHS_Color_field</name>
        <label>Save CHS Prior Value to Previous CHS Color field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Previous_CHS_Color__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.CHS_Color__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>When an Account&apos;s CHS Color changes, save the value it was changed from to the Previous CHS Color field.
While this flow may seem unnecessary because we have field tracking for CHS Color - please see justification in orginial jira before changing.

S3P-1392 - Created.</description>
    <environments>Default</environments>
    <interviewLabel>Account_CHSColorChange_SavePreviousCHSColor {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_CHSColorChange_SavePreviousCHSColor</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Save_CHS_Prior_Value_to_Previous_CHS_Color_field</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CHS_Color__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
