            <conditions>
                <leftValueReference>Get_Open_Customer_Health_Score_Alert_Tasks</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>How_was_CHS_Color_Changed</targetReference>
            </connector>
            <label>No Open Customer Health Alert Tasks</label>
        </rules>
    </decisions>
    <description>When a Core Account&apos;s CHS Color changes to Red, create a task for the Support Rep to follow-up. If a Core Account&apos;s CHS Color changes from Red to anything else find and incomplete CHS tasks for the Account and auto-close them.

S3P-1391 - Created.</description>
    <environments>Default</environments>
    <formulas>
        <description>Two business days after the flow runs.</description>
        <name>Formula_DueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() +
CASE(
  MOD( TODAY() - DATE(1900,1,7), 7 ),
  0, 2, 1, 2, 2, 2, 3, 2, 4, 4, 5, 4, 6, 3, 0
)</expression>
    </formulas>
    <formulas>
        <description>Appends note about autoclose to the original description</description>
        <name>Formula_TaskDescription_AutoClose</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!Loop_through_related_tasks.Description}),
  &quot;&quot;,
  {!Loop_through_related_tasks.Description}) 
&amp; BR() &amp; BR()&amp; 
&quot;Auto-completed on &quot; &amp; TEXT(TODAY())
&amp; &quot;: the Account&apos;s Customer Health Score moved from Red to &quot;
&amp; TEXT({!$Record.CHS_Color__c}) &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>Formula_TaskSubject_NewTask</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} + &quot;: CHS Color changed from &quot; + 
IF(
    ISBLANK({!$Record.Previous_CHS_Color__c}), 
    &quot;Blank&quot;, 
    {!$Record.Previous_CHS_Color__c}
) + 
&quot; to Red.&quot;</expression>
    </formulas>
    <formulas>
        <name>Formula_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
