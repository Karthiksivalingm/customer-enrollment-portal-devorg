    <decisions>
        <description>Did the flow start because the CHS-Color was changed from Red or to Red?</description>
        <name>How_was_CHS_Color_Changed</name>
        <label>How was CHS-Color Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Changed_to_Red</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CHS_Color__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Red</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Previous_CHS_Color__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Red</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>No_Open_Customer_Health_Alert_Tasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_s_Primary_Contact</targetReference>
            </connector>
            <label>Changed to Red</label>
        </rules>
        <rules>
            <name>Changed_from_Red</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CHS_Color__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Red</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Previous_CHS_Color__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Red</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>No_Open_Customer_Health_Alert_Tasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_related_tasks</targetReference>
            </connector>
            <label>Changed from Red</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_already_an_open_Customer_Health_Alert_Task</name>
        <label>Is there already an open Customer Health Alert Task?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>How_was_CHS_Color_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Open_Customer_Health_Alert_Tasks</name>
