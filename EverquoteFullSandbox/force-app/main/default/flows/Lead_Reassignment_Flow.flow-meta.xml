    <decisions>
        <description>does an open initial meeting exist on the lead?</description>
        <name>Does_Initial_meeting_exist</name>
        <label>Does Initial meeting exist</label>
        <locationX>646</locationX>
        <locationY>333</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>InitialMeetingID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>InitialMeetingID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_owner_to_queue</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_is_Sales_Rep_decision</name>
        <label>Owner is Sales Rep</label>
        <locationX>21</locationX>
        <locationY>43</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Owner_is_sales_rep</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RoleName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Sales Rep</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Referral_or_Inbound</targetReference>
            </connector>
            <label>Owner is sales rep</label>
        </rules>
    </decisions>
    <decisions>
        <name>Referral_or_Inbound</name>
        <label>Referral or Inbound?</label>
        <locationX>253</locationX>
        <locationY>40</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Referral</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Referral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>referral_Queue</targetReference>
            </connector>
            <label>Referral</label>
        </rules>
        <rules>
            <name>Inbound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LeadSource</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>referral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Inbound_queue</targetReference>
            </connector>
            <label>Inbound</label>
        </rules>
    </decisions>
