    <decisions>
        <name>Check_Next_Due_Date</name>
        <label>Check Next Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.next_due_date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Today</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Upsell_Recordtype.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>mainUpdate</targetReference>
            </connector>
            <label>check</label>
        </rules>
    </decisions>
    <description>Migrated from the: Update stage to Pending workflow rule
Workflow rule description: update the stage of an upsell opportunity to pending when the next due date is greater than today&quot;</description>
