<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>First_Name_Required</fullName>
    <active>true</active>
    <description>First name is required if the lead was not created by an admin</description>
    <errorConditionFormula>AND(ISBLANK(FirstName )=TRUE,
AND( $User.ProfileId  &lt;&gt; &quot;00e1a000000lWln&quot;,
  $User.ProfileId &lt;&gt;&quot;00e1a000000duS7&quot;),
AND( CreatedBy.ProfileId   &lt;&gt; &quot;00e1a000000lWln&quot;,
 CreatedBy.ProfileId  &lt;&gt;&quot;00e1a000000duS7&quot;))</errorConditionFormula>
    <errorMessage>First Name Required.</errorMessage>
</ValidationRule>
