<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Waitlist_status_require_zip_code</fullName>
    <active>true</active>
    <errorConditionFormula>AND(

 ISBLANK(PostalCode),

 ISPICKVAL(Status, &quot;Waitlist&quot;) 

)</errorConditionFormula>
    <errorMessage>If status is &quot;Waitlist&quot; zip code must be filled out</errorMessage>
</ValidationRule>
