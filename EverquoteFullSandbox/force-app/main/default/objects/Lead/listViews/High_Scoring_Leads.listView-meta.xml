<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>High_Scoring_Leads</fullName>
    <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 and 6</booleanFilter>
    <columns>Carrier__c</columns>
    <columns>FULL_NAME</columns>
    <columns>LEAD.COMPANY</columns>
    <columns>LEAD.PHONE</columns>
    <columns>LEAD.LAST_ACTIVITY</columns>
    <columns>HubSpot_Score__c</columns>
    <columns>LEAD_SCORE</columns>
    <columns>Number_of_Page_Views__c</columns>
    <columns>Marketing_Email_Clicks__c</columns>
    <columns>Time_of_Last_Session__c</columns>
    <columns>LEAD.STATUS</columns>
    <filterScope>Everything</filterScope>
    <filters>
        <field>HubSpot_Score__c</field>
        <operation>greaterOrEqual</operation>
        <value>25</value>
    </filters>
    <filters>
        <field>LEAD.LAST_ACTIVITY</field>
        <operation>lessThan</operation>
        <value>THIS_MONTH</value>
    </filters>
    <filters>
        <field>Time_of_Last_Session__c</field>
        <operation>greaterOrEqual</operation>
        <value>1/1/2022 11:30 AM</value>
    </filters>
    <filters>
        <field>LEAD.EMAIL</field>
        <operation>notContain</operation>
        <value>allstate,farmersagen,Statefarm</value>
    </filters>
    <filters>
        <field>CarrierName__c</field>
        <operation>notContain</operation>
        <value>Allstate,Farmers,State Farm</value>
    </filters>
    <filters>
        <field>LEAD.STATUS</field>
        <operation>notEqual</operation>
        <value>Lost,Unqualified,Duplicate,Do Not Call,No Longer There,Bad Data,Not Interested</value>
    </filters>
    <label>Independent High Scoring Leads</label>
    <sharedTo>
        <group>IA_and_Growth_Team</group>
    </sharedTo>
</ListView>
