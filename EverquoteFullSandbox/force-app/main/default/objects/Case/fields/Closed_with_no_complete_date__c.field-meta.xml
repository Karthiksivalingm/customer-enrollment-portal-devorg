<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_with_no_complete_date__c</fullName>
    <description>To filter these records out when reviewing Core Business Review reports</description>
    <formula>ISPICKVAL( Status , &quot;Closed&quot;) &amp;&amp;  ISBLANK( Completed_Date__c )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Closed with no complete date</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
