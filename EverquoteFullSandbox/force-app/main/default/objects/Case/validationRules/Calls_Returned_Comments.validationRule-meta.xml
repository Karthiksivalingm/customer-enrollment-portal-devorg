<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calls_Returned_Comments</fullName>
    <active>true</active>
    <description>Calls returned value is &quot;Other&quot;, enter comments here</description>
    <errorConditionFormula>AND ( 
     ISPICKVAL(  Calls_Returned_Reason__c  , &quot;Other&quot;), 
     ISBLANK( Calls_Returned_Comments__c ))</errorConditionFormula>
    <errorDisplayField>Calls_Returned_Reason__c</errorDisplayField>
    <errorMessage>Enter comments here if Calls Returned Reason is &quot;Other&quot;</errorMessage>
</ValidationRule>
