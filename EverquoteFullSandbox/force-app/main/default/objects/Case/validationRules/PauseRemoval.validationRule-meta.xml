<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PauseRemoval</fullName>
    <active>true</active>
    <description>make case results mandatory</description>
    <errorConditionFormula>ISBLANK(TEXT(Case_Results__c ))&amp;&amp; 
ISPICKVAL(Project__c, &quot;IO/Pause Removal&quot;) &amp;&amp;
ISPICKVAL( Status , &quot;Closed&quot;)</errorConditionFormula>
    <errorMessage>If the case is associated with project &quot;IO/Pause Removal&quot; please enter case results</errorMessage>
</ValidationRule>
