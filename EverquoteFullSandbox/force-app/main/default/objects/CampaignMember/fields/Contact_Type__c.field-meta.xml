<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Type__c</fullName>
    <externalId>false</externalId>
    <formula>IF(NOT(ISbLANK(Lead_Status__c )),&quot;Prospect&quot;,
