<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Active_on_Pro__c</fullName>
    <externalId>false</externalId>
    <formula>IF( ISNULL(Account.Pro_Account_Cancelled_Date__c), NOW()  -  DATETIMEVALUE( Account.First_Payment_Date__c ), (DATETIMEVALUE(Account.First_Payment_Date__c)) - (DATETIMEVALUE(Account.Pro_Account_Cancelled_Date__c)))</formula>
    <inlineHelpText>How many days this agent has been active on pro since the most recent First Payment Date.</inlineHelpText>
    <label>Days Active on Pro</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
