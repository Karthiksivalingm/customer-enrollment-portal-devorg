<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Closed_Won_Without_Products</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Closed Won&quot;),
    Product_Count__c = 0
)</errorConditionFormula>
    <errorMessage>Add products to this opportunity to be able to close win it.</errorMessage>
</ValidationRule>
