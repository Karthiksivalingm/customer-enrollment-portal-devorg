<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date_must_be_Weekday</fullName>
    <active>true</active>
    <errorConditionFormula>CASE(MOD(  End_Date__c  - DATE(1900, 1, 7), 7),
0, 0,
6, 0,
1) = 0</errorConditionFormula>
    <errorMessage>End Date must be weekday.</errorMessage>
</ValidationRule>
