<apex:component >
    <apex:attribute name="contactList" type="Contact[]" required="true"
                    description="Related Contact List"/>
    
    <apex:pageBlock title="Related Contacts">
        <apex:outputText rendered="{!contactList.size = 0}">
            No records to display
        </apex:outputText>
        <apex:pageblocktable rendered="{!contactList.size > 0}"
                             value="{!contactList}" var="a">
            <apex:column value="{!a.Name}"/>
            <apex:column value="{!a.Email}"/>
            <apex:column value="{!a.Phone}"/>
        </apex:pageblocktable>
    </apex:pageBlock>
</apex:component>