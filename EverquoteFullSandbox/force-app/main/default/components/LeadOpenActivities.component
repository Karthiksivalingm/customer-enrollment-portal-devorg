<apex:component >
    <apex:attribute name="lead" type="Lead" required="true"
                    description="The Lead"/>
    <apex:attribute name="openActivities" type="Lead" required="true"
                    description="Open Activities"/>
    
    <apex:pageBlock title="Open Activities">    
        <apex:pageBlockButtons location="top">
            <apex:outputLink value="/00T/e?who_id={!lead.Id}"
                             styleClass="btn" style="text-decoration:none;padding:4px;">
                New Task
            </apex:outputLink>
            <apex:outputLink value="/00U/e?who_id={!lead.Id}"
                             styleClass="btn" style="text-decoration:none;padding:4px;">
                New Event
            </apex:outputLink>
            <apex:outputLink value="/002/e?parent_id={!LEFT(lead.Id, 15)}"
                             styleClass="btn" style="text-decoration:none;padding:4px;">
                New Note
            </apex:outputLink>
        </apex:pageBlockButtons>
        
        <apex:outputText rendered="{!openActivities.OpenActivities.size = 0}">
            No records to display
        </apex:outputText>
        <apex:pageblocktable rendered="{!openActivities.OpenActivities.size > 0}" 
                             value="{!openActivities.OpenActivities}" var="a">
            <apex:column value="{!a.ActivityDate}"/>
            <apex:column headerValue="Subject">
                <apex:outputLink value="/{!a.Id}">
                    {!a.Subject}
                </apex:outputLink>
            </apex:column>
            <apex:column value="{!a.OwnerId}"/>
            <apex:column value="{!a.Description}"/>
        </apex:pageblocktable>
    </apex:pageBlock>
</apex:component>