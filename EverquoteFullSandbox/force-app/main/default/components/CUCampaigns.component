<apex:component >
    <apex:attribute name="upsell" type="Upsell__c" required="true"
                    description="upsell"/>
    <apex:attribute name="vertical" type="String" required="true"
                    description="vertical"/>
    
    <apex:pageBlockSection title="Campaign Info" collapsible="true">
        <table class="infoTable">
            <tr>
                <th># of Campaigns</th>
                <td>{!upsell.Number_of_Campaigns__c}</td>     
            </tr>
            <tr>
                <th>Paused At</th>
                <td>{!upsell.Paused_At__c}</td>
            </tr> 
            <tr>
                <th>Resume At</th>
                <td>{!upsell.Resume_At__c}</td>
            </tr>  
        </table>
    </apex:pageBlockSection>
</apex:component>