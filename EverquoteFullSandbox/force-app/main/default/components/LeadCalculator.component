<apex:component >   
    <apex:attribute name="vplclegs" type="String" required="true"
                    description="vpl-clegs"/>
    <script src="//ajax.googleapis.com/ajax/libs/angularjs/1.4.8/angular.min.js" ></script>
    <script>
        var app = angular.module('myApp', []);
        app.controller('myCtrl', function($scope) {
            $scope.avg_days = 19;
            $scope.avg_cost = "{!vplclegs}";
            
            $scope.daily_lead_1 = 5;
            $scope.close_rate_1 = "6";
            $scope.monthly_policy_2 = 10;
            $scope.close_rate_2 = "6";
        });
    </script>
    
    <apex:pageBlock title="Form Calculator">
        <div ng-app="myApp" ng-controller="myCtrl">
            <table class="table">
                <tr>
                    <th class="col-sm-6"></th>
                    <th class="col-sm-3">Stats</th>
                    <th class="col-sm-3">Stats</th>
                </tr>
                <tr>
                    <td>Average Leads / Day</td>
                    <td><input type="number" ng-model="daily_lead_1" /></td>
                    <td style="background-color:#00FF00;">{{monthly_policy_2 * 100 / close_rate_2 / avg_days | number:2}}</td>
                </tr>
                <tr>
                    <td>Average Business Days</td>
                    <td>{{avg_days}}</td>
                    <td>{{avg_days}}</td>
                </tr>
                <tr>
                    <td>Leads / Month</td>
                    <td>{{daily_lead_1 * avg_days | number:2}}</td>
                    <td>{{monthly_policy_2 * 100 / close_rate_2 | number:2}}</td>
                </tr>
                <tr>
                    <td>Leads to Close Rate</td>
                    <td>
                        <select class="form-control" ng-model="close_rate_1">
                        	<option value="6">6%</option>
                            <option value="8">8%</option>
                            <option value="10">10%</option>
                            <option value="12">12%</option>
                            <option value="14">14%</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-control" ng-model="close_rate_2">
                        	<option value="6">6%</option>
                            <option value="8">8%</option>
                            <option value="10">10%</option>
                            <option value="12">12%</option>
                            <option value="14">14%</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td>Monthly Policies</td>
                    <td style="background-color:#00FF00;">{{daily_lead_1 * avg_days * close_rate_1 / 100 | number:2}}</td>
                    <td><input type="number" ng-model="monthly_policy_2" /></td>
                </tr>
                <tr>
                    <td>Average Cost / Lead</td>
                    <td>$ {{avg_cost}}</td>
                    <td>$ {{avg_cost}}</td>
                </tr>
                <tr>
                    <td>Cost Per Policy</td>
                    <td>$ {{avg_cost * 100 / close_rate_1 | number:2}}</td>
                    <td>$ {{avg_cost * 100 / close_rate_2 | number:2}}</td>
                </tr>
                <tr>
                    <td>Monthly Investment</td>
                    <td>$ {{avg_cost * daily_lead_1 * avg_days | number:2}}</td>
                    <td>$ {{avg_cost * monthly_policy_2 * 100 / close_rate_2 | number:2}}</td>
                </tr>
            </table>
        </div>
    </apex:pageBlock>
</apex:component>