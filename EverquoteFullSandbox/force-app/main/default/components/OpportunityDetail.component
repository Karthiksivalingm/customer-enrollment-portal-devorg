<apex:component >    
    <apex:attribute name="opportunity" type="Opportunity" required="true"
                    description="The Opportunity"/>
    <apex:attribute name="contact" type="Contact" required="true"
                    description="The Contact"/>
    <apex:attribute name="account" type="Account" required="true"
                    description="The Account"/>
    <apex:attribute name="save" type="ApexPages.Action" required="true"
                    description="Save Method"/>
    <apex:attribute name="isEditing" type="boolean" required="true"
                    description="Currently editing"/>
    <apex:attribute name="edit" type="ApexPages.Action" required="true"
                    description="Edit Method"/>
    <apex:attribute name="cancel" type="ApexPages.Action" required="true"
                    description="Cancel Method"/>
    
    <style type="text/css">
        #detailTable th {
        width: 10%;
        text-align: right;
        vertical-align: top;
        padding-right: 10px;
        }
        #detailTable td {
        width: 10%;
        text-align: left;
        vertical-align: top;
        padding-left: 10px;
        }
    </style>
    <apex:includeScript value="/support/console/24.0/integration.js"/>
    <apex:form >
        <apex:pageBlock title="Opportunity Detail" mode="inlineEdit">
            <apex:pageBlockButtons location="top">
                <apex:commandButton action="{!edit}" id="editButton" value="Edit"
                                    rendered="{!!isEditing}" immediate="true"/>
                <apex:commandButton action="{!save}" id="saveButton" value="Save"
                                    style="{!IF(!isEditing, 'display: none;', '')}" />
                <apex:commandButton id="cancelInlineButton" value="Cancel" onclick="resetInlineEdit()" 
                                    style="display: none;" immediate="true"/>
                <apex:commandButton action="{!cancel}" id="cancelButton" value="Cancel"
                                    rendered="{!isEditing}" immediate="true"/>
            </apex:pageBlockButtons>
            
            <apex:outputPanel rendered="{!isEditing}">
                <table id="detailTable" width="100%">
                    <tr>
                        <th><apex:outputLabel value="Opportunity Owner"/></th>
                        <td><apex:inputField value="{!opportunity.OwnerId}" /></td>
                        <th><apex:outputLabel value="Street"/></th>
                        <td><apex:inputField value="{!account.BillingStreet}" /></td>
                        <th><apex:outputLabel value="Phone"/></th>
                        <td><apex:inputField value="{!contact.Phone}" /></td>
                        <th><apex:outputLabel value="Stage"/></th>
                        <td><apex:inputField value="{!opportunity.StageName}" /></td>
                        <th><apex:outputLabel value="Type"/></th>
                        <td><apex:inputField value="{!opportunity.Type}" /></td>
                    </tr>
                    <tr>
                        <th><apex:outputLabel value="Contact Name"/></th>
                        <td><apex:outputLink value="/{!contact.Id}">{!contact.Name}</apex:outputLink></td>
                        <th><apex:outputLabel value="City"/></th>
                        <td><apex:inputField value="{!account.BillingCity}" /></td>
                        <th><apex:outputLabel value="Mobile"/></th>
                        <td><apex:inputField value="{!contact.MobilePhone}" /></td>
                        <th><apex:outputLabel value="Lost Reason"/></th>
                        <td><apex:inputField value="{!opportunity.Lost_Reason__c}" /></td>
                        <th><apex:outputLabel value="Next Step"/></th>
                        <td><apex:inputField value="{!Opportunity.NextStep}" /></td>
                    </tr>
                    <tr>
                        <th><apex:outputLabel value="Carrier"/></th>
                        <td><apex:inputField value="{!account.Carrier__c}" /></td>
                        <th><apex:outputLabel value="State"/></th>
                        <td><apex:inputField value="{!account.BillingState}" /></td>
                        <th><apex:outputLabel value="Alt Phone 2"/></th>
                        <td><apex:inputField value="{!contact.Alt_Phone_2__c}" /></td>
                        <th><apex:outputLabel value="Close Date"/></th>
                        <td><apex:inputField value="{!opportunity.CloseDate}" /></td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th></th>
                        <td></td>                        
                        <th><apex:outputLabel value="Postal Code"/></th>
                        <td><apex:inputField value="{!account.BillingPostalCode}" /></td>
                        <th><apex:outputLabel value="Email"/></th>
                        <td><apex:inputField value="{!contact.Email}" /></td>
                        <th><apex:outputLabel value="Pipeline Category"/></th>
                        <td><apex:inputField value="{!opportunity.ForecastCategoryName}" /></td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!!isEditing}">
                <table id="detailTable" width="100%">
                    <tr>
                        <th><apex:outputLabel value="Opportunity Owner"/></th>
                        <td><apex:outputField value="{!opportunity.OwnerId}" /></td>
                        <th><apex:outputLabel value="Street"/></th>
                        <td><apex:outputField value="{!account.BillingStreet}" >
                            <apex:inlineEditSupport showOnEdit="saveButton, cancelInlineButton"
                                                    hideOnEdit="editButton, cancelButton"
                                                    event="ondblclick"
                                                    resetFunction="resetInlineEdit"/>
                            </apex:outputField></td>
                        <th><apex:outputLabel value="Phone"/></th>
                        <td><apex:outputText >
                            <support:clickToDial number="{!contact.Phone}" entityId="{!opportunity.Id}" />
                            </apex:outputText></td>
                        <th><apex:outputLabel value="Stage"/></th>
                        <td><apex:outputField value="{!opportunity.StageName}" /></td>
                        <th><apex:outputLabel value="Type"/></th>
                        <td><apex:outputField value="{!opportunity.Type}" /></td>
                    </tr>
                    <tr>
                        <th><apex:outputLabel value="Contact Name"/></th>
                        <td><apex:outputLink value="/{!contact.Id}">{!contact.Name}</apex:outputLink></td>
                        <th><apex:outputLabel value="City"/></th>
                        <td><apex:outputField value="{!account.BillingCity}" /></td>
                        <th><apex:outputLabel value="Mobile"/></th>
                        <td><apex:outputText >
                            <support:clickToDial number="{!contact.MobilePhone}" entityId="{!opportunity.Id}" />
                            </apex:outputText></td>
                        <th><apex:outputLabel value="Lost Reason"/></th>
                        <td><apex:outputField value="{!opportunity.Lost_Reason__c}" /></td>
                        <th><apex:outputLabel value="Next Step"/></th>
                        <td><apex:outputField value="{!Opportunity.NextStep}" /></td>
                    </tr>
                    <tr>
                        <th><apex:outputLabel value="Carrier"/></th>
                        <td><apex:outputField value="{!account.Carrier__c}" /></td>
                        <th><apex:outputLabel value="State"/></th>
                        <td><apex:outputField value="{!account.BillingState}" /></td>
                        <th><apex:outputLabel value="Alt Phone 2"/></th>
                        <td><apex:outputText >
                            <support:clickToDial number="{!contact.Alt_Phone_2__c}" entityId="{!opportunity.Id}" />
                            </apex:outputText></td>
                        <th><apex:outputLabel value="Close Date"/></th>
                        <td><apex:outputField value="{!opportunity.CloseDate}" /></td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr> 
                        <th></th>
                        <td></td>
                        <th><apex:outputLabel value="Postal Code"/></th>
                        <td><apex:outputField value="{!account.BillingPostalCode}" /></td>
                        <th><apex:outputLabel value="Email"/></th>
                        <td><apex:outputField value="{!contact.Email}" /></td>
                        <th><apex:outputLabel value="Pipeline Category"/></th>
                        <td><apex:outputField value="{!opportunity.ForecastCategoryName}" /></td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </apex:outputPanel>
        </apex:pageBlock>
    </apex:form>
</apex:component>