<apex:component >
    <apex:attribute name="stageHistories" type="Opportunity" required="true"
                    description="Stage History List"/>
    
    <apex:pageBlock title="Stage Histories">
        <apex:outputText rendered="{!stageHistories.OpportunityHistories.size = 0}">
            No records to display
        </apex:outputText>
        <apex:pageblocktable rendered="{!stageHistories.OpportunityHistories.size  > 0}"
                             value="{!stageHistories.OpportunityHistories}" var="a">
            <apex:column value="{!a.StageName}"/>
            <apex:column value="{!a.Probability}"/>
            <apex:column value="{!a.Amount}"/>
            <apex:column value="{!a.CloseDate}"/>
            <apex:column value="{!a.CreatedDate}"/>
        </apex:pageblocktable>
    </apex:pageBlock> 
</apex:component>