                <td>{!upsell.Premium_Exclusive_Available__c} </td> 
            </tr>
            <tr>
                <th>Basic</th>
                <td>{!upsell.Home_Basic_Lift__c}</td>
                <td>{!upsell.Taking_Basic__c} </td> 
                <td>{!upsell.Basic_Exclusive_Available__c} </td> 
            </tr>
            <tr>
                <th>Home</th>
                <td></td>
                <td>{!upsell.Taking_Home__c} </td> 
                <td>{!upsell.Home_Exclusive_Available__c} </td> 
            </tr>
        </table>
    </apex:pageBlockSection>
    <apex:pageBlockSection title="Lead Type" rendered="{!vertical == 'Life'}">
        <table class="infoTable">
            <tr>
                <th>Lead Type</th>
                <th>Weekly Lift</th>
                <th>Currently Taking </th>
                <th>Exclusive Available</th>
            </tr>
            <tr>
