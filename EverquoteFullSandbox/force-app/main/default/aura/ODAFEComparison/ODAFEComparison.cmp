<aura:component
  implements="flexipage:availableForRecordHome,force:hasRecordId"
  access="global"
  controller="ODALeadController"
>
  <!-- attributes -->
  <aura:attribute name="recordId" type="String" />
  <aura:attribute name="lead" type="Lead" default="{'sobjectType': 'Lead'}" />
  <aura:attribute name="leadLoaded" type="Boolean" default="false" />
  <aura:attribute name="validLead" type="Boolean" default="false" />
  <aura:attribute name="validAge" type="Boolean" default="false" />
  <aura:attribute name="errorMessage" type="String" default="null" />
  <aura:attribute name="comparisonToolUrl" type="String" default="null" />

  <!-- dependency -->
  <aura:dependency resource="markup://force:editRecord" type="EVENT" />

  <!-- handlers -->
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:handler event="force:refreshView" action="{!c.doInit}" />

  <aura:if isTrue="{!v.leadLoaded}">
    <div class="" style="padding: 10px;">
      <aura:if isTrue="{!v.validLead}">
        <aura:if isTrue="{!v.validAge}">
          <c:odaUserInfoBlock recordId="{!v.recordId}" />
          <hr />

          <div class="slds-text-heading_medium">
            Select link below to compare Final Expense products
          </div>
          <br />
          <aura:if isTrue="{!v.comparisonToolUrl}">
            <div class="slds-text-heading_large">
              <button class="slds-button slds-button_success" onclick="{!c.openComparisonTool}">
                Final Expense Comparison Tool
              </button>
            </div>
          </aura:if>

          <aura:if isTrue="{!v.errorMessage}">
            <div class="slds-text-heading_medium slds-text-color_error">{!v.errorMessage}</div>
          </aura:if>

          <aura:set attribute="else">
            <div class="slds-text-heading_medium">
              Lead age needs to be between 50 and 80 to use this comparison tool.
            </div>
            <hr />
            <c:odaLeadDateBirth
              minAge="50"
              maxAge="80"
              lead="{!v.lead}"
              dateOfBirth="{!v.lead.Date_of_Birth__c}"
              product="FE Comparison Tool"
              onleadupdated="{!c.onLeadUpdated}"
            ></c:odaLeadDateBirth>
          </aura:set>
        </aura:if>

        <aura:set attribute="else">
          <c:odaValidateLeadInfo
            lead="{!v.lead}"
            onvalidatelead="{!c.onValidateLead}"
            onleadupdated="{!c.onLeadUpdated}"
          ></c:odaValidateLeadInfo>
        </aura:set>
      </aura:if>
    </div>
    <aura:set attribute="else">
      <c:loadingSpinner></c:loadingSpinner>
    </aura:set>
  </aura:if>
</aura:component>