<aura:component
  implements="flexipage:availableForRecordHome,force:hasRecordId"
  access="global"
  controller="ODALeadController"
>
  <!-- attributes -->
  <aura:attribute name="recordId" type="String" />
  <aura:attribute name="lead" type="Lead" default="{'sobjectType': 'Lead'}" />
  <aura:attribute name="quoteAvailable" type="Boolean" default="false" />
  <aura:attribute name="quotes" type="List" />
  <aura:attribute name="eApp" type="Map" />
  <aura:attribute name="columns" type="List" />
  <aura:attribute name="maxRowSelection" type="Integer" default="1" />
  <aura:attribute name="selectedQuote" type="Object" />
  <aura:attribute name="eAppAvailable" type="Boolean" default="false" />
  <aura:attribute name="errorMessages" type="List" default="[]" />
  <aura:attribute name="quoteLoading" type="Boolean" default="false" />
  <aura:attribute name="existingApplications" type="Map[]" default="[]" />
  <aura:attribute name="resumeColumns" type="List" />
  <aura:attribute name="appFetchMessage" type="String" />
  <aura:attribute name="selectedApplication" type="Object" />

  <!-- dependency -->
  <aura:dependency resource="markup://force:editRecord" type="EVENT" />

  <!-- handlers -->
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:handler event="force:refreshView" action="{!c.doInit}" />

  <div class="">
    <aura:if isTrue="{!not(empty(v.errorMessages))}">
      <div
        class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error"
        role="alert"
      >
        <span class="slds-assistive-text">error</span>
        <span
          class="slds-icon_container slds-icon-utility-error slds-m-right_x-small"
          title="Description of icon when needed"
        />
        <h2>{!v.errorMessages[0]}</h2>
        <div class="slds-notify__close">
          <button
            class="slds-button slds-button_icon slds-button_icon-small slds-button_icon-inverse"
            title="Close"
            data-key="close"
          >
            <span class="slds-assistive-text">Close</span>
          </button>
        </div>
      </div>
    </aura:if>

    <!-- spinner for quotes loading -->
    <aura:if isTrue="{!v.quoteLoading}">
      <div class="slds-col slds-size_1-of-1">
        <div class="slds-spinner_container">
          <div role="status" class="slds-spinner slds-spinner_medium slds-spinner_brand">
            <span class="slds-assistive-text">Loading</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
          </div>
        </div>
      </div>
    </aura:if>

    <!-- Resume a Previous App -->

    <div class="slds-grid slds-gutters slds-wrap slds-border_bottom">
      <div class="slds-col slds-size_1-of-1">
        <div class="slds-text-heading_large">Resume Previous Application</div>
      </div>

      <div class="slds-col slds-size_1-of-1" id="load-previous-application">
        <span>
          <lightning:button
            class="slds-button slds-button_brand slds-button_stretch"
            label="Load Previous Application"
            onclick="{!c.fetchPreviousApplication}"
            iconName="utility:record_update"
          />
        </span>
      </div>

      <div class="slds-col slds-size_1-of-1">
        <span>
          <lightning:button
            class="slds-button slds-button_success slds-button_stretch"
            label="Resume Previous Application"
            onclick="{!c.eAppResumeCall}"
            disabled="{! !v.selectedApplication }"
          />
        </span>
      </div>

      <div class="slds-col slds-size_1-of-1" id="quote-table">
        <lightning:datatable
          columns="{! v.resumeColumns }"
          data="{! v.existingApplications }"
          keyField="app_id"
          maxRowSelection="{! v.maxRowSelection }"
          onrowselection="{! c.updateSelectedApplication }"
        />
        <aura:if
          isTrue="{! not(or(and(v.existingApplications, v.existingApplications.length), v.appFetchMessage)) }"
        >
          <div class="slds-m-top_medium"></div>
          <div class="slds-align_absolute-center">
            <lightning:icon
              iconName="utility:recurring_exception"
              alternativeText="No Data"
            ></lightning:icon>
          </div>
          <div class="slds-align_absolute-center slds-text-heading_small">
            No Application Loaded
          </div>
        </aura:if>
        <div style="text-align: center; margin-top: 50px;" class="slds-text-heading_small">
          {!v.appFetchMessage}
        </div>
      </div>
    </div>

    <!-- Begin a new app -->
    <div class="slds-grid slds-gutters slds-wrap slds-m-top_medium">
      <div class="slds-col slds-size_1-of-1">
        <div class="slds-text-heading_large">Begin a New Application</div>
      </div>

      <!-- get quote -->
      <div class="slds-col slds-size_1-of-1">
        <span>
          <lightning:button
            class="slds-button slds-button_brand slds-button_stretch"
            label="Get Quotes"
            onclick="{!c.quoteCall}"
            iconName="utility:quote"
          />
        </span>
      </div>

      <!-- E-App -->
      <div class="slds-col slds-size_1-of-2">
        <span>
          <lightning:button
            class="slds-button slds-button_success slds-button_stretch"
            disabled="{! !v.quoteAvailable}"
            label="Launch E-App"
            onclick="{!c.eAppCall}"
          />
        </span>
      </div>

      <!-- quote table -->
      <div class="slds-col slds-size_1-of-1 slds-border_bottom" id="quote-table">
        <lightning:datatable
          columns="{! v.columns }"
          data="{! v.quotes }"
          keyField="id"
          maxRowSelection="{! v.maxRowSelection }"
          onrowselection="{! c.updateSelectedQuote }"
        />

        <aura:if isTrue="{! not(and(v.quotes, v.quotes.length)) }">
          <div class="slds-m-top_medium"></div>
          <div class="slds-align_absolute-center">
            <lightning:icon
              iconName="utility:recurring_exception"
              alternativeText="No Data"
            ></lightning:icon>
          </div>
          <div class="slds-align_absolute-center slds-text-heading_small">No Quotes Loaded</div>
        </aura:if>
      </div>
    </div>
  </div>
</aura:component>