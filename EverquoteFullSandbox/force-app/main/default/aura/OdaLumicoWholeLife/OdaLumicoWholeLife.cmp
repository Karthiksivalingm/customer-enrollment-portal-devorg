<aura:component
  implements="flexipage:availableForRecordHome,force:hasRecordId"
  access="global"
  controller="ODALeadController"
>
  <!-- attributes -->
  <aura:attribute name="recordId" type="String" />
  <aura:attribute name="lead" type="Lead" default="{'sobjectType': 'Lead'}" />

  <aura:attribute name="validLead" type="Boolean" default="false" />
  <aura:attribute name="validAge" type="Boolean" default="false" />
  <aura:attribute name="minAge" type="Integer" default="18" />
  <aura:attribute name="maxAge" type="Integer" default="70" />
  <aura:attribute name="product" type="String" default="wl" />
  <aura:attribute name="carrier" type="String" default="lumico" />
  <aura:attribute name="leadLoaded" type="Boolean" default="false" />

  <!-- dependency -->
  <aura:dependency resource="markup://force:editRecord" type="EVENT" />

  <!-- handlers -->
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:handler event="force:refreshView" action="{!c.doInit}" />

  <aura:if isTrue="{!v.leadLoaded}">
    <div class="" style="padding: 10px;">
      <aura:if isTrue="{!v.validLead == false}">
        <c:odaValidateLeadInfo
          lead="{!v.lead}"
          onvalidatelead="{!c.onValidateLead}"
          onleadupdated="{!c.onLeadUpdated}"
        ></c:odaValidateLeadInfo>
      </aura:if>

      <aura:if isTrue="{!v.validLead}">
        <aura:if isTrue="{!v.validAge}">
          <!-- Lead details -->
          <c:odaUserInfoBlock recordId="{!v.recordId}" />
          <hr />

          <!-- Begin a new app -->
          <c:odaNewLumicoWholeLife
            lead="{!v.lead}"
            onleadupdated="{!c.onLeadUpdated}"
          ></c:odaNewLumicoWholeLife>

          <hr />
          <!-- Resume a Previous App -->
          <c:odaResumeApp
            lead="{!v.lead}"
            product="{!v.product}"
            carrier="{!v.carrier}"
          ></c:odaResumeApp>

          <aura:set attribute="else">
            <c:odaLeadDateBirth
              minAge="{!v.minAge}"
              maxAge="{!v.maxAge}"
              lead="{!v.lead}"
              dateOfBirth="{!v.lead.Date_of_Birth__c}"
              product="{!v.product}"
              onleadupdated="{!c.onLeadUpdated}"
            ></c:odaLeadDateBirth>
          </aura:set>
        </aura:if>
      </aura:if>
    </div>
    <aura:set attribute="else">
      <c:loadingSpinner></c:loadingSpinner>
    </aura:set>
  </aura:if>
</aura:component>