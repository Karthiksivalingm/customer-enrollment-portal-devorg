    <rules>
        <fullName>AGP IO Notification</fullName>
        <actions>
            <name>AGP_IO_attached_email_alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.RecordTypeId</field>
            <operation>equals</operation>
            <value>Accelerated-AGP</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Insertion_Order_Attached__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Support_Rep__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Anchor</fullName>
        <actions>
            <name>Opportunity_Name_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND( NOT(ISBLANK(Name)), OR(RecordTypeId = &apos;0121a000000EqqS&apos;, RecordTypeId = &apos;0121a000000RNO1&apos;, RecordTypeId = &apos;012290000004YWz&apos;) )</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Close date is 14 days after creation</fullName>
        <actions>
            <name>Closed_Date_to_2_weeks_from_created_date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Name</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.CreatedById</field>
            <operation>notContain</operation>
            <value>madeleine,victoria</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.RecordTypeId</field>
            <operation>equals</operation>
            <value>Agency</value>
        </criteriaItems>
        <description>when an opportunity is created, the closed date will be set to 2 weeks after the created date</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Closed Won</fullName>
