    <rules>
        <fullName>Callback Follow-up</fullName>
        <actions>
            <name>Follow_up_with_Lead</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Task.Call_Outcome__c</field>
            <operation>equals</operation>
            <value>&quot;Callback scheduled, still in market&quot;</value>
        </criteriaItems>
        <description>Creates a task to follow up with the Lead when Call Outcome = Callback Scheduled</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Contact Field on Activity</fullName>
        <active>true</active>
        <booleanFilter>1 OR 2 OR 3</booleanFilter>
        <criteriaItems>
            <field>Task.CallDisposition</field>
            <operation>equals</operation>
            <value>Spoke to Decision Maker</value>
        </criteriaItems>
        <criteriaItems>
            <field>Task.CallDisposition</field>
            <operation>equals</operation>
            <value>Spoke to Non Decision Maker</value>
        </criteriaItems>
        <criteriaItems>
            <field>Task.CallDisposition</field>
            <operation>equals</operation>
            <value>Live Message</value>
        </criteriaItems>
        <description>update correct contact when call results is correct contact</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Correct Contact</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Task.CallDisposition</field>
            <operation>equals</operation>
            <value>Spoke to Decision Maker</value>
        </criteriaItems>
        <description>update correct contact when call results is correct contact</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update IsLead for activity on lead</fullName>
        <actions>
            <name>isLead_field_update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>BEGINS(WhoId , &quot;00Q&quot;)</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Update type to Email</fullName>
        <actions>
            <name>Update_type_to_Email</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>If an ISR logs an email as a task, update the task type to Email.</description>
        <formula>BEGINS( Subject  , &quot;Email:&quot;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>task type for calls</fullName>
        <actions>
            <name>task_type_for_calls</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Task.Subject</field>
            <operation>equals</operation>
            <value>Outbound Call,Inbound Call</value>
        </criteriaItems>
        <description>update task type for outbound or inbound calls to &quot;call&quot;</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <tasks>
