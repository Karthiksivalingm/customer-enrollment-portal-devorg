<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Referral_Credit_Must_be_0_250_or_50</fullName>
    <active>true</active>
    <description>Referral credit amount must be 0, 50, 250 or 500</description>
    <errorConditionFormula>AND(
Referral_Credit__c &lt;&gt; 50,
Referral_Credit__c &lt;&gt; 0,
Referral_Credit__c &lt;&gt; 500,
Referral_Credit__c &lt;&gt; 250)</errorConditionFormula>
    <errorMessage>Referral Credit Must be $0, $50, or $250</errorMessage>
</ValidationRule>
