<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Year_to_Date_Day__c</fullName>
    <formula>(CloseDate - DATE(YEAR(CloseDate),01,01)) &lt;= (TODAY() - DATE(YEAR(TODAY()),01,01))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Year to Date (Day)</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
