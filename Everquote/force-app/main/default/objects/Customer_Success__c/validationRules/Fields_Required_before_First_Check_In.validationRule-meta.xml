<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fields_Required_before_First_Check_In</fullName>
    <active>false</active>
    <errorConditionFormula>AND((ISPICKVAL(Onboarding_Stage__c, &quot;Training Complete&quot;)), 
OR(ISPICKVAL(Customer_Mode_at_Handoff__c, &quot;&quot;), 
ISPICKVAL(Conducted_Agency_Training__c, &quot;&quot;)))</errorConditionFormula>
    <errorMessage>Before moving the Stage to Training Complete, please fill out the Customer Mode at Handoff and Conducted Agency Training.</errorMessage>
</ValidationRule>
