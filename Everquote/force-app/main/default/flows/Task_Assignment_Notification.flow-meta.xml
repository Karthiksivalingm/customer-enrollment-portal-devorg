    <description>Replace default notifications when a task is assigned</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Task].RecordTypeId =&apos;0122L0000006WBqQAM&apos;,
    NOT(TEXT([Task].Status)  = &apos;Completed&apos;),
    ISNEW(), 
    NOT([Task].CreatedBy.Id = [Task].Owner:User.Id ),
    OR(
       BEGINS([Task].Subject, &apos;Sage - Hot Lead Assigned&apos; ),
       BEGINS([Task].Subject, &apos;Sage - Fresh Lead Assigned&apos; ) 
  )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
    NOT(TEXT({!myVariable_current.Status})  = &apos;Completed&apos;),
    ISNEW(), 
    NOT({!myVariable_current.CreatedBy.Id} = {!myVariable_current.Owner:User.Id} ),
    OR(
       BEGINS({!myVariable_current.Subject}, &apos;Sage - Hot Lead Assigned&apos; ),
       BEGINS({!myVariable_current.Subject}, &apos;Sage - Fresh Lead Assigned&apos; ) 
  )
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Task].RecordTypeId =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT([Task].Status)  = &apos;Completed&apos;),
   ISNEW(),
   NOT([Task].CreatedBy.Id = [Task].Owner:User.Id )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT({!myVariable_current.Status})  = &apos;Completed&apos;),
   ISNEW(),
   NOT({!myVariable_current.CreatedBy.Id} = {!myVariable_current.Owner:User.Id} )
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Task].RecordTypeId =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT([Task].Status)  = &apos;Completed&apos;),
   NOT(ISNEW()),
   [Task].Owner:User.Id &lt;&gt; PRIORVALUE([Task].Owner:User.Id), 
   [Task].Owner:User.Id &lt;&gt; [Task].LastModifiedBy.Id 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordTypeId} =&apos;0122L0000006WBqQAM&apos;,
   NOT(TEXT({!myVariable_current.Status})  = &apos;Completed&apos;),
   NOT(ISNEW()),
   {!myVariable_current.Owner:User.Id} &lt;&gt; PRIORVALUE({!myVariable_current.Owner:User.Id}), 
   {!myVariable_current.Owner:User.Id} &lt;&gt; {!myVariable_current.LastModifiedBy.Id} 
)</expression>
    </formulas>
