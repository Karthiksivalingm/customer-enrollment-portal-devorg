    <decisions>
        <name>Can_Owner_be_changed</name>
        <label>Can Owner be changed</label>
        <locationX>839</locationX>
        <locationY>422</locationY>
        <defaultConnector>
            <targetReference>Lead_Owner_Cannot_be_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Lead_Approved_change_owner</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 ) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>Lead_In_Queue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LeadStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost, Unqualified, Exhausted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>m30daysago</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>No_Activity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LeadStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_lead_owner_to_New_Lead_owner</targetReference>
            </connector>
            <label>Lead Approved, change owner</label>
        </rules>
        <rules>
            <name>Date_of_Last_activity_less_than_30_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>m30daysago</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Lead_In_Queue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LeadStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Lost, Unqualified, Exhausted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lead_Owner_Cannot_Changed_due_to_Activity_on_the_Record</targetReference>
            </connector>
            <label>Date of Last activity less than 30 days</label>
        </rules>
        <rules>
            <name>Create_a_new_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LeadStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Closed_Lead</targetReference>
            </connector>
            <label>Create a new Lead</label>
        </rules>
    </decisions>
