<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>If Account is AGP, assign Accelerated price book
If Account is Core/Starter (or other), assign Agency price book</description>
        <name>Account_Type</name>
        <label>Account Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_Agency_Price_Book_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Core/Starter (or other)</defaultConnectorLabel>
        <rules>
            <name>Open_Accelerated</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP Premier</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Accelerated_Price_Book_Id</targetReference>
            </connector>
            <label>Open Accelerated</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_is_the_opportunity_record_type</name>
        <label>What is the opportunity record type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Accelerated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated_AGP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Accelerated_Price_Book_Id</targetReference>
            </connector>
            <label>Accelerated-AGP</label>
        </rules>
        <rules>
            <name>Agency</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agency</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Agency_Price_Book_Id</targetReference>
            </connector>
            <label>Agency</label>
        </rules>
        <rules>
            <name>CS_Upsell</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agency_CS_Upsell</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Type</targetReference>
            </connector>
            <label>CS Upsell</label>
        </rules>
    </decisions>
    <description>When an opportunity is created a Price Book is assigned based on the record type:
Agency - Agency Price Book
Accelerated-AGP - Accelerated Price Book
CS Upsell - If Account Type is AGP, Accelerated Price Book. If Account Type is Core/Starter, Agency Price Book.

S3P-1138 - Created.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity_Created_AssignPriceBook {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity_Created_AssignPriceBook</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the Accelerated Price Book Id so it can be assigned to the triggering opp.</description>
        <name>Get_Accelerated_Price_Book_Id</name>
        <label>Get Accelerated Price Book Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Accelerated_Price_Book</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accelerated Price Book</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricebook2</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the Agency Price Book Id so it can be assigned to the triggering opp.</description>
        <name>Get_Agency_Price_Book_Id</name>
        <label>Get Agency Price Book Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Agency_Price_Book</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Agency Price Book</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricebook2</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Assign the Accelerated Price Book to the triggering opportunity</description>
        <name>Assign_Accelerated_Price_Book</name>
        <label>Assign Accelerated Price Book</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Pricebook2Id</field>
            <value>
                <elementReference>Get_Accelerated_Price_Book_Id.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Assign the Agency Price Book to the triggering opportunity</description>
        <name>Assign_Agency_Price_Book</name>
        <label>Assign Agency Price Book</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Pricebook2Id</field>
            <value>
                <elementReference>Get_Agency_Price_Book_Id.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>What_is_the_opportunity_record_type</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
