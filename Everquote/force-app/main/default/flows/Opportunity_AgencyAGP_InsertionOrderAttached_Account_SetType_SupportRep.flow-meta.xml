    <decisions>
        <name>Is_Opportunity_Premier_Amount_10K_or_more</name>
        <label>Is Opportunity Premier (Amount 10K or more)?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_the_Account_Type_already_AGP_or_AGP_Premier</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>AGP (less thank 10K)</defaultConnectorLabel>
        <rules>
            <name>AGP_Premier_10K_or_more</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>10000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_Account_Type_already_AGP_Premier</targetReference>
            </connector>
            <label>AGP Premier (10K or more)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_Account_Type_already_AGP_or_AGP_Premier</name>
        <label>Is the Account Type already AGP or AGP Premier?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_AGP_Record_Type_Type_and_Support_Rep</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not AGP/Premier</defaultConnectorLabel>
        <rules>
            <name>AGP</name>
            <conditionLogic>(1 OR 4) AND 2 AND 3 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Support_Rep__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Support_Rep__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Core_User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP Premier</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account</targetReference>
            </connector>
            <label>Open AGP/Premier with Support Rep</label>
        </rules>
    </decisions>
