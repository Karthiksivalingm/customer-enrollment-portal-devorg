<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Account_Support_Rep_as_Case_Owner</name>
        <label>Assign Account Support Rep as Case Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewFillRateCase.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Support_Rep__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Fill_Rate_Case</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign Case Subject, Project, Description, Topic, Account Id, Record Type Id</description>
        <name>Assign_Case_Details</name>
        <label>Assign Case Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewFillRateCase.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inbound Calls - Issue Outreach</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewFillRateCase.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inbound Calls</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewFillRateCase.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.IBC_loIBC_low_fw_fillrate_trigger_reason__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewFillRateCase.Topic__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Evergreen</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewFillRateCase.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewFillRateCase.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case_Record_Type_Account_Management.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Primary_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Case_Owner_as_Starter_Evergreen_Queue</name>
        <label>Assign Case Owner as Starter Evergreen Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewFillRateCase.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Starter_Evergreen_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Fill_Rate_Case</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the name of the flow and component that failed, so they can be referenced in the subflow that sends the error email.</description>
        <name>Assign_Failed_Flow_Component_Variable</name>
        <label>Assign Failed Flow Component Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailedFlowComponent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>RTFL_Account_IBC_CreateCase_LowFillRate  - Create Fill Rate Case</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the name of the flow and component that failed, so they can be referenced in the subflow that sends the error email.</description>
        <name>Assign_Failed_Flow_Component_Variable1</name>
        <label>Assign Failed Flow Component Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailedFlowComponent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>RTFL_Account_IBC_CreateCase_LowFillRate  - Set IBC Low Fill Rate Case Trigger to False</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the Contact from the Account that was most recently modified as the Contact on the new case record</description>
        <name>Assign_Last_Modified_Contact_as_Case_Contact</name>
        <label>Assign Last Modified Contact as Case Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewFillRateCase.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Last_Modified_Contact_from_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>What_is_the_Account_Type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Primary_Contact_as_Case_Contact</name>
        <label>Assign Primary Contact as Case Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewFillRateCase.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Contact.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>What_is_the_Account_Type</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Unable_to_Create_Case</name>
        <label>Unable to Create Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Failed_Flow_Component_Variable</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>Salesforce attempted to create a new case due to the change on the Account&apos;s IBC_non_call_buyer_case_trigger, but failed.
Your Salesforce Administrator  has been notified.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Was a contact found in the previous get records component?</description>
        <name>Does_Account_have_a_Contact</name>
        <label>Does Account have a Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>What_is_the_Account_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account has no contacts</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Last_Modified_Contact_from_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Last_Modified_Contact_as_Case_Contact</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Was a primary contact found in the previous get records element? If yes, assign it to the case, if no, get a random contact from the Account and assign it to the case</description>
        <name>Does_Account_have_a_Primary_Contact</name>
        <label>Does Account have a Primary Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Primary_Contact_as_Case_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Primary Contact</defaultConnectorLabel>
        <rules>
            <name>No_Primary_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Last_Modified_Contact_from_Account</targetReference>
            </connector>
            <label>No Primary Contact</label>
        </rules>
    </decisions>
    <decisions>
        <description>We will assign the newly created case based on the triggering Account&apos;s Type and Support Rep,</description>
        <name>What_is_the_Account_Type</name>
        <label>What is the Account Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Starter_Evergreen_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Open_AGP_Core_with_Support_Rep</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Support_Rep__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accelerated-AGP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Support_Rep_as_Case_Owner</targetReference>
            </connector>
            <label>Open AGP/Core with Support Rep</label>
        </rules>
    </decisions>
    <description>When an Account&apos;s IBC Low Fill Rate Trigger field is checked, creates a new case.
Scheduled path sets IBC Low Fill Rate Trigger field to false after 45 days.

S3P-904 - Added assignment of Topic to &quot;Evergreen&quot;.
S3P-947 - Changed Project to &quot;Inbound Calls&quot; from &quot;Inbound Calls - Issue Resolution&quot;.
S3P-1070 - Changed scheduled path to run after 45 days.
S3P-1108 - Removed subflow, moved all actions into this single flow.</description>
    <environments>Default</environments>
    <interviewLabel>Account_IBCLowFillRate_CreateCase_LowFillRate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_IBCLowFillRate_CreateCase_LowFillRate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>When a Account&apos;s IBC Low Fill Rate Case Trigger field is set to true, create a case for CS to follow-up.</description>
        <name>Create_Fill_Rate_Case</name>
        <label>Create Fill Rate Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Unable_to_Create_Case</targetReference>
        </faultConnector>
        <inputReference>NewFillRateCase</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Get the Account Management case record type</description>
        <name>Get_Case_Record_Type_Account_Management</name>
        <label>Get Case Record Type: Account Management</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Case_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Case</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account_Management</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the Contact from the Account that was most recently modified</description>
        <name>Get_Last_Modified_Contact_from_Account</name>
        <label>Get Last Modified Contact from Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Account_have_a_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get a Contact listed as Primary Contact from the triggering account</description>
        <name>Get_Primary_Contact</name>
        <label>Get Primary Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Account_have_a_Primary_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the case queue with label &quot;Starter Evergreen&quot; and api name &quot;Starter&quot;.</description>
        <name>Get_Starter_Evergreen_Queue</name>
        <label>Get Starter Evergreen Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Case_Owner_as_Starter_Evergreen_Queue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Starter</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Set IBC Low Fill Rate Case Trigger to False and IBC Low Fill Rate Case Trigger Reason to blank</description>
        <name>Set_Low_Fill_Rate_Case_Trigger_to_False</name>
        <label>Set IBC Low Fill Rate Case Trigger to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Failed_Flow_Component_Variable1</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>IBC_Low_Fill_Rate_Case_Trigger__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IBC_loIBC_low_fw_fillrate_trigger_reason__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Record_Type_Account_Management</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IBC_Low_Fill_Rate_Case_Trigger__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X35_Days_After_Trigger</name>
            <connector>
                <targetReference>Set_Low_Fill_Rate_Case_Trigger_to_False</targetReference>
            </connector>
            <label>45 Days After Trigger</label>
            <offsetNumber>45</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Subflow sends an email to certain Admins with information about the error.</description>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
                <elementReference>FailedFlowComponent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>If the flow fails, stores the component where the fault path was triggered.</description>
        <name>FailedFlowComponent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Used to store variables for creating a new case for an Account with low fill rate.</description>
        <name>NewFillRateCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
