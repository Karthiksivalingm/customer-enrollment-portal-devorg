    <decisions>
        <description>Check if the Account has a primary contact, if yes, assign Contact to Case.</description>
        <name>Does_Primary_Contact_Exist</name>
        <label>Does Primary Contact Exist?</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Does_Prior_Support_Rep_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Primary_Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Primary_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Contact</targetReference>
            </connector>
            <label>Primary Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the Account had a Support Rep prior to the triggering edit, if not, check if there was a Support Rep added during the triggering edit, assign these as the new Case&apos;s owner.</description>
        <name>Does_Prior_Support_Rep_Exist</name>
        <label>Does Prior Support Rep Exist</label>
        <locationX>314</locationX>
        <locationY>947</locationY>
        <defaultConnector>
            <targetReference>Create_New_Case_Account_Tier_Change</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Prior_Support_Rep_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Support_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Owner_as_Prior_Support_Rep</targetReference>
            </connector>
            <label>Prior Support Rep Found</label>
        </rules>
        <rules>
            <name>Current_Support_Rep_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Support_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Owner_as_Current_Support_Rep</targetReference>
            </connector>
            <label>Current Support Rep Found</label>
        </rules>
    </decisions>
    <description>Activate temporarily when Accounts are updated via Dataloader for the quarterly Account Tiering Process.
When an Account record type is change from Accelerated to Agency, create a case assigned to the prior Support Rep (Support Rep is changed in the Dataloader update), to follow up with the customer and complete actions in Pro. Exclude Accounts that aren&apos;t in open status.

S3P-821 - Created
S3P-947 - Added Topic &quot;Account Tiering&quot;
S3P-1024 - Added Case Origin &quot;Internal&quot;
S3P-1145 - Saved as new flow. Updated Subject to &quot;Account Tier Change - AGP to Starter&quot;. Update start criteria to look for Account Type instead of Account Record Type change. Updated Case Description to mention the Do Not Send Automated Email field.</description>
    <environments>Default</environments>
    <interviewLabel>Account_TypeChange_AGPtoStarter_CreateCaseTierChange {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_TypeChange_AGPtoStarter_CreateCaseTierChange</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create the new case for Account Tier Change that we have previously assigned all of the field values to</description>
        <name>Create_New_Case_Account_Tier_Change</name>
        <label>Create New Case - Account Tier Change</label>
        <locationX>314</locationX>
        <locationY>1247</locationY>
        <faultConnector>
            <targetReference>Assign_Failing_Component_Name</targetReference>
        </faultConnector>
        <inputReference>NewCase</inputReference>
    </recordCreates>
    <recordLookups>
        <name>get_Case_Record_Type</name>
        <label>get Case Record Type</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Case_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Case</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account_Management</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_Primary_Contact</name>
        <label>get Primary Contact</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Primary_Contact_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_Case_Record_Type</targetReference>
        </connector>
        <filterFormula>/*Runs when an Account is not Closed, and it is changed from the Accelerated to the Agency record type*/
AND(
        {!$Record.Account_Status__c}=&quot;open&quot;,
        ISPICKVAL({!$Record__Prior.Type}, &quot;Accelerated-AGP&quot;),
        ISPICKVAL({!$Record.Type}, &quot;Starter&quot;)
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>754</locationX>
        <locationY>1463</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
