            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <description>Used to fill out the Description field on the new Account Tier Change case being created</description>
        <name>CaseDescription</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>This case was created because the agent has been removed from AGP tier.

When you close this case, an email will be sent to the Primary Contact on this Account to notify them of the change. If, for some reason, an email should not be sent upon closure, please check the &quot;Do not send automated email&quot; field before closing. 

Before closing this case, PLEASE ADD DETAILS ABOUT THE TIER MOVEMENT in the Results field and make sure you COMPLETE THESE ADMINISTRATIVE ACTIONS IN PRO:
- Remove Promos
- Move Account Classification
- Change Prices
- Remove Services</text>
    </textTemplates>
    <variables>
        <name>FailingComponent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>NewCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
