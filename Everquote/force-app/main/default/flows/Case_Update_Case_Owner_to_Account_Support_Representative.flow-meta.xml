    <formulas>
        <name>entryCondition</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
  AND(
    TEXT({!$Record.Topic__c}) = &quot;GTM Inbound Calls&quot;,
    TEXT({!$Record.Project__c}) = &quot;New Calls Product Adoption&quot;,
    {!$Record.RecordTypeId}= {!Get_Case_Record_Type.Id}
  )
)</expression>
    </formulas>
    <formulas>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.AccountId})) &amp;&amp;
NOT(ISNULL({!$Record.AccountId})) &amp;&amp;
NOT(ISBLANK({!$Record.Account.Support_Rep__c})) &amp;&amp;
NOT(ISNULL({!$Record.Account.Support_Rep__c})) &amp;&amp;
{!$Record.Account.Support_Rep__r.IsActive} = TRUE &amp;&amp;
OR(ISCHANGED({!$Record.AccountId}), ISNEW()) &amp;&amp;
NOT(CONTAINS({!$Record.OwnerId}, &apos;00G2L000001Tmdp&apos;)) &amp;&amp; 
NOT(CONTAINS({!$Record.OwnerId}, &apos;00G2L000001Tmdk&apos;)) &amp;&amp;
NOT(CONTAINS({!$Record.OwnerId}, &apos;00GVm000000aIG9MAM&apos;)) &amp;&amp;
NOT(CONTAINS({!$Record.OwnerId}, &apos;00GVm000001CG3dMAG&apos;))</expression>
    </formulas>
    <interviewLabel>Case: Update Case Owner to Account Support Rep {!$Flow.CurrentDateTime}</interviewLabel>
