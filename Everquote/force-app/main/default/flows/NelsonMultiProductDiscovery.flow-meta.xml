        <fields>
            <name>Program_Recommendation</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Program Recommendation: &lt;/strong&gt;Accelerated Growth Program (AGP)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;AGP is often a good fit for agents with more than 2 sales producers that are tech enabled, looking to sustainably grow their business, and desire to work closely with a Business Consultant to review data and optimize their account.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://2287971.fs1.hubspotusercontent-na1.net/hubfs/2287971/2025%20AGP%201-Pager.pdf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;AGP 1-pager for agents&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>How_many_producers_do_you_have_working_leads</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>More_than_2</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ProgramRecommendationCore</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Program Recommendation:&lt;/strong&gt; Core&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If an agent has a smaller agency and less than 2 producers Core is typically a better fit than AGP since they may not have the staffing to work AGP levels of lead volume. In the Core program, they can still receive team training/onboarding, quarterly business reviews, and access to our experienced team of customer success managers &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>How_many_producers_do_you_have_working_leads</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Less_than_2</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ProductRecLCS</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Product Recommendation: &lt;/strong&gt;Lead Connection Service&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;LCS is great for helping new agents or producers who may need help with the initial process of working leads.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://2287971.fs1.hubspotusercontent-na1.net/hubfs/2287971/2025%20LCS%201-Pager.pdf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;LCS 1-pager for agents&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>or</conditionLogic>
                <conditions>
                    <leftValueReference>What_level_of_experience_do_your_LSPs_have</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>New</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Has_your_agency_worked_internet_leads_before</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>No</stringValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>What_level_of_experience_do_your_LSPs_have</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Mix_of_both</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ProductRecLCSET</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Product Recommendation: &lt;/strong&gt;Lead Connection Service with Enhanced Targeting&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;LCS with enhanced targeting can be great for agents that know what consumer traits they really value, but have trouble connecting with those shoppers&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://2287971.fs1.hubspotusercontent-na1.net/hubfs/2287971/2025%20LCS%201-Pager.pdf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;LCS 1-pager for agents&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>What_level_of_experience_do_your_LSPs_have</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Tenured</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Has_your_agency_worked_internet_leads_before</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Yes</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>What_is_your_average_bind_rate</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Less_than_3</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ProductRecCICs</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Product Recommendation: &lt;/strong&gt;Consumer-Initiated Inbound Calls&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;CICs are great for agents that know how to sell/close deals but have not had a positive experience with leads. LCS with enhanced targeting could also be a good product option since the agent can target consumer traits they value more and that will create a better lead working experience&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://2287971.fs1.hubspotusercontent-na1.net/hubfs/2287971/Consumer-Initiated%20Inbound%20Calls%201-Pager.pdf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;CIC 1-pager for agents&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>(1 OR 2) AND 3</conditionLogic>
                <conditions>
                    <leftValueReference>What_was_your_experience_like_with_those_products</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Negative</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>What_is_your_average_bind_rate</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Less_than_3</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>What_level_of_experience_do_your_LSPs_have</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Tenured</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ProductRecET</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Product Recommendation&lt;/strong&gt;: Enhanced Targeting&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Agents with high bind rates typically have a refined process for working leads and may not be the best fit for LCS. Enhanced targeting can be a great way for these agents to get more of the consumers they know they are competitive with and provide the best lifetime value for the agent&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>What_level_of_experience_do_your_LSPs_have</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Tenured</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Has_your_agency_worked_internet_leads_before</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Yes</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
