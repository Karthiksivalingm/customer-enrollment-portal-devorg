    <decisions>
        <name>agent_available_routing</name>
        <label>agent available routing</label>
        <locationX>1073</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>case_history</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>agent_available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>agent_availability_check.onlineAgentsCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>agent_availability_check.estimatedWaitTime</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>600.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>route_to_agent</targetReference>
            </connector>
            <label>agent available</label>
        </rules>
    </decisions>
    <decisions>
        <description>Based on the loop count, take an action. 
If loop count = 1, skip the first record (because the first record is actually record 0, the current case we want to route)
If loop count &gt; 5, end loop (so we don&apos;t iterate through everything)</description>
        <name>filter_or_end_loop</name>
        <label>filter or end loop</label>
        <locationX>819</locationX>
        <locationY>541</locationY>
        <defaultConnector>
            <targetReference>agent_availability_check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>count_equals_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopcount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>case_history</targetReference>
            </connector>
            <label>count equals 1</label>
        </rules>
        <rules>
            <name>count_greater_than_5</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopcount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_agent_assignment</targetReference>
            </connector>
            <label>count greater than 5</label>
        </rules>
    </decisions>
