    <decisions>
        <description>Check with object the survey is related to by checking if Typeform has populated the Case Id or the Customer Success Id.</description>
        <name>Related_Case_or_Customer_Success_Record</name>
        <label>Related Case or Customer Success Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
