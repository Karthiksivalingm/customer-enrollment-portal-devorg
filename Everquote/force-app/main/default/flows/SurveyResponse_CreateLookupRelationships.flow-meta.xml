    <description>When a Survey Response record is created by Typeform Integration, used the Contact Id, Case Id, and Customer Success Id values to create Lookup relationships with the correct records and assign the Support Rep. Also update the Survey Response Name.</description>
    <environments>Default</environments>
    <formulas>
        <description>The value we want to update Feedback Survey Response Name to &quot;Survey Name - Date - Case Number/Customer Success Name&quot;</description>
        <name>FeedbackSurveyResponseNameForUpdate</name>
        <dataType>String</dataType>
        <expression>LEFT(
IF(NOT(ISBLANK({!$Record.Case_Id__c})),
{!$Record.Survey_Name__c} + &quot; - &quot; + TEXT(TODAY()) +  &quot; - Case: &quot; + {!Get_Related_Case.CaseNumber},
IF(NOT(ISBLANK({!$Record.Customer_Success_Id__c})),
{!$Record.Survey_Name__c} + &quot; - &quot; + TEXT(TODAY()) +  &quot; - CS: &quot; + {!Get_Related_Customer_Success.Name} ,
{!$Record.Survey_Name__c} + &quot; - &quot; + TEXT(TODAY())
))
,80)</expression>
    </formulas>
