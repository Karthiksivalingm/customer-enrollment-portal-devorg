<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>update open tasks assigned to dan mccoy to the record owner</description>
    <interviewLabel>Update Open tasks to Lead owner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Open tasks to Lead owner</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
