<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Add to collection variable</description>
        <name>Add_to_AccountsToUpdate</name>
        <label>Add to AccountsToUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Accounts_in_Hierarchy</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Accounts_in_Hierarchy</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_as_Top_Parent_Account</name>
        <label>Assign as Top Parent Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TopParentAcccount.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Triggering_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TopParentAcccount.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Triggering_Account.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TopParentAcccount.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Triggering_Account.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TopParentAcccount.Support_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Triggering_Account.Support_Rep__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Account_Hierarchy_Children</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Save the name of the flow component that failed</description>
        <name>Assign_Failing_Component</name>
        <label>Assign Failing Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FailingFlowComponent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Account_Button_UpdateHierarchy - Update Accounts</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Fault_Path_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Record_Type_Type_and_Support_Rep</name>
        <label>Assign Record Type, Type, and Support Rep</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TopParentAcccount.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TopParentAcccount.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.Support_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TopParentAcccount.Support_Rep__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Bypass_Account_Validation</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Bypass the Account validation, Account_TopAccountOnly_ChangeTypeOrRep, that prevents updating children accounts</description>
        <name>Bypass_Account_Validation</name>
        <label>Bypass Account Validation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts_in_Hierarchy.BypassAccountValidation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OppositeBypassAccountValidation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_AccountsToUpdate</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Does_Account_Have_Children</name>
        <label>Does Account Have Children?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Has No Children</defaultConnectorLabel>
        <rules>
            <name>Has_Children</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Hierarchy_Children</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Accounts_in_Hierarchy</targetReference>
            </connector>
            <label>Has Children</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the Triggering Account the Top Account in the hierarchy?</description>
        <name>Is_Account_Top_Parent</name>
        <label>Is Account Top Parent?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Top_Parent_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Child Account</defaultConnectorLabel>
        <rules>
            <name>Top_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Triggering_Account.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Triggering_Account.Top_Parent_Account_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_as_Top_Parent_Account</targetReference>
            </connector>
            <label>Top Account</label>
        </rules>
    </decisions>
    <description>Triggered by button on Account
Get the Top Account in the hierarchy and update all Accounts in the hierarchy to match it&apos;s record type, type, and support rep</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns the opposite of whatever is currently the value of BypassAccountValidation</description>
        <name>OppositeBypassAccountValidation</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Loop_Accounts_in_Hierarchy.BypassAccountValidation__c} = TRUE, FALSE, TRUE)</expression>
    </formulas>
    <interviewLabel>Account_Button_UpdateHierarchy_RecordType,Type,SupportRep {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_Button_UpdateHierarchy_RecordType,Type,SupportRep</label>
    <loops>
        <name>Loop_Accounts_in_Hierarchy</name>
        <label>Loop Accounts in Hierarchy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Account_Hierarchy_Children</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Record_Type_Type_and_Support_Rep</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Accounts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all Accounts below the current one (top parent account) in the account hierarchy</description>
        <name>Get_Account_Hierarchy_Children</name>
        <label>Get Account Hierarchy Children</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Account_Have_Children</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Top_Parent_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TopParentAcccount.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>TopParentAcccount.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
        <queriedFields>BypassAccountValidation__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the Top Parent Account in the triggering Account&apos;s hierarchy</description>
        <name>Get_Top_Parent_Account</name>
        <label>Get Top Parent Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Account_Hierarchy_Children</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Triggering_Account.Top_Parent_Account_Id__c</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>TopParentAcccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Get the Account the button was clicked on</description>
        <name>Get_Triggering_Account</name>
        <label>Get Triggering Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Account_Top_Parent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Support_Rep__c</queriedFields>
        <queriedFields>Top_Parent_Account_Id__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the Accounts from the hierarchy that have been assigned new record type, type and support rep.</description>
        <name>Update_Accounts</name>
        <label>Update Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Failing_Component</targetReference>
        </faultConnector>
        <inputReference>AccountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Triggering_Account</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Fault_Path_Subflow</name>
        <label>Run Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SBFL_FaultPath</flowName>
        <inputAssignments>
            <name>FailingFlowComponent</name>
            <value>
                <elementReference>FailingFlowComponent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>FaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TriggeringRecord</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>AccountsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>FailingFlowComponent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Stores the record that the flow is started from via button</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>TopParentAcccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
