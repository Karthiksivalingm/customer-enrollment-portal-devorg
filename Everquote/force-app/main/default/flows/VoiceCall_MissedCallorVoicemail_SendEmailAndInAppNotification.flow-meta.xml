            </connector>
            <label>Call Recipient Found</label>
        </rules>
    </decisions>
    <description>When a Voice Call is set to status &quot;completed&quot; and Accepted is null, or if the call&apos;s origin is &quot;Voicemail&quot;, get the user the call was to and send them and in-app notification and email notifying them that they missed a call.  If the call wasn&apos;t accepted, check &quot;Missed Call&quot;.

S3P-1134 - Created. Replaced missed_call_alert and Voicemail_alerts flows.</description>
    <environments>Default</environments>
    <formulas>
        <name>areaCodeFromNumber</name>
        <dataType>String</dataType>
        <expression>MID({!$Record.FromPhoneNumber}, 3, 3)</expression>
    </formulas>
    <formulas>
        <name>Formula_CallerCompany</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Contact__c})), {!$Record.Account__r.Name},
IF(NOT(ISBLANK({!$Record.Lead__c})), {!$Record.Lead__r.Company},
&apos;Unknown&apos;
))</expression>
    </formulas>
    <formulas>
        <name>Formula_CallerName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Contact__c})), {!$Record.Contact__r.FirstName} &amp; &apos; &apos; &amp;  {!$Record.Contact__r.LastName},
IF(NOT(ISBLANK({!$Record.Lead__c})), {!$Record.Lead__r.FirstName} &amp; &apos; &apos; &amp;  {!$Record.Lead__r.LastName},
{!$Record.FromPhoneNumber}
))</expression>
    </formulas>
    <formulas>
        <name>Formula_Link_Caller</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Contact__c})),{!Formula_SalesforceDomain} &amp; {!$Record.Contact__c},
IF(NOT(ISBLANK({!$Record.Lead__c})),{!Formula_SalesforceDomain} &amp; {!$Record.Lead__c},
null))</expression>
    </formulas>
    <formulas>
        <name>Formula_Link_CallerCompany</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Contact__c})),{!Formula_SalesforceDomain} &amp; {!$Record.Account__c},
IF(NOT(ISBLANK({!$Record.Lead__c})),{!Formula_SalesforceDomain} &amp; {!$Record.Lead__c},
null))</expression>
    </formulas>
    <formulas>
        <name>Formula_Link_VoiceCall</name>
        <dataType>String</dataType>
        <expression>{!Formula_SalesforceDomain} &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <description>Saves the name of the user the notification is being sent to and the time the flow ran.</description>
        <name>Formula_MissedCallAlertSent_UserAndTime</name>
        <dataType>String</dataType>
        <expression>&apos;Sent to: &apos; &amp; {!Get_Call_Recipient_User.Name} &amp; &apos; Date: &apos; &amp; TEXT({!$Flow.CurrentDate})</expression>
    </formulas>
    <formulas>
        <name>Formula_SalesforceDomain</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_630}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_630}))</expression>
    </formulas>
