    <decisions>
        <description>Calls with the origin &quot;Voicemail&quot; can actually be accepted by a user in certain scenarios (call back, &quot;press to leave a voicemail&quot;, voicemail recording process at the exact millisecond the agent clicked &quot;Accept.&quot;). If a call with Origin Voicemail was accepted, we don&apos;t want to mark it as a missed call.</description>
        <name>Is_Call_Accepted</name>
        <label>Is Call Accepted?</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Call_Recipient_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Accepted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CallAcceptDateTime</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_Missed_Call_checkbox_on_triggering_Voice_Call</targetReference>
            </connector>
            <label>Not Accepted</label>
        </rules>
    </decisions>
    <decisions>
