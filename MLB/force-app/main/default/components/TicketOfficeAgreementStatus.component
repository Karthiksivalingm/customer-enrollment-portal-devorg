<apex:component controller="TicketOfficeAgreementStatusCtrl" access="global">
    <apex:attribute name="oppId" type="Id" access="global" assignTo="{!opportunityId}" description="Opportunity whose latest Adobe Sign agreement status is shown"/>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{!statusTint};border-radius:12px;">
        <tr>
            <td width="56" valign="middle" style="padding:16px 0 16px 18px;">
                <div style="width:38px;height:38px;line-height:38px;border-radius:19px;background:{!statusColor};color:#FFFFFF;font-family:'Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;text-align:center;"><apex:outputText value="{!statusIcon}" escape="false"/></div>
            </td>
            <td valign="middle" style="padding:16px 12px;font-family:'Segoe UI',Helvetica,Arial,sans-serif;">
                <div style="font-size:11px;font-weight:800;letter-spacing:1.4px;color:{!statusColor};">AGREEMENT UPDATE</div>
                <div style="padding-top:2px;font-size:17px;font-weight:800;color:#0B1F2E;">{!statusLabel}</div>
                <div style="padding-top:2px;font-size:13px;color:#33495A;">{!statusNote}</div>
            </td>
            <td valign="middle" align="right" style="padding:16px 18px;font-family:'Segoe UI',Helvetica,Arial,sans-serif;font-size:11px;color:#6A8494;white-space:nowrap;">
                Adobe Sign<br/><b style="color:#0B1F2E;font-size:12px;">{!adobeStatus}</b>
            </td>
        </tr>
    </table>
</apex:component>
