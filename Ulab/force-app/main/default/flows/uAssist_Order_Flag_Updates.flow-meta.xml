                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_to_false</targetReference>
            </connector>
            <label>Admin</label>
        </rules>
        <rules>
            <name>Status_Ischanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.uAssist_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
