    <rules>
        <fullName>Auto Name Internal uLab Order</fullName>
        <actions>
            <name>Update_Order_Number</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>uLab_Order__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Internal uLab Order</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Notify uAssistant when On-Hold is released</fullName>
        <actions>
            <name>Notify_uAssistant_when_On_Hold_Order_is_Released</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>Notifies the assigned uAssistant when customer changes uAssist Status from &apos;On Hold&apos;.</description>
        <formula>AND(
   RecordType.Name = &quot;uAssist Order&quot;, 
   ISCHANGED(uAssist_Status__c),
   ISPICKVAL(uAssist_Status__c, &quot;In Progress&quot;),
   OR (
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - New photos Needed&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - Rx Form needs review&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - New scans needed&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - New X-Rays needed&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - New scans, photographs and X-Rays needed&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - Scans and images do not match&quot;),
    ISPICKVAL(PRIORVALUE(uAssist_Status__c),&quot;On Hold - Please review uAssist Message&quot;)
 ) 
)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Modification Requested Counter when uAssist Status change</fullName>
        <actions>
            <name>Erase_uA_Mod_Cmplete_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Modification_Requested_Counter</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>uLab_Order__c.uAssist_Status__c</field>
            <operation>equals</operation>
            <value>Modification Requested</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Order status changed value</fullName>
        <actions>
            <name>Update_Order_status_changed_flag</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(NOT(ISNULL(Ship_Date__c)), TEXT(Order_Status__c) &lt;&gt; &apos;Shipped&apos;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
