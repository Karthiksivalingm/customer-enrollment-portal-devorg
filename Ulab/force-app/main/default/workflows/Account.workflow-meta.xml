        <criteriaItems>
            <field>Account.Software_Expiration_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Uncheck converted flag</fullName>
        <active>true</active>
        <criteriaItems>
