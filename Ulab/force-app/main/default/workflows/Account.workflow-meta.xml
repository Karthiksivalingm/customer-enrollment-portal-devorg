    <rules>
        <fullName>Check flag for Billing Address Change</fullName>
        <actions>
            <name>Billing_Address_Change</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>OR(ISCHANGED(BillingAddress), 
AND(ISNEW(),  NOT(ISNULL(BillingAddress))))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Check flag for Shipping Address Change</fullName>
        <actions>
            <name>Shipping_Address_Change</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>OR(ISCHANGED(ShippingAddress ), 
AND(ISNEW(),  NOT(ISNULL(ShippingAddress ))))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Company Email is Entered</fullName>
        <actions>
            <name>Lock_Company_Email</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Account_Email__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Date Acct Added in Portal</fullName>
        <actions>
            <name>Fill_Portal_Added_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.uLab_Acct_Number__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Date_Added_to_Portal__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Ortho Investor</fullName>
        <actions>
            <name>Update_Ortho_Investor_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Ortho_Investor__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Ortho_Investor_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>When Ortho Investor is checked, add the date to the account.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
