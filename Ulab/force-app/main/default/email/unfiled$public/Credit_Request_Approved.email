<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello&nbsp;{!Credit_Request__c.OwnerFirstName},&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><span style="font-size: 12pt;">The credit request you submitted for&nbsp;</span></font><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Credit_Request__c.Company_Name__c} (uLab Acct #&nbsp;</span><font face="arial">{!Credit_Request__c.uLab_Acct_Number__c}<span style="font-size: 12pt;">) </span></font><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">has been <b>approved</b>.&nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><br></span></div><div style=""><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Amount Requested:&nbsp;</span><font face="arial">{!Credit_Request__c.Credit_Request_Amount__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Amount Approved:&nbsp;{!Credit_Request__c.Approved_Amount__c}</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">A&nbsp; l</span><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">ink to the Credit Request can be found here:&nbsp;&nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;"><font face="arial">{!Credit_Request__c.Link}</font></div><div style="font-size: 12pt;"><br></div><div style="font-size: 12pt;">Thanks</div></div>]]></td>
