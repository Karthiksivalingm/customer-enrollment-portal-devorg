<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello,</font><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><span style="font-size: 12pt;">A&nbsp;</span>Credit<span style="font-size: 12pt;">&nbsp;request has been submitted and <b>your&nbsp;approval&nbsp;is necessary</b>.&nbsp;&nbsp;</span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Details of the request can be found below, or you can follow this link:&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Credit_Request__c.Link}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Account Name:&nbsp;&nbsp;{!Credit_Request__c.Company_Name__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">uLab Acct Number:&nbsp;{!Credit_Request__c.uLab_Acct_Number__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Customer Country:&nbsp;{!Credit_Request__c.Customer_Country__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style=""><br></div></div><div style=""><div style=""><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Total Amount Requested:&nbsp;</span><font face="arial">{!Credit_Request__c.Credit_Request_Amount__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="font-size: 12pt;">Reason Code:&nbsp;</font><font face="arial" style="font-size: 12pt;">{!Credit_Request__c.Reason_Code__c}</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;"><br></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Product Type:&nbsp;{!Credit_Request__c.Product_Type__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Order Number:&nbsp;{!Credit_Request__c.Order_Number__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Additional Notes:&nbsp;{!Credit_Request__c.Additional_Notes__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Client Services</div></div></div></div>]]></td>
</tr>
