<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Shipping_Country_2_Character</fullName>
    <active>true</active>
    <errorConditionFormula>NOT( ISBLANK( ShippingStreet ) ) &amp;&amp; LEN (ShippingCountry) != 2</errorConditionFormula>
    <errorDisplayField>ShippingCountry</errorDisplayField>
    <errorMessage>Shipping Country fields must be 2 characters long.</errorMessage>
</ValidationRule>
