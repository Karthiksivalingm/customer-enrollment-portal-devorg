<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Currently_Printing_Retainers_Required</fullName>
    <active>true</active>
    <description>Required field on status close</description>
    <errorConditionFormula>AND(Text(Status__c) = &apos;Close&apos; , ISPICKVAL( Currently_Printing_Retainers__c ,&quot;&quot;) )</errorConditionFormula>
    <errorDisplayField>Currently_Printing_Retainers__c</errorDisplayField>
    <errorMessage>Please fill in the required field.</errorMessage>
</ValidationRule>
