<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Traditional_Aligner_Company_Required</fullName>
    <active>true</active>
    <description>Required field on status close</description>
    <errorConditionFormula>AND(Text(Status__c) = &apos;Close&apos; ,   ISBLANK(  Traditional_Aligner_Company__c  ))</errorConditionFormula>
    <errorDisplayField>Traditional_Aligner_Company__c</errorDisplayField>
    <errorMessage>Please fill in the required field.</errorMessage>
</ValidationRule>
