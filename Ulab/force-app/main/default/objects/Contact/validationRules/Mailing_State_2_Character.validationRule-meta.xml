<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mailing_State_2_Character</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
OR(MailingCountry == &apos;US&apos;, MailingCountry == &apos;CA&apos;),
LEN (MailingState) != 2
)</errorConditionFormula>
    <errorDisplayField>MailingState</errorDisplayField>
    <errorMessage>Mailing State fields must be 2 characters long.</errorMessage>
</ValidationRule>
