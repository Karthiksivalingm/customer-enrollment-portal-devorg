<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_date_cannot_exceed_12_months</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNULL( Agreement_End_Date__c )), ROUND((Agreement_End_Date__c -  Agreement_Effective_Date__c ) / 30.41, 2) &gt; 12)</errorConditionFormula>
    <errorDisplayField>Agreement_End_Date__c</errorDisplayField>
    <errorMessage>End date cannot exceed 12 months</errorMessage>
</ValidationRule>
