<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Treatment_time__c</fullName>
    <description>Gives total treatment time = Actual In Progress time+ time in Model Prep In Progree +Time in Modification requested.</description>
    <externalId>false</externalId>
    <formula>Total_Hours_Actual_In_In_Progress__c +  Total_Hours_In_Model_Prep_in_Progress__c +  Total_Hours_In_Modification_Requested__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Treatment time</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
