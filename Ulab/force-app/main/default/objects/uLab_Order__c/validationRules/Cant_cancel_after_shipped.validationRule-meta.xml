<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cant_cancel_after_shipped</fullName>
    <active>true</active>
    <description>Cannot cancel a shipped order.</description>
    <errorConditionFormula>AND(
ISPICKVAL(Order_Status__c, &quot;Cancelled&quot;),
ISPICKVAL(PRIORVALUE(Order_Status__c), &quot;Shipped&quot;)
)</errorConditionFormula>
    <errorDisplayField>Order_Status__c</errorDisplayField>
    <errorMessage>Cannot cancel a shipped order.</errorMessage>
</ValidationRule>
