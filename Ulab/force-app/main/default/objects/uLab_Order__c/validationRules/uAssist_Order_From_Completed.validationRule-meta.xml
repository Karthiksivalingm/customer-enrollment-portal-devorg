<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>uAssist_Order_From_Completed</fullName>
    <active>true</active>
    <description>Only the API user can move a uAssist order from &apos;Completed&apos;</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Cloud_uAssist_Order&quot;,
    NOT($Permission.Bypass_uAssist_Status_Validation),
    $UserRole.Name &lt;&gt; &apos;System Administrator&apos;,
    ISPICKVAL(PRIORVALUE(uAssist_Status__c), &quot;Completed&quot;)
)</errorConditionFormula>
    <errorDisplayField>uAssist_Status__c</errorDisplayField>
    <errorMessage>You cannot change the uAssist status once it has been moved to &apos;Completed&apos;.</errorMessage>
</ValidationRule>
