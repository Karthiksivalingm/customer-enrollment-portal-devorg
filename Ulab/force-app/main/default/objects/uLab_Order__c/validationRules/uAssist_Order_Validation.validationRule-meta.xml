<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>uAssist_Order_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Cloud_uAssist_Order&quot;,
    NOT($Permission.Bypass_uAssist_Status_Validation),
    NOT(ISBLANK(Billing_System_Inv_Number__c)),
    ISPICKVAL(uAssist_Status__c, &quot;Rejected&quot;)
)</errorConditionFormula>
    <errorDisplayField>uAssist_Status__c</errorDisplayField>
    <errorMessage>This uAssist Order has been invoiced, the Status cannot be changed to Rejected.</errorMessage>
</ValidationRule>
