<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Plan_1</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    $RecordType.DeveloperName = &quot;Cloud_uAssist_Order&quot;,
    ISPICKVAL(Number_of_Plans__c, &quot;1&quot;),
    ISBLANK(Plan_1__c)
)</errorConditionFormula>
    <errorDisplayField>Number_of_Plans__c</errorDisplayField>
    <errorMessage>Plan 1 is required when # of Plans is 1</errorMessage>
</ValidationRule>
