<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>uAssist_status_must_remain_Rejected</fullName>
    <active>true</active>
    <description>Once a uAssist order has been set to &apos;Rejected&apos; in SFDC, the user cannot change the status.</description>
    <errorConditionFormula>AND(
    NOT($Permission.Bypass_uAssist_Status_Validation),
    NOT(ISPICKVAL(uAssist_Status__c, &apos;Rejected&apos;)),
    NOT(ISBLANK(Date_entered_Rejected_Status__c)), 
    $UserRole.Name &lt;&gt; &apos;System Administrator&apos;
)</errorConditionFormula>
    <errorDisplayField>uAssist_Status__c</errorDisplayField>
    <errorMessage>You cannot change the uAssist Status because this order has already been rejected.</errorMessage>
</ValidationRule>
