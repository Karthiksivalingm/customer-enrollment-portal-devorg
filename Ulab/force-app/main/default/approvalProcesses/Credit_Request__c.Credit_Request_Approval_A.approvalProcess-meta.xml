<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Client_Services_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Client_Services_Representative</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Credit_Memo__c</field>
        <field>Credit_Request_Amount__c</field>
        <field>Denial_Reason__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Aprroved_Email</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_status_to_approved1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>meshakm@@ulabsystems.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>ASD Approval</label>
        <name>ASD_Approval</name>
        <rejectionActions>
            <action>
                <name>Approval_Denied_Email</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Denial_Email_Sent_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Denial_Reason</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_status_to_deny</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>unfiled$public/Credit_Request_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Credit_Request__c.RecordType</field>
            <operation>equals</operation>
            <value>Customer Adjustment</value>
        </criteriaItems>
        <criteriaItems>
            <field>Credit_Request__c.Credit_Request_Amount__c</field>
            <operation>greaterThan</operation>
            <value>USD 250</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>CR_Email</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Field_Update</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Credit Request Approval A</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
