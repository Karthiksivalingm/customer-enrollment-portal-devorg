    </customProperties>
    <decisions>
        <name>Existing_or_New</name>
        <label>Existing or New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Validate_Selected_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Existing_Batch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BatchOptionChoice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ExistingBatch</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Draft_Batches</targetReference>
            </connector>
            <label>Existing Batch</label>
        </rules>
        <rules>
            <name>New_Batch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BatchOptionChoice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NewBatch</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Batch</targetReference>
            </connector>
            <label>New Batch</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Record_Valid</name>
        <label>Is Record Valid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_to_Excluded_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Validate_Selected_Records.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reconciled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Validate_Selected_Records.Payment_Batch__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Validate_Selected_Records.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Disputed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Valid_Records</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
