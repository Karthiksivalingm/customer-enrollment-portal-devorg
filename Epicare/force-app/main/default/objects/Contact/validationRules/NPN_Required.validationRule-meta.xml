<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NPN_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(Bypass_VR__c),
ISBLANK(NPN__c)
)</errorConditionFormula>
    <errorDisplayField>NPN__c</errorDisplayField>
    <errorMessage>NPN is required for all agents</errorMessage>
</ValidationRule>
