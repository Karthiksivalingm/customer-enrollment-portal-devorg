<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Change_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
OR(
ISPICKVAL(Agent_Status__c, &quot;Terminated&quot;),
ISPICKVAL(Agent_Status__c, &quot;Suspended&quot;)
),
ISBLANK(Description)
)</errorConditionFormula>
    <errorDisplayField>Description</errorDisplayField>
    <errorMessage>A reason is required when deactivating an agent.</errorMessage>
</ValidationRule>
