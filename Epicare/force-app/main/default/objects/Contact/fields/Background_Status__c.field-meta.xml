<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Background_Status__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    OR(
        ISPICKVAL(Background_Check_Status__c,&quot;Passed&quot;),
        ISPICKVAL(Background_Check_Status__c,&quot;Not Required&quot;)
    ),
    IMAGE(&apos;https://epicareinsurance--utdev--c.sandbox.vf.force.com/resource/Green_Flag&apos;,&apos;Green&apos;,20,20),
    IF(
        ISPICKVAL(Background_Check_Status__c,&quot;Pending&quot;),
        IMAGE(&apos;https://epicareinsurance--utdev--c.sandbox.vf.force.com/resource/Yellow_Flag&apos;,&apos;Yellow&apos;,20,20),
        IMAGE(&apos;https://epicareinsurance--utdev--c.sandbox.vf.force.com/resource/Red_Flag&apos;,&apos;Red&apos;,20,20)
    )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Background Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
