<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Year_To_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Year_To__c)),
    Year_To__c &lt; Year_From__c
)</errorConditionFormula>
    <errorDisplayField>Year_To__c</errorDisplayField>
    <errorMessage>Year To must be greater than or equal to Year From, or left blank for open-ended.</errorMessage>
</ValidationRule>
