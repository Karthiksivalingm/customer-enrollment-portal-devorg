<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verified_Requires_Agreement</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISCHANGED(Status__c),
  ISPICKVAL(Status__c, &quot;Verified&quot;),
  ISBLANK(Agreement__c)
)</errorConditionFormula>
    <errorDisplayField>Agreement__c</errorDisplayField>
    <errorMessage>Agreement is required before a Referral Record can be marked Verified.</errorMessage>
</ValidationRule>
