<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Green_Onboarding_Semaphore</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISPICKVAL(Status__c, &quot;Request&quot;)),
    Agent__r.Overall_Semaphore__c &lt;&gt; &quot;Green&quot;,
    NOT(Agent__r.Bypass_VR__c)
)</errorConditionFormula>
    <errorMessage>The appointment cannot advance beyond &quot;Requested&quot; until the agent&apos;s onboarding semaphore is Green.</errorMessage>
</ValidationRule>
