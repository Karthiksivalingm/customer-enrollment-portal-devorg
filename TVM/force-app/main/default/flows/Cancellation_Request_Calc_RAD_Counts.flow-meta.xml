                    <elementReference>OldRADID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Old_RAD_Count</targetReference>
            </connector>
            <label>MB Uses Old RAD</label>
        </rules>
    </decisions>
