<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Stalled</name>
        <label>Assign Stalled</label>
        <locationX>270</locationX>
        <locationY>552</locationY>
        <assignmentItems>
            <assignToReference>$Record.Stall_DateTime__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Terminate_Flow__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Assigned</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Dev_Hours</name>
        <label>Update Dev Hours</label>
        <locationX>138</locationX>
        <locationY>768</locationY>
        <assignmentItems>
            <assignToReference>CurrDevHoldHours</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Dev_Hold_Hours__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CurrDevHoldHours</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Calculate_Dev_Hold_Hours__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Latest_Sent_to_Dev_Tracking_Only__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Dev_Hold_Hours__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CurrDevHoldHours</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Terminate_Flow__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Master_Update</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_the_Case_Stalled</name>
        <label>Is the Case Stalled?</label>
        <locationX>270</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Internal_Feedback_Needed_Stall</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HoursSinceStatusChanged</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status_Filtered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Needs Information</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_NI_Email</targetReference>
            </connector>
            <label>Internal Feedback Needed Stall</label>
        </rules>
        <rules>
            <name>Yes_Stalled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Stalled_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Stalled</targetReference>
            </connector>
            <label>Yes, Stalled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Assigned</name>
        <label>Update Assigned</label>
        <locationX>270</locationX>
        <locationY>660</locationY>
        <defaultConnector>
            <targetReference>Master_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Dev_Hours_Unresolved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Latest_Sent_to_Dev_Tracking_Only__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Dev_Hours</targetReference>
            </connector>
            <label>Dev Hours Unresolved</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>HoursSinceStatusChanged</name>
        <dataType>Number</dataType>
        <expression>({!$Flow.CurrentDateTime} - {!$Record.LastModifiedDate})*24</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>StalledRecipients</name>
        <dataType>String</dataType>
        <expression>if({!$Record.Regional_Account_Director_Email__c}=&quot;&quot;, &quot;&quot;, {!$Record.Regional_Account_Director_Email__c}&amp;&quot;,&quot;)&amp;
if({!$Record.Account_Manager_Email__c}=&quot;&quot;, &quot;&quot;, {!$Record.Account_Manager_Email__c}&amp;&quot;,&quot;)&amp;
If({!$Record.Case_Category_Text__c} = &quot;Digital_Support&quot;, if(isBlank({!$Record.Account.Digital_SME__r.Email}), &quot;&quot;, {!$Record.Account.Digital_SME__r.Email}&amp;&quot;,&quot;),&quot;&quot;)&amp;
if({!$Record.Notify_Me__r.Email}=&quot;&quot;, &quot;&quot;,{!$Record.Notify_Me__r.Email}&amp;&quot;,&quot;)&amp;
if({!$Record.Alerted_User_2__r.Email}=&quot;&quot;, &quot;&quot;,{!$Record.Alerted_User_2__r.Email}&amp;&quot;,&quot;)</expression>
    </formulas>
    <interviewLabel>Case - Nightly Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Nightly Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Master_Update</name>
        <label>Master Update</label>
        <locationX>270</locationX>
        <locationY>960</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>144</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_the_Case_Stalled</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Foundation_Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2024-09-11</startDate>
            <startTime>01:02:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Send_NI_Email</name>
        <label>Send NI Email</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Assign_Stalled</targetReference>
        </connector>
        <flowName>TVM_Master_Notification_Deployment</flowName>
        <inputAssignments>
            <name>E1_EmailRecipient</name>
            <value>
                <elementReference>StalledRecipients</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>E3_EmailSubjectLine</name>
            <value>
                <elementReference>NeedsInfoSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>E4_EmailBody</name>
            <value>
                <elementReference>StalledNeedsInfoBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>E5_SupportFromAddress</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>E_NeedEmail</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>P_NeedPush</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordID</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>NeedsInfoSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Account.Name} Case {!$Record.CaseNumber} Is Stalled and Needs Information to Continue</text>
    </textTemplates>
    <textTemplates>
        <name>StalledNeedsInfoBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Support Case &lt;a href=&quot;https://teamvelocity.lightning.force.com/lightning/r/Case/{!$Record.Id}/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;{!$Record.CaseNumber} &lt;/a&gt;is stalled and &lt;u&gt;needs information&lt;/u&gt;, likely &lt;u&gt;from the Account Manager or RAD&lt;/u&gt;. Please don&apos;t forget this case. See below for details:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Subject&lt;/strong&gt;: {!$Record.Subject}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Category&lt;/strong&gt;: {!$Record.Case_Category__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Subcategory&lt;/strong&gt;: {!$Record.Case_Subcategory__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Request&lt;/strong&gt;: {!$Record.Case_Request__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Status&lt;/strong&gt;: {!$Record.Status_Filtered__c}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>CurrDevHoldHours</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>TestNumber1</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
