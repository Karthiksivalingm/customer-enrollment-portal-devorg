    <decisions>
        <name>Any_Records_Found</name>
        <label>Any Records Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>AllComp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Records_Found_Abort_Mission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetCompliance</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Records Found, Abort Mission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Type</name>
        <label>Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>AllComp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Website</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AllComp.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Website</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_08</targetReference>
            </connector>
            <label>Website (Reactivated)</label>
        </rules>
        <rules>
            <name>Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AllComp.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email Blast</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Push_Back_For_Changes</targetReference>
            </connector>
            <label>Email</label>
        </rules>
        <rules>
            <name>Web_Banner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AllComp.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web Banner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Push_Back_For_Changes</targetReference>
            </connector>
            <label>Web Banner</label>
        </rules>
    </decisions>
    <environments>Default</environments>
