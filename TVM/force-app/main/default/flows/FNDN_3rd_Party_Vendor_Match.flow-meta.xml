<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_new_Vendor</name>
        <label>Add new Vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AV3P_Create.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.Vendor__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Vendor_3rd_Party.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.Deactivated__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Vendor_3rd_Party.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.CreatedDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.X3rd_Party_Vendor_Category__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Website Provider</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AV3P_Create.x3rd_Party_Vendor_URL__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Domainname</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_new_active_vendor</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Current_3rd_Party_Relationship_Found</name>
        <label>Current 3rd Party Relationship Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Vendor.Matching_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>fMatchingname</elementReference>
                </rightValue>
            </conditions>
            <label>Yes, Matches</label>
        </rules>
        <rules>
            <name>Yes_Needs_to_Change</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Vendor.Matching_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>fMatchingname</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Current_Vendor</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Retire_Old_Vendor</targetReference>
            </connector>
            <label>Yes, Needs to Change</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Run</name>
        <label>Should Run?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Evaluate_Vendor</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FNDN_Website_Provider__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FNDN_Website_Provider__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TVM_Website_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Vendor</targetReference>
            </connector>
            <label>Yes - Evaluate Vendor</label>
        </rules>
    </decisions>
    <decisions>
        <name>Vendor_Found</name>
        <label>Vendor Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_get_vendor_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Vendor_3rd_Party.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_new_Vendor</targetReference>
            </connector>
            <label>Yes, get vendor ID</label>
        </rules>
    </decisions>
    <description>Automatically assigns an active 3rd-party vendor to Accounts based on domain matching. Supports admin-created vendors by dynamically selecting the active Primary vendor without requiring flow updates.</description>
    <environments>Default</environments>
    <formulas>
        <name>fMatchingname</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER({!fx_Calcvendorname}), &quot; &quot;, &quot;&quot;),&quot;.&quot;, &quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;&amp;&quot;, &quot;&quot;),&quot;#&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_Calcvendorname</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.TVM_Website_Status__c})  &lt;&gt; &quot;Primary&quot;,  {!$Record.FNDN_Website_Provider__c}, &quot;Team Velocity&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_Domainname</name>
        <dataType>String</dataType>
        <expression>if(
TEXT({!$Record.TVM_Website_Status__c}) = &quot;Primary&quot;, {!$Record.Apollo_Website_URL__c}, {!$Record.X3rd_Party_Website_Domain__c})</expression>
    </formulas>
    <interviewLabel>FNDN 3rd Party Vendor -Match {!$Flow.CurrentDateTime}</interviewLabel>
    <label>3rd Party Vendor -Match</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_new_active_vendor</name>
        <label>Create new active vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>AV3P_Create</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Vendor</name>
        <label>Get Current Vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Current_3rd_Party_Relationship_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Deactivated__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>X3rd_Party_Vendor_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Website Provider</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account_Vendor__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Vendor_3rd_Party</name>
        <label>Get Vendor (3rd Party)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Vendor_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Matching_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fMatchingname</elementReference>
            </value>
        </filters>
        <filters>
            <field>Deactivated__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vendor__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Retire_Old_Vendor</name>
        <label>Retire, Old Vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Vendor_3rd_Party</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Vendor.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Deactivated_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Deactivated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account_Vendor__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Should_Run</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>AV3P_Create</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_Vendor__c</objectType>
    </variables>
</Flow>
