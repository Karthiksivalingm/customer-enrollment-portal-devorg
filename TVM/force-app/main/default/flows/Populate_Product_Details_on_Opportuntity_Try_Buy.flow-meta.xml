    <formulas>
        <name>OtherTotalPricePerMonth_Display</name>
        <dataType>Number</dataType>
        <expression>IF(
{!OtherTotalPricePerMonth} = 0.00,
null,
{!OtherTotalPricePerMonth})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ProductList</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!OrderConfirmationList}, &quot;&lt;br/&gt;&quot;, &quot; | &quot;)</expression>
    </formulas>
    <formulas>
        <name>ProductListClean</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!OrderConfirmationList}, &quot;&lt;br/&gt;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>RetentionTotalPricePerMonth_Display</name>
        <dataType>Number</dataType>
        <expression>IF(
{!RetentionTotalPricePerMonth} = 0.00,
null,
{!RetentionTotalPricePerMonth})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ServicesAgreementDiscountPrice_Display</name>
        <dataType>Number</dataType>
        <expression>IF(
OR(
{!WebsitesTotalPricePerMonth} &gt; 0,
{!RetentionTotalPricePerMonth} &gt; 0,
{!AdvertisingTotalPricePerMonth} &gt; 0,
{!OtherTotalPricePerMonth} &gt; 0),
null,
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TryBuyWithSales</name>
        <dataType>Number</dataType>
        <expression>{!TotalSalesPrice}+{!TryBuyFinal}</expression>
        <scale>2</scale>
    </formulas>
