{!GetUpdatedOpp.DS_Transact__c}, &quot;Category Website;&quot;, null) &amp;

if(
{!GetUpdatedOpp.DS_SEO__c}, &quot;Category SEO;&quot;, null) &amp;

if(
{!GetUpdatedOpp.DS_Apollo_Sales__c}, &quot;Category Sales Retention;&quot;, null) &amp;

if(
{!GetUpdatedOpp.DS_Smart_Communications__c} ||
{!GetUpdatedOpp.DS_Direct_Mail__c}, &quot;Category Sales Mail;&quot;, null) &amp;

if(
{!GetUpdatedOpp.DS_Apollo_Service__c}, &quot;Category Service Retention;&quot;, null) &amp;

if(
