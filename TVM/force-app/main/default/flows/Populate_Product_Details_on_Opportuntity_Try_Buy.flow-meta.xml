CONTAINS({!AddendumDefault}, &quot;*The products included in the Try &amp; Buy Promotion will be delivered at No Charge for 60 Days from date of Onboard.  If you do not Opt Out, billing for these products will be added to your invoice.&quot;), 

&quot;&quot;, 

&quot;*The products included in the Try &amp; Buy Promotion will be delivered at No Charge for 60 Days from date of Onboard.  If you do not Opt Out, billing for these products will be added to your invoice.&quot;
)</expression>
    </formulas>
