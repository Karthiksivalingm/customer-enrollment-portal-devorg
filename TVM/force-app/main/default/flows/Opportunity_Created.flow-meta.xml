    <formulas>
        <name>FDRecordType</name>
        <dataType>String</dataType>
        <expression>if(Text({!$Record.Account.Analytics_Franchise__c})!=&quot;FORD&quot; &amp;&amp; Text({!$Record.Account.Analytics_Franchise__c})!=&quot;LINCOLN&quot;, {!$Record.RecordTypeId},
if({!$Record.Account.Pending_Activation__c} || Text({!$Record.Account.Client_Type_Team_V__c})=&quot;Active&quot;, &quot;0125f000000Ri1aAAC&quot;,
if(Text({!$Record.Account.Client_Type_Team_V__c})=&quot;Prospect&quot;, &quot;0125f000000Ri2YAAS&quot;,
if(Text({!$Record.Account.Client_Type_Team_V__c})=&quot;Inactive&quot;, &quot;0125f000000Ri1fAAC&quot;,
{!$Record.RecordTypeId}
))))</expression>
