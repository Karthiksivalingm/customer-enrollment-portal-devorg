ISPICKVAL({!$Record.Account.Analytics_Franchise__c},&quot;MINI&quot;),
&quot;BMW&quot;,
IF(
ISPICKVAL({!$Record.Account.Analytics_Franchise__c},&quot;GENESIS&quot;),
&quot;Genesis&quot;,
IF(
ISPICKVAL({!$Record.Account.Analytics_Franchise__c},&quot;KIA&quot;) ||
ISPICKVAL({!$Record.Account.Analytics_Franchise__c},&quot;FERRARI&quot;) ||
ISPICKVAL({!$Record.Account.Analytics_Franchise__c},&quot;MASERATI&quot;) ||
