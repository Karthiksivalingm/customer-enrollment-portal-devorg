    <formulas>
        <name>DigitalProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Latest_Won_Opp.Count_Advid_New_Products__c}&gt; 0, &quot;D-Advid New;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Advid_Pre_Owned_Products__c} &gt; 0, &quot;D-Advid Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Apollo_Ads_Service_Products__c} &gt; 0, &quot;D-Apollo Ads (Service);&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Apollo_Ads_Products__c} &gt; 0, &quot;D-Apollo Ads;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Display_New_Products__c}&gt; 0, &quot;D-Display New;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Display_Pre_Owned_Products__c}&gt; 0, &quot;D-Display Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Display_Service_Products__c}&gt; 0, &quot;D-Display Service;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_OTT_Premium_Custom__c}&gt; 0, &quot;D-OTT Premium Custom;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Search_New_Products__c}&gt; 0, &quot;D-Search New;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Search_Pre_Owned_Products__c} &gt; 0, &quot;D-Search Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Search_Service_Products__c}&gt; 0, &quot;D-Search Service;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Social_New_Products__c}&gt; 0, &quot;D-Social New;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Social_Pre_Owned_Products__c}&gt; 0, &quot;D-Social Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Social_Service_Products__c}&gt; 0, &quot;D-Social Service;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Streaming_OTT__c}&gt; 0, &quot;D-Streaming OTT Dynamic;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>LoopDigitalProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_1.Count_Advid_New_Products__c}&gt; 0, &quot;D-Advid New;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Advid_Pre_Owned_Products__c} &gt; 0, &quot;D-Advid Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Apollo_Ads_Service_Products__c} &gt; 0, &quot;D-Apollo Ads (Service);&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Apollo_Ads_Products__c} &gt; 0, &quot;D-Apollo Ads;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Display_New_Products__c}&gt; 0, &quot;D-Display New;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Display_Pre_Owned_Products__c}&gt; 0, &quot;D-Display Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Display_Service_Products__c}&gt; 0, &quot;D-Display Service;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_OTT_Premium_Custom__c}&gt; 0, &quot;D-OTT Premium Custom;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Search_New_Products__c}&gt; 0, &quot;D-Search New;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Search_Pre_Owned_Products__c} &gt; 0, &quot;D-Search Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Search_Service_Products__c}&gt; 0, &quot;D-Search Service;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Social_New_Products__c}&gt; 0, &quot;D-Social New;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Social_Pre_Owned_Products__c}&gt; 0, &quot;D-Social Pre-Owned;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Social_Service_Products__c}&gt; 0, &quot;D-Social Service;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Streaming_OTT__c}&gt; 0, &quot;D-Streaming OTT Dynamic;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>LoopRetentionProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_1.Count_Apollo_Sales_Products__c} &gt; 0, &quot;R-Apollo Sales;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Apollo_Service_Products__c} &gt; 0, &quot;R-Apollo Service;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>LoopWebsiteProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_1.Count_Apollo_Assistant__c} &gt; 0, &quot;W-Apollo Assistant;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Apollo_Sites_Products__c} &gt; 0, &quot;W-Apollo Sites;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Apollo_Transact_Products__c} &gt; 0, &quot;W-Apollo Transact;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Soft_Credit_Pull__c} &gt; 0, &quot;W-Credit PreQual;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Custom_Creative_Products__c} &gt; 0, &quot;W-Custom Creative;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_Group_Site__c}&gt; 0, &quot;W-Group Site;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_SEO_Products__c}&gt; 0, &quot;W-SEO;&quot;, &quot;&quot;) &amp;
IF({!Loop_1.Count_VDV__c}&gt; 0, &quot;W-VDV;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>RetentionProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Latest_Won_Opp.Count_Apollo_Sales_Products__c} &gt; 0  || {!Get_Latest_Won_Opp.FordDirect_Package__c} = &quot;Platform Solutions&quot;, &quot;R-Apollo Sales;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Apollo_Service_Products__c} &gt; 0  || {!Get_Latest_Won_Opp.FordDirect_Package__c} = &quot;Platform Solutions&quot;, &quot;R-Apollo Service;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>WebsiteProductsFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Latest_Won_Opp.Count_Apollo_Assistant__c} &gt; 0, &quot;W-Apollo Assistant;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Apollo_Sites_Products__c} &gt; 0 || {!Get_Latest_Won_Opp.FordDirect_Package__c} = &quot;Platform Solutions&quot;, &quot;W-Apollo Sites;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Apollo_Transact_Products__c} &gt; 0, &quot;W-Apollo Transact;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Soft_Credit_Pull__c} &gt; 0, &quot;W-Credit PreQual;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Custom_Creative_Products__c} &gt; 0, &quot;W-Custom Creative;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_Group_Site__c}&gt; 0, &quot;W-Group Site;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_SEO_Products__c}&gt; 0, &quot;W-SEO;&quot;, &quot;&quot;) &amp;
IF({!Get_Latest_Won_Opp.Count_VDV__c}&gt; 0, &quot;W-VDV;&quot;, &quot;&quot;)</expression>
    </formulas>
