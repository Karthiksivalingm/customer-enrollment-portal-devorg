            <connector>
                <targetReference>Update_Opportunity_Stage_to_Closed_Won_Subtract_1_from_the_Open_DocuSign_Envelop</targetReference>
            </connector>
            <label>Prospect or Inactive</label>
        </rules>
        <rules>
            <name>Foundation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>012Vb000007oHPpIAM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FNDN_Marked_Closed_Won</targetReference>
            </connector>
            <label>Foundation</label>
        </rules>
    </decisions>
