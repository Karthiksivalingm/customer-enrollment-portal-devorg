<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_for_account_is_active</name>
        <label>Check for account is active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_for_Hybrid_Prod</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_account_is_not_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_1_A1</targetReference>
            </connector>
            <label>If account is not active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Hybrid_Prod</name>
        <label>Check for Hybrid Prod</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Hybrid_Prod_and_Account_is_not_Hybrid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Hybrid_Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.FNDN_Billed_Through_TVM__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Hybrid</targetReference>
            </connector>
            <label>Hybrid Prod and Account is not Hybrid</label>
        </rules>
    </decisions>
    <description>FND - Migrated from the Activate Account on opportunity Live process using Check stage criteria.
Make active checkbox true on opportunity live/active</description>
    <environments>Default</environments>
    <interviewLabel>Activate Account on opportunity Live_1 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Activate Account on opportunity Live_1</label>
    <processMetadataValues>
