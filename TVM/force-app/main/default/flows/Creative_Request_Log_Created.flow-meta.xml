<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>AddDesignerScore</name>
        <dataType>Number</dataType>
        <expression>NulLValue({!$Record.Creative_Request_Link__r.Total_Designer_Score__c}, 0) + NullValue({!$Record.Designer_Score__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>AddDesignerTouches</name>
        <dataType>Number</dataType>
        <expression>NulLValue({!$Record.Creative_Request_Link__r.of_Designer_Touches__c}, 0) + if({!$Record.Designer_Score__c}&gt;0, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>AddProofingTouches</name>
        <dataType>Number</dataType>
        <expression>NulLValue({!$Record.Creative_Request_Link__r.of_Proofing_Touches__c}, 0)+
if({!$Record.Proofing_Change_Bucket__c}!=&quot;&quot;, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Creative Request Log Created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Creative Request Log Created</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Add_Touches</name>
        <label>Add Touches</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Total_Designer_Score__c</field>
            <value>
                <elementReference>AddDesignerScore</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>of_Designer_Touches__c</field>
            <value>
                <elementReference>AddDesignerTouches</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>of_Proofing_Touches__c</field>
            <value>
                <elementReference>AddProofingTouches</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Creative_Request_Link__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Created_Update_Last_Log</name>
        <label>Created Update Last Log</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Add_Touches</targetReference>
        </connector>
        <inputAssignments>
            <field>Last_Log__c</field>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Creative_Request_Link__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Created_Update_Last_Log</targetReference>
        </connector>
        <object>Creative_Request_Log__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
