    <formulas>
        <name>Attendees</name>
        <dataType>String</dataType>
        <expression>Left(
MID({!BodyTextWithBreaks}, 
FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})+10, 
FIND(&quot;-linebreak-&quot;, {!BodyTextWithBreaks}, FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks}))-FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})-10
)
, 254)</expression>
    </formulas>
    <formulas>
        <name>BodyTextCalculator</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.HtmlBody}, &quot;&lt;br /&gt;&quot;, &quot;-linebreak-&quot;)</expression>
    </formulas>
    <formulas>
        <name>Debug</name>
        <dataType>String</dataType>
        <expression>{!BodyTextWithBreaks}
&amp;&quot;-----------------------&quot;&amp;
Text(FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})+10)
&amp;&quot;-----------------------&quot;&amp;
Text(FIND(&quot;-linebreak-&quot;, {!BodyTextWithBreaks}, FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})+10))
&amp;&quot;-----------------------&quot;&amp;
Text(
FIND(&quot;-linebreak-&quot;, {!BodyTextWithBreaks}, FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})+10)-
FIND(&quot;Attendees:&quot;, {!BodyTextWithBreaks})+10
)</expression>
    </formulas>
    <formulas>
        <name>EmailTrigger</name>
        <dataType>String</dataType>
        <expression>if(Contains({!$Record.Subject}, &quot; Meeting Recap - &quot;) &amp;&amp; Contains({!$Record.Subject}, &quot;202&quot;), &quot;Recap&quot;,
if(Contains({!$Record.Subject}, &quot; Core Vitals - &quot;) &amp;&amp; Contains({!$Record.Subject}, &quot;202&quot;), &quot;Core&quot;,
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>MeetingDate</name>
        <dataType>String</dataType>
        <expression>Left(
MID({!$Record.TextBody},
FIND(&quot;Meeting Date:&quot;, {!$Record.TextBody})+13, 
FIND(&quot;Meeting Location:&quot;, {!$Record.TextBody})-FIND(&quot;Meeting Date:&quot;, {!$Record.TextBody})-13
)
, 254)</expression>
    </formulas>
    <formulas>
        <name>MeetingLocation</name>
        <dataType>String</dataType>
        <expression>Left(
MID({!$Record.TextBody}, 
FIND(&quot;Meeting Location:&quot;, {!$Record.TextBody})+17,
FIND(&quot;Attendees:&quot;, {!$Record.TextBody})-FIND(&quot;Meeting Location:&quot;, {!$Record.TextBody})-17
)
, 254)</expression>
    </formulas>
    <formulas>
        <name>WebsiteReview</name>
        <dataType>String</dataType>
        <expression>Left(
MID({!BodyTextWithBreaks}, 
FIND(&quot;Website URL for Review:&quot;, {!BodyTextWithBreaks})+23, 
FIND(&quot;-linebreak-&quot;, {!BodyTextWithBreaks}, FIND(&quot;Website URL for Review:&quot;, {!BodyTextWithBreaks}))-FIND(&quot;Website URL for Review:&quot;, {!BodyTextWithBreaks})-23
)
, 254)</expression>
    </formulas>
