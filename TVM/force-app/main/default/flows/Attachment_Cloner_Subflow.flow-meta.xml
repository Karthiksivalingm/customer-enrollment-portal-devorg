<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Collection</name>
        <label>Add to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AttachmentCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Attachment2Create</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Attachments</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Attachments</name>
        <label>Build Attachments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Attachment2Create.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Newly_Cloned_Records</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Attachment2Create.Body</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Attachments.Body</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Attachment2Create.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Attachments.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Attachment2Create.ContentType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Attachments.ContentType</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <description>Different than CDL Cloner!!!</description>
    <environments>Default</environments>
    <interviewLabel>Attachment Cloner Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Attachment Cloner Subflow</label>
    <loops>
        <name>Loop_Attachments</name>
        <label>Loop Attachments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Attachments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Attachments</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Newly_Cloned_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Newly_Cloned_Records</name>
        <label>Newly Cloned Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>NewClonedRecordIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Loop_Attachments</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Attachmnets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
