    <formulas>
        <name>ActiveAssistant</name>
        <dataType>Boolean</dataType>
        <expression>{!ApolloAssistantStatus}=&quot;Active&quot;</expression>
    </formulas>
    <formulas>
        <name>ActivePreQual</name>
        <dataType>Boolean</dataType>
        <expression>{!CreditPreQualStatus}=&quot;Active&quot;</expression>
    </formulas>
    <formulas>
        <name>ActiveVDV</name>
        <dataType>Boolean</dataType>
        <expression>{!VDVStatus}=&quot;Active&quot;</expression>
    </formulas>
    <formulas>
        <name>ApolloAssistantStatus</name>
        <dataType>String</dataType>
        <expression>if({!$Record.Try_Buy_Apollo_Assistant_Status__c}=&quot;No Try &amp; Buy&quot;, &quot;&quot;,
if({!$Record.Try_Buy_Apollo_Assistant_Status__c}=&quot;Lost&quot;, &quot;Lost&quot;,
if(Contains({!$Record.Try_Buy_Apollo_Assistant_Status__c}, &quot;Month&quot;), &quot;Active&quot;,
if({!$Record.Try_Buy_Apollo_Assistant_Status__c}!=&quot;&quot;, &quot;Won&quot;,
&quot;&quot;
))))</expression>
    </formulas>
    <formulas>
        <name>CreditPreQualStatus</name>
        <dataType>String</dataType>
        <expression>if({!$Record.Try_Buy_Credit_PreQual_Status__c}=&quot;No Try &amp; Buy&quot;, &quot;&quot;,
if({!$Record.Try_Buy_Credit_PreQual_Status__c}=&quot;Lost&quot;, &quot;Lost&quot;,
if(Contains({!$Record.Try_Buy_Credit_Prequal_Status__c}, &quot;Month&quot;), &quot;Active&quot;,
if({!$Record.Try_Buy_Credit_PreQual_Status__c}!=&quot;&quot;, &quot;Won&quot;,
&quot;&quot;
))))</expression>
    </formulas>
    <formulas>
        <name>EarliestTryBuy</name>
        <dataType>Date</dataType>
        <expression>if(
{!ActiveVDV}, {!$Record.Earliest_Try_Buy_VDV__c},
if(
{!ActivePreQual}, {!$Record.Earliest_Try_Buy_Credit_PreQual__c},
if(
{!ActiveAssistant}, {!$Record.Earliest_Try_Buy_Apollo_Assistant_AI__c},
null
)))</expression>
    </formulas>
    <formulas>
        <name>ExpectedCloseDate</name>
        <dataType>Date</dataType>
        <expression>if(
IsNull(DateValue({!$Record.Try_Buy_Apollo_Assistant_Expected_Paid__c}))=false,
DateValue({!$Record.Try_Buy_Apollo_Assistant_Expected_Paid__c}),
if(
IsNull(DateValue({!$Record.Try_Buy_Credit_PreQual_Expected_Paid__c}))=false,
DateValue({!$Record.Try_Buy_Credit_PreQual_Expected_Paid__c}),
if(
IsNull(DateValue({!$Record.Try_Buy_VDV_Expected_Paid__c}))=false,
DateValue({!$Record.Try_Buy_VDV_Expected_Paid__c}),

ADDMONTHS({!$Record.Budget_Month_Date__c}, 2)
)))</expression>
    </formulas>
    <formulas>
        <name>FirstDayCurrentMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(Year({!$Flow.CurrentDate}),MONTH({!$Flow.CurrentDate}), 1)</expression>
    </formulas>
    <formulas>
        <name>FirstDayNextMonth</name>
        <dataType>Date</dataType>
        <expression>IF(MONTH({!$Flow.CurrentDate}) = 1, 
   DATE(YEAR({!$Flow.CurrentDate}) - 1, 12, 1),
   DATE(YEAR({!$Flow.CurrentDate}), MONTH({!$Flow.CurrentDate}) + 1, 1)
)</expression>
    </formulas>
    <formulas>
        <name>FirstDayPreviousMonth</name>
        <dataType>Date</dataType>
        <expression>IF(MONTH({!$Flow.CurrentDate}) = 1, 
   DATE(YEAR({!$Flow.CurrentDate}) - 1, 12, 1),
   DATE(YEAR({!$Flow.CurrentDate}), MONTH({!$Flow.CurrentDate}) - 1, 1)
)</expression>
    </formulas>
    <formulas>
        <name>NewCloseDate</name>
        <dataType>Date</dataType>
        <expression>AddMonths({!$Record.Budget_Month_Date__c}, 3)</expression>
    </formulas>
    <formulas>
        <name>TryBuyProductList</name>
        <dataType>String</dataType>
        <expression>if(
{!ApolloAssistantStatus}=&quot;Active&quot; &amp;&amp; {!CreditPreQualStatus}=&quot;Active&quot; &amp;&amp; {!VDVStatus}=&quot;Active&quot;, &quot;BundleAIPreQualVDV&quot;,
if({!ApolloAssistantStatus}=&quot;Active&quot;, &quot;Apollo_Assistant_AI&quot;, &quot;&quot;)&amp;
if({!CreditPreQualStatus}=&quot;Active&quot;, &quot;PreQual&quot;, &quot;&quot;)&amp;
if({!VDVStatus}=&quot;Active&quot;, &quot;VDV&quot;, &quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>TryBuyProductListToAdd</name>
        <dataType>String</dataType>
        <expression>if(
{!FlagAssistant} &amp;&amp; {!FlagPreQual} &amp;&amp; {!FlagVDV}, &quot;BundleAIPreQualVDV&quot;,
if({!FlagAssistant}, &quot;Apollo_Assistant_AI&quot;, &quot;&quot;)&amp;
if({!FlagPreQual}, &quot;PreQual&quot;, &quot;&quot;)&amp;
if({!FlagVDV}, &quot;VDV&quot;, &quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>VDVStatus</name>
        <dataType>String</dataType>
        <expression>if({!$Record.Try_Buy_VDV_Status__c}=&quot;No Try &amp; Buy&quot;, &quot;&quot;,
if({!$Record.Try_Buy_VDV_Status__c}=&quot;Lost&quot;, &quot;Lost&quot;,
if(Contains({!$Record.Try_Buy_VDV_Status__c}, &quot;Month&quot;), &quot;Active&quot;,
if({!$Record.Try_Buy_VDV_Status__c}!=&quot;&quot;, &quot;Won&quot;,
&quot;&quot;
))))</expression>
    </formulas>
