        </inputAssignments>
        <inputAssignments>
            <field>Geolocation__Longitude__s</field>
            <value>
                <elementReference>$Record.Account__r.BillingLongitude</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
