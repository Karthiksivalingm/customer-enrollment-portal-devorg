        </filters>
        <filters>
            <field>Completed__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Demo</stringValue>
            </value>
        </filters>
        <object>Sales_Activity__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-03-07</startDate>
            <startTime>01:00:00.000Z</startTime>
