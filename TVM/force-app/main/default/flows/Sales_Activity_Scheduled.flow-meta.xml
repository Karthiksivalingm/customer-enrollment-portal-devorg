    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Geo</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Geolocation__Latitude__s</field>
            <operator>IsNull</operator>
