        <defaultConnector>
            <targetReference>Demo_Past</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Channel_Exists</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sales_Activity__r.Slack_Channel_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes, Channel Exists</label>
        </rules>
        <rules>
            <name>Is_Weekend</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsWeekday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Weekend</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsWeekday</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    OR(
        MOD(TODAY() - DATE(1985, 6, 24), 7) = 1,  /* Monday */
        MOD(TODAY() - DATE(1985, 6, 24), 7) = 2,  /* Tuesday */
        MOD(TODAY() - DATE(1985, 6, 24), 7) = 3,  /* Wednesday */
        MOD(TODAY() - DATE(1985, 6, 24), 7) = 4,  /* Thursday */
        MOD(TODAY() - DATE(1985, 6, 24), 7) = 5   /* Friday */
    ),
    true,
    false
)</expression>
    </formulas>
