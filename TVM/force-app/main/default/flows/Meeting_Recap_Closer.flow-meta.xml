<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Close_MR</name>
        <label>Close MR</label>
        <locationX>882</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>Get_Meeting_Recap.Recap_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Opted Not To Send</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Master_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Budget_Field_Updates</name>
        <label>Set Budget Field Updates</label>
        <locationX>750</locationX>
        <locationY>830</locationY>
        <assignmentItems>
            <assignToReference>Get_Monthly_Budget.HS_Recap_Location__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Meeting_Recap.Meeting_Location__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Monthly_Budget.HS_Recap_Frequency__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_RecapFrequency</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Monthly_Budget</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Decision checks if Get_Monthly_Budget.Id is blank.
If blank → create new Monthly Budget record.
If not blank → update existing one.</description>
        <name>Found_Budget</name>
        <label>Found Budget?</label>
        <locationX>875</locationX>
        <locationY>769</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Found_Budget</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Monthly_Budget</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Budget_Field_Updates</targetReference>
            </connector>
            <label>Yes - Found Budget</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>var_BudgetMonthStart</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR({!Get_Meeting_Recap.Meeting_Date__c}),
  MONTH({!Get_Meeting_Recap.Meeting_Date__c}),
  1
)</expression>
    </formulas>
    <formulas>
        <name>var_BugCount</name>
        <dataType>Number</dataType>
        <expression>{!Get_Monthly_Budget.of_Bugs_this_Month__c} +1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>var_RecapFrequency</name>
        <dataType>String</dataType>
        <expression>
IF(
  {!var_BudgetMonthStart} = DATE(YEAR(TODAY()), MONTH(TODAY()), 1),
  &quot;Recap This Month&quot;,
  IF(
    {!var_BudgetMonthStart} = ADDMONTHS(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), -1),
    &quot;No Recap This Month, Recap Last Month&quot;,
    &quot;No Recap Last 2 Months&quot;
  )
)</expression>
    </formulas>
    <interviewLabel>Meeting Recap - Closer {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Meeting Recap - Closer EC V1</label>
    <processMetadataValues>
        <name>BuilderType</name>
