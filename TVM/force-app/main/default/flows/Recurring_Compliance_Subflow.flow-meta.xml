    <formulas>
        <name>NewRunDate</name>
        <dataType>String</dataType>
        <expression>CASE(TRIM(LEFT({!AllComp.Run_Dates__c}, FIND(&quot; &quot;, {!AllComp.Run_Dates__c}) - 1)),
&quot;January&quot;,   &quot;February &quot;  &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;February&quot;,  &quot;March &quot;     &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;March&quot;,     &quot;April &quot;     &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;April&quot;,     &quot;May &quot;       &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;May&quot;,       &quot;June &quot;      &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;June&quot;,      &quot;July &quot;      &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;July&quot;,      &quot;August &quot;    &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;August&quot;,    &quot;September &quot; &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;September&quot;, &quot;October &quot;   &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;October&quot;,   &quot;November &quot;  &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;November&quot;,  &quot;December &quot;  &amp; RIGHT({!AllComp.Run_Dates__c}, 4),
&quot;December&quot;,  &quot;January &quot;   &amp; TEXT(VALUE(RIGHT({!AllComp.Run_Dates__c}, 4)) + 1),
&quot;Invalid Date Format&quot;
)</expression>
    </formulas>
