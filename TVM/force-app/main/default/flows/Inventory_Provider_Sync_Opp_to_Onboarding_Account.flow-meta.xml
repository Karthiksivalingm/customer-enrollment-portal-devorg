    <description>This flow runs when an Opportunity is updated and the Inventory Provider fields change.  
It identifies whether the Opportunity is using a New or Used provider, pulls the most recent Onboarding record for the Account, and updates both the Onboarding record and the Account record with the correct provider values.</description>
    <environments>Default</environments>
    <formulas>
        <name>HasNEWprovideronly</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK($Record.New_Inventory_Provider__c)),
    ISBLANK($Record.Used_Inventory_Provider__c)
)</expression>
    </formulas>
    <formulas>
        <name>HasUSEDprovideronly</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK($Record.Used_Inventory_Provider__c)),
    ISBLANK($Record.New_Inventory_Provider__c)
)</expression>
    </formulas>
    <formulas>
        <name>InputNewInventory</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER({!$Record.New_Inventory_Provider__c}), &quot; &quot;, &quot;&quot;),&quot;.&quot;, &quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;&amp;&quot;, &quot;&quot;),&quot;#&quot;, &quot;&quot;)</expression>
    </formulas>
