        </rules>
        <rules>
            <name>Yes_Analytics_Access</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CaseRequest</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analytics Access</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Case.Case_Request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analytics Access</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Analytics_Access_Screen</targetReference>
            </connector>
            <label>Yes, Analytics Access</label>
        </rules>
        <rules>
            <name>Yes_Custom_Report</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CaseRequest</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Custom Report</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Case.Case_Request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Custom Report</stringValue>
                </rightValue>
            </conditions>
            <connector>
