        <rules>
            <name>Yes_Web_Analytics</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CaseRequest</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Property Ownership Transfer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Case.Case_Request__c</leftValueReference>
