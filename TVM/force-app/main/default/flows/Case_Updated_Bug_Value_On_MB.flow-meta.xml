<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>MB_Found_Gate</name>
        <label>MB Found Gate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MB_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetMB</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Push_Update</targetReference>
            </connector>
            <label>MB Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FirstDayClosedMonth</name>
        <dataType>Date</dataType>
        <expression>Date(Year({!$Record.Closed_Date_Only__c}), Month({!$Record.Closed_Date_Only__c}), 1)</expression>
    </formulas>
    <formulas>
        <name>NewCount</name>
        <dataType>Number</dataType>
        <expression>if({!GetMB.of_Bugs_this_Month__c}&gt;0, {!GetMB.of_Bugs_this_Month__c}-1, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Case - Updated - Bug Value On MB {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Updated - Bug Value On MB</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetMB</name>
        <label>GetMB</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>MB_Found_Gate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Budget_Month_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>FirstDayClosedMonth</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Monthly_Budget__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Push_Update</name>
        <label>Push Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetMB.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>of_Bugs_this_Month__c</field>
            <value>
                <elementReference>NewCount</elementReference>
            </value>
        </inputAssignments>
        <object>Monthly_Budget__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetMB</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Reopened_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Request_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Bug</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
