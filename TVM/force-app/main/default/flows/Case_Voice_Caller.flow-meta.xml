    <description>Allows Users to make Outbound voice calls from cases</description>
    <environments>Default</environments>
    <formulas>
        <name>CookedPhoneNumbers</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!fx_StripSpecialChars}, &quot;+&quot;), 
  {!fx_StripSpecialChars},

  IF(
    LEN({!fx_StripSpecialChars}) = 10, 
    &quot;+1&quot; &amp; {!fx_StripSpecialChars},

    IF(
      AND(LEN({!fx_StripSpecialChars}) = 11, BEGINS({!fx_StripSpecialChars}, &quot;1&quot;)), 
      &quot;+&quot; &amp; {!fx_StripSpecialChars},

      &quot;+&quot; &amp; {!fx_StripSpecialChars}
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>fx_StripSpecialChars</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        {!RawPhoneNumber}, 
      &quot;-&quot;, &quot;&quot;), 
    &quot; &quot;, &quot;&quot;), 
  &quot;(&quot;, &quot;&quot;), 
&quot;)&quot;, &quot;&quot;)</expression>
    </formulas>
