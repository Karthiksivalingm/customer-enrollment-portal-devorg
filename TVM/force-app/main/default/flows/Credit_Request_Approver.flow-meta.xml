    <decisions>
        <name>Approval_User</name>
        <label>Approval User?</label>
        <locationX>968</locationX>
        <locationY>290</locationY>
        <defaultConnector>
            <targetReference>Screen_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Approval_User</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>David Boice</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Alex Calacci</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DJ Gilliland</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bill Reilly</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_1</targetReference>
            </connector>
            <label>Yes, Approval User</label>
        </rules>
        <rules>
            <name>Limited_Approval_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Matt Hill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Credit_Request.Credit_Amount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_1</targetReference>
            </connector>
            <label>Limited Approval Access</label>
        </rules>
        <rules>
            <name>Limited_Approval_Access_Fail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Full_Name_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Matt Hill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Credit_Request.Credit_Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>5000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_3_0</targetReference>
            </connector>
            <label>Limited Approval Access Fail</label>
        </rules>
