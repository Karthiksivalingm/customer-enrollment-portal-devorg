    <formulas>
        <name>IsMoreThanTwoHours</name>
        <dataType>Boolean</dataType>
        <expression>{!UserSelectedDateTimeConversion} &gt; {!TwoHoursFromNow}</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
    <formulas>
        <name>TwoHoursFromNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (2/24)</expression>
    </formulas>
    <formulas>
        <name>UserSelectedDateTimeConversion</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    TEXT({!$Record.Request_Needed_By_Date__c}) &amp; &quot; &quot; &amp; 
    CASE({!$Record.Request_Needed_By_Time_EST__c},
        &quot;8:00 AM&quot;,  &quot;12:00:00&quot;, /* 8 AM EDT = 12:00 GMT */
        &quot;9:00 AM&quot;,  &quot;13:00:00&quot;, /* 9 AM EDT = 13:00 GMT */
        &quot;9:30 AM&quot;,  &quot;13:30:00&quot;, /* 9:30 AM EDT = 13:30 GMT */
        &quot;10:00 AM&quot;, &quot;14:00:00&quot;, /* 10 AM EDT = 14:00 GMT */
        &quot;10:30 AM&quot;, &quot;14:30:00&quot;, /* 10:30 AM EDT = 14:30 GMT */
        &quot;11:00 AM&quot;, &quot;15:00:00&quot;, /* 11 AM EDT = 15:00 GMT */
        &quot;11:30 AM&quot;, &quot;15:30:00&quot;, /* 11:30 AM EDT = 15:30 GMT */
        &quot;12:00 PM&quot;, &quot;16:00:00&quot;, /* 12 PM EDT = 16:00 GMT */
        &quot;12:30 PM&quot;, &quot;16:30:00&quot;, /* 12:30 PM EDT = 16:30 GMT */
        &quot;1:00 PM&quot;,  &quot;17:00:00&quot;, /* 1 PM EDT = 17:00 GMT */
        &quot;1:30 PM&quot;,  &quot;17:30:00&quot;, /* 1:30 PM EDT = 17:30 GMT */
        &quot;2:00 PM&quot;,  &quot;18:00:00&quot;, /* 2 PM EDT = 18:00 GMT */
        &quot;2:30 PM&quot;,  &quot;18:30:00&quot;, /* 2:30 PM EDT = 18:30 GMT */
        &quot;3:00 PM&quot;,  &quot;19:00:00&quot;, /* 3 PM EDT = 19:00 GMT */
        &quot;3:30 PM&quot;,  &quot;19:30:00&quot;, /* 3:30 PM EDT = 19:30 GMT */
        &quot;4:00 PM&quot;,  &quot;20:00:00&quot;, /* 4 PM EDT = 20:00 GMT */
        &quot;4:30 PM&quot;,  &quot;20:30:00&quot;, /* 4:30 PM EDT = 20:30 GMT */
        &quot;5:00 PM&quot;,  &quot;21:00:00&quot;, /* 5 PM EDT = 21:00 GMT */
        &quot;5:30 PM&quot;,  &quot;21:30:00&quot;, /* 5:30 PM EDT = 21:30 GMT */
        

        &quot;00:00:00&quot; 
    ) &amp; &quot;.000Z&quot; 
)
+
/* 2. Check for Winter (Standard Time) and add 1 Hour if necessary */
IF(
    OR(
        /* Date is BEFORE the start of DST (2nd Sunday in March) */
        {!$Record.Request_Needed_By_Date__c} &lt; 
        (DATE(YEAR({!$Record.Request_Needed_By_Date__c}), 3, 14) - 
        MOD(DATE(YEAR({!$Record.Request_Needed_By_Date__c}), 3, 14) - DATE(1900, 1, 7), 7)),
        
        /* Date is AFTER the end of DST (1st Sunday in November) */
        {!$Record.Request_Needed_By_Date__c} &gt;= 
        (DATE(YEAR({!$Record.Request_Needed_By_Date__c}), 11, 7) - 
        MOD(DATE(YEAR({!$Record.Request_Needed_By_Date__c}), 11, 7) - DATE(1900, 1, 7), 7))
    ),
    /* If Winter, Add 1 Hour (1 day divided by 24 hours) */
    1/24, 
    /* Else (Summer), Add 0 */
    0
)</expression>
    </formulas>
