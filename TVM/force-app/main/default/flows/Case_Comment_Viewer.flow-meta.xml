    <formulas>
        <name>CommentCleaned</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!Comments.Text_Rich__c}, 3) = BR(),
    LEFT({!Comments.Text_Rich__c}, LEN({!Comments.Text_Rich__c}) - 3),
    {!Comments.Text_Rich__c}
)</expression>
    </formulas>
    <formulas>
        <name>DST_OFFSET_HOURS</name>
        <dataType>Number</dataType>
        <expression>IF(
    AND(
        DATEVALUE({!Comments.CreatedDate}) &gt;= DATE(YEAR(DATEVALUE({!Comments.CreatedDate})),3,1) + MOD(8-WEEKDAY(DATE(YEAR(DATEVALUE({!Comments.CreatedDate})),3,1)),7) + 7,
        DATEVALUE({!Comments.CreatedDate}) &lt; DATE(YEAR(DATEVALUE({!Comments.CreatedDate})),11,1) + MOD(8-WEEKDAY(DATE(YEAR(DATEVALUE({!Comments.CreatedDate})),11,1)),7)
    ),
    4,
    5
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FirstLineTime</name>
        <dataType>String</dataType>
        <expression>TEXT(Month(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot;/&quot;&amp; 
TEXT(Day(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot;/&quot;&amp; 
TEXT(YEAR(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot; &quot;&amp; 
IF(
    VALUE(MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 12, 2)) &gt; 12,
    TEXT(VALUE(MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 12, 2)) - 12) &amp; &apos;:&apos; &amp; MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 15, 2) &amp; &apos;PM&apos;,
    IF(
        VALUE(MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 12, 2)) = 12,
        &apos;12:&apos; &amp; MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 15, 2) &amp; &apos;PM&apos;,
        IF(
            VALUE(MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 12, 2)) = 0,
            &apos;12:&apos; &amp; MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 15, 2) &amp; &apos;AM&apos;,
            TEXT(VALUE(MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 12, 2))) &amp; &apos;:&apos; &amp; MID(TEXT({!Comments.CreatedDate} - ({!DST_OFFSET_HOURS} / 24)), 15, 2) &amp; &apos;AM&apos;
        )
    )
)</expression>
    </formulas>
