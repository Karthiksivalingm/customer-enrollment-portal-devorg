    <formulas>
        <name>CommentCleaned</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!Comments.Note__c}, 3) = BR(),
    LEFT({!Comments.Note__c}, LEN({!Comments.Note__c}) - 3),
    {!Comments.Note__c}
)</expression>
    </formulas>
    <formulas>
        <name>FirstLineTime</name>
        <dataType>String</dataType>
        <expression>TEXT(Month(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot;/&quot;&amp; 
TEXT(Day(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot;/&quot;&amp; 
TEXT(YEAR(DATEVALUE({!Comments.CreatedDate}))) &amp;&quot; &quot;&amp; 
IF(
    VALUE(MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 12, 2)) &gt; 12,
    TEXT(VALUE(MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 12, 2)) - 12) &amp; &apos;:&apos; &amp; MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 15, 2) &amp; &apos;PM&apos;,
    IF(
        VALUE(MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 12, 2)) = 12,
        &apos;12:&apos; &amp; MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 15, 2) &amp; &apos;PM&apos;,
        IF(
            VALUE(MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 12, 2)) = 0,
            &apos;12:&apos; &amp; MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 15, 2) &amp; &apos;AM&apos;,
            TEXT(VALUE(MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 12, 2))) &amp; &apos;:&apos; &amp; MID(TEXT(DATETIMEVALUE({!Comments.CreatedDate} - 5/24)), 15, 2) &amp; &apos;AM&apos;
        )
    )
)</expression>
    </formulas>
