    <formulas>
        <name>DayOweek</name>
        <dataType>String</dataType>
        <expression>CASE(WEEKDAY(TODAY()), 
  1, &quot;Sunday&quot;, 
  2, &quot;Monday&quot;, 
  3, &quot;Tuesday&quot;, 
  4, &quot;Wednesday&quot;, 
  5, &quot;Thursday&quot;, 
  6, &quot;Friday&quot;, 
  7, &quot;Saturday&quot;, 
  &quot;Error&quot;)</expression>
    </formulas>
    <formulas>
        <name>StalledSubject</name>
        <dataType>String</dataType>
        <expression>IF({!StalledOppsCount} &gt; 1, &quot;You Have StalledOppsCount Stalled Opps&quot;, &quot;You have StalledOppsCount Stalled Opp&quot;)</expression>
    </formulas>
