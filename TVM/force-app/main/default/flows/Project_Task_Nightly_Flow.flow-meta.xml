    <decisions>
        <name>Final_Creative_Review</name>
        <label>Final Creative Review?</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Not Final Creative Review</defaultConnectorLabel>
        <rules>
            <name>Yes_Final_Creative_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Task_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Creative Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Website_Go_Live_Date_Review_Period__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Started</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Designer_Review</targetReference>
            </connector>
            <label>Yes, Final Creative Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
