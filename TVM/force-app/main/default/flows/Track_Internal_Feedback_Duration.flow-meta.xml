<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Feedback_Status</name>
        <label>Check Feedback Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Entered_Internal_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status_Filtered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Internal_Feedback_Start</targetReference>
            </connector>
            <label>Entered Internal Feedback</label>
        </rules>
        <rules>
            <name>Exited_Internal_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status_Filtered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status_Filtered__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Internal Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Internal_Feedback_Duration</targetReference>
            </connector>
            <label>Exited Internal Feedback</label>
        </rules>
        <rules>
            <name>Entered_External_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status_Filtered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_External_Feedback_Start</targetReference>
            </connector>
            <label>Entered External Feedback</label>
        </rules>
        <rules>
            <name>Exited_External_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status_Filtered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status_Filtered__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>External Feedback Needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_External_Feedback_Duration</targetReference>
            </connector>
            <label>Exited External Feedback</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ExternalFeedbackDuration</name>
        <dataType>Number</dataType>
        <expression>($Flow.CurrentDateTime - {!$Record.External_Feedback_Start__c}) * 24</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>InternalFeedbackDuration</name>
        <dataType>Number</dataType>
        <expression>($Flow.CurrentDateTime - {!$Record.Internal_Feedback_Start__c}) * 24</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Track Internal Feedback Duration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Track Internal Feedback Duration</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_External_Feedback_Start</name>
        <label>Set External Feedback Start</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>External_Feedback_Start__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Internal_Feedback_Start</name>
        <label>Set Internal Feedback Start</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Internal_Feedback_Start__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_External_Feedback_Duration</name>
        <label>Update Internal Feedback Duration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>External_Feedback_Hours__c</field>
            <value>
                <elementReference>ExternalFeedbackDuration</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Internal_Feedback_Duration</name>
        <label>Update Internal Feedback Duration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Internal_Feedback_Duration_Hours__c</field>
            <value>
                <elementReference>InternalFeedbackDuration</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Feedback_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status_Filtered__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Case_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>General Support</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
