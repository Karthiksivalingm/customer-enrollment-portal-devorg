    <decisions>
        <name>All_Presentations_Completed</name>
        <label>All Presentations Completed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_All_Presentations_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Presentation1Complete</leftValueReference>
                <operator>EqualTo</operator>
