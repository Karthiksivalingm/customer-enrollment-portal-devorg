Value(Right(Text( {!$Record.Try_Buy_First_Billing_Month__c}), 4)),

Case(Left(Text( {!$Record.Try_Buy_First_Billing_Month__c} ), 3),
&quot;JAN&quot;, 1,
&quot;FEB&quot;, 2,
&quot;MAR&quot;, 3,
&quot;APR&quot;, 4,
&quot;MAY&quot;, 5,
&quot;JUN&quot;, 6,
&quot;JUL&quot;, 7,
&quot;AUG&quot;, 8,
&quot;SEP&quot;, 9,
&quot;OCT&quot;, 10,
&quot;NOV&quot;, 11,
&quot;DEC&quot;, 12,
1),

1
)</expression>
    </formulas>
    <formulas>
