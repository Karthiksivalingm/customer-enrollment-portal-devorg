        <dataType>String</dataType>
        <expression>Case(Month({!$Record.CloseDate}),
1, &quot;JAN&quot;,
2, &quot;FEB&quot;,
3, &quot;MAR&quot;,
4, &quot;APR&quot;,
5, &quot;MAY&quot;,
6, &quot;JUN&quot;,
7, &quot;JUL&quot;,
8, &quot;AUG&quot;,
9, &quot;SEP&quot;,
10, &quot;OCT&quot;,
11, &quot;NOV&quot;,
12, &quot;DEC&quot;,
&quot;JAN&quot;
)
&amp;Text(Year({!$Record.CloseDate}))</expression>
    </formulas>
