    <formulas>
        <name>CleanedDealershipName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
               SUBSTITUTE(
                SUBSTITUTE({!SlackChannelName}, &quot;/ &quot;, &quot;&quot;),&quot;-&quot;, &quot;&quot;), &quot;#&quot; , &quot;&quot;), &quot;:&quot; , &quot;&quot;), &quot;.&quot; , &quot;&quot;), &quot;&apos;&quot;, &quot;&quot;)&amp;
TEXT(YEAR({!$Flow.CurrentDate})) &amp;&quot;_&quot;&amp; TEXT(MONTH({!$Flow.CurrentDate})) &amp;&quot;_&quot;&amp; TEXT(DAY({!$Flow.CurrentDate}))</expression>
    </formulas>
    <formulas>
        <name>PrimaryPOCInfo</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Primary_POC.FirstName}), &quot;No first name &quot;,{!Get_Primary_POC.FirstName} &amp; &quot; &quot;)&amp;
IF(ISBLANK({!Get_Primary_POC.LastName}), &quot;No last name | Email: &quot;,{!Get_Primary_POC.LastName} &amp; &quot; | Email: &quot;)&amp;
IF(ISBLANK({!Get_Primary_POC.Email}), &quot;No email | Phone: &quot;,{!Get_Primary_POC.Email} &amp; &quot; | Phone: &quot;)&amp;
IF(ISBLANK({!Get_Primary_POC.Phone}), &quot;No phone number&quot;,{!Get_Primary_POC.Phone})</expression>
    </formulas>
    <formulas>
        <name>SlackChannelName</name>
        <dataType>String</dataType>
        <expression>&quot;sf_opp_&quot;&amp;
Lower(
IF(LEN(SUBSTITUTE({!Get_Opportunity.Name}, &quot; &quot;, &quot;&quot;)) &lt;= 47, 
    SUBSTITUTE({!Get_Opportunity.Name}, &quot; &quot;, &quot;&quot;),
    LEFT(SUBSTITUTE({!Get_Opportunity.Name}, &quot; &quot;, &quot;&quot;), 47)
))</expression>
    </formulas>
