    <formulas>
        <name>concatValues</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        ISBLANK(TEXT({!$Record__Prior.Product_Status__c})),
        TEXT({!$Record__Prior.Product_Status__c}) = &quot;&quot;
    ),
    /* ===== NEW OPPORTUNITY ===== */
    IF(
        ISBLANK({!getTypeFieldVal}),
        TEXT({!$Record.Product_Status__c}),
        IF(
            OR(
                CONTAINS(&quot;;&quot; &amp; {!getTypeFieldVal} &amp; &quot;;&quot;, &quot;;&quot; &amp; TEXT({!$Record.Product_Status__c}) &amp; &quot;;&quot;),
                {!getTypeFieldVal} = TEXT({!$Record.Product_Status__c})
            ),
            {!getTypeFieldVal},
            {!getTypeFieldVal} &amp; &quot;;&quot; &amp; TEXT({!$Record.Product_Status__c})
        )
    ),
    /* ===== EXISTING OPPORTUNITY CHANGED ===== */
    IF(
        ISBLANK({!getTypeFieldVal}),
        TEXT({!$Record.Product_Status__c}),
        IF(
            /* Check if new value already exists in list */
            CONTAINS(&quot;;&quot; &amp; {!getTypeFieldVal} &amp; &quot;;&quot;, &quot;;&quot; &amp; TEXT({!$Record.Product_Status__c}) &amp; &quot;;&quot;),
            /* New value EXISTS: just remove old value (avoid duplicate) - SCENARIO 1 */
            TRIM(SUBSTITUTE(&quot;;&quot; &amp; {!getTypeFieldVal} &amp; &quot;;&quot;, &quot;;&quot; &amp; TEXT({!$Record__Prior.Product_Status__c}) &amp; &quot;;&quot;, &quot;;&quot;)),
            /* New value DOESN&apos;T EXIST: ADD new value, KEEP old value (history) - SCENARIO 2 &amp; 3 */
            {!getTypeFieldVal} &amp; &quot;;&quot; &amp; TEXT({!$Record.Product_Status__c})
        )
    )
)</expression>
    </formulas>
    <formulas>
