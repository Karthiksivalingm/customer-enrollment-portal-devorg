    <description>This flow will use the description fields from the Price Book Entry related to the Opportunity Product to update counts on the Opportunity and loop through all of the Opportunity Products for this Opportunity to determine the Opportunity&apos;s Total Discount and Main Category Amounts.</description>
    <environments>Default</environments>
    <formulas>
        <name>SingleOpportunityProduct_MainCategoryDigital</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!Loop_through_all_Opportunity_Products.Product2.Main_Category__c},&quot;Digital&quot;),
{!Loop_through_all_Opportunity_Products.TotalPrice},
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SingleOpportunityProduct_MainCategoryRetention</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!Loop_through_all_Opportunity_Products.Product2.Main_Category__c},&quot;Retention&quot;),
{!Loop_through_all_Opportunity_Products.TotalPrice},
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SingleOpportunityProduct_MainCategoryWebsite</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!Loop_through_all_Opportunity_Products.Product2.Main_Category__c},&quot;Website&quot;),
{!Loop_through_all_Opportunity_Products.TotalPrice},
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SingleOpportunityProductDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!Loop_through_all_Opportunity_Products.ListPrice} - {!Loop_through_all_Opportunity_Products.UnitPrice}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Support</name>
        <dataType>String</dataType>
        <expression>if(
IsBlank({!$Record.Apollo_Sites_Premium__c})=false &amp;&amp; {!Get_Opp.Pricebook2.Name}=&quot;Mitsubishi Contract Products&quot;, &quot;In Store&quot;,
Text({!Get_Opp.Support__c})
)</expression>
    </formulas>
