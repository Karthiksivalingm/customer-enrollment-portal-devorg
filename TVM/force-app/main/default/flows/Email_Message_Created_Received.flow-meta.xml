    <description>This flow will trigger when an inbound email message is received. This is currently configured for email messages that are sent in response to a prior message on a Case so that the Case&apos;s Owner &amp; RAD can be notified that a new email was received.</description>
    <environments>Default</environments>
    <formulas>
        <name>CreatedFlag</name>
        <dataType>Boolean</dataType>
        <expression>({!$Record.Parent.CreatedDate}+(1 / 1440)) &gt;= {!$Flow.CurrentDateTime}</expression>
    </formulas>
    <formulas>
        <name>MatchedCase</name>
        <dataType>Boolean</dataType>
        <expression>Contains({!$Record.Subject}, {!$Record.ParentId})</expression>
    </formulas>
    <formulas>
        <name>TextBodyDetails</name>
        <dataType>String</dataType>
        <expression>if(Contains({!BodyVar}, &quot;--------------- Original Message&quot;),
Trim(Mid({!BodyVar}, 0, FIND(&quot;--------------- Original Message&quot;, {!BodyVar})-1)),
Trim({!BodyVar})
)</expression>
    </formulas>
    <formulas>
        <name>TrimmedBody</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.TextBody}, 32765)</expression>
    </formulas>
    <interviewLabel>Email Message - Created - Received {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Email Message - Created - Received</label>
