                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Foundrecap_This_Month</targetReference>
            </connector>
            <label>Found Recap</label>
        </rules>
    </decisions>
    <description>Automates Monthly Budget updates by retrieving Meeting Recap data for the current and previous months, setting the correct Recap Frequency value, and calculating the number of Bug cases for that month.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmLastMonth</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Budget_Month_Date__c}, -1)</expression>
    </formulas>
    <formulas>
        <name>NxtMnth</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Budget_Month_Date__c}, 1)</expression>
    </formulas>
    <interviewLabel>MB_Recap_Bug {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Monthly Budget - Recap and Bug Count Automation_V1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves all Case records for the same Account and Budget Month as the current Monthly Budget record, filtered by Closed Date within the month window and Type = Bug. Used to calculate the number of bugs closed during that budget month.</description>
        <name>Get_Cases_For_Month</name>
        <label>Get Cases For Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Bug_Count_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Request_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Bug</stringValue>
            </value>
        </filters>
        <filters>
            <field>Closed_Date_Only__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.Budget_Month_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Closed_Date_Only__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>NxtMnth</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the most recent Meeting Recap record for the same dealership and the previous month, based on the Monthly Budget’s Budget Month Date.
Used to determine if a recap exists for the prior month when no current recap is found.</description>
        <name>Get_Last_Month_Recap</name>
        <label>Get Last Month Recap</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Last_Month_Recap</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Dealership__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Recap_Month_Formula__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmLastMonth</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Meeting_Recap__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Finds the most recent Meeting Recap record for the same Account and Budget Month as the new Monthly Budget.</description>
        <name>Get_Recap_For_This_Month</name>
        <label>Get Recap For This Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Recap</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Recap_Month_Formula__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Budget_Month_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Dealership__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Meeting_Recap__c</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Monthly Budget record that triggered the flow with the calculated total number of closed Bug cases for that month.</description>
        <name>Update_Monthly_Budget_with_Bug_Count</name>
        <label>Update Monthly Budget with Bug Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HS_Recap_Frequency__c</field>
            <value>
