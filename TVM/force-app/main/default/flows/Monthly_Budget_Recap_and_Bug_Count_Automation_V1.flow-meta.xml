    <decisions>
        <description>Determines whether a Meeting Recap record exists for the previous month.
If a recap is found, sets the path to “Recap Last Month”; otherwise, proceeds to “No Recap Info.”</description>
        <name>Has_Last_Month_Recap</name>
        <label>Has Last Month Recap?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Recap_2_Months</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recap_Last_Month</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Last_Month_Recap.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Found_recap_Last_Month</targetReference>
            </connector>
            <label>Recap Last Month</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if a Meeting Recap record was found for this Monthly Budget.</description>
        <name>Has_Recap</name>
        <label>Has Recap?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
