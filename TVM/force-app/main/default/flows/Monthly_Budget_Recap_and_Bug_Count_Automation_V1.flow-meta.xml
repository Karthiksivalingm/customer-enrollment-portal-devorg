            </value>
        </inputAssignments>
        <inputAssignments>
            <field>of_Bugs_this_Month__c</field>
            <value>
                <elementReference>varBugCount</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
