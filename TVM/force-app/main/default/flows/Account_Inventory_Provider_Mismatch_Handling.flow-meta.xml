    <description>Detects changes in Raw New Inventory Provider or Raw Used Inventory Provider.
Compares against Inventory Provider and Used Inventory Provider.
If mismatch exists, sets Temporary_Flag__c with context message.
Flags are later used for reporting and manual resolution.</description>
    <environments>Default</environments>
    <formulas>
        <name>MatchingNewInv</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER({!$Record.Inventory_Provider__c}), &quot; &quot;, &quot;&quot;),&quot;.&quot;, &quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;&amp;&quot;, &quot;&quot;),&quot;#&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>MatchingUsedInv</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER({!$Record.Used_Inventory_Provider__c}), &quot; &quot;, &quot;&quot;),&quot;.&quot;, &quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;&amp;&quot;, &quot;&quot;),&quot;#&quot;, &quot;&quot;)</expression>
    </formulas>
