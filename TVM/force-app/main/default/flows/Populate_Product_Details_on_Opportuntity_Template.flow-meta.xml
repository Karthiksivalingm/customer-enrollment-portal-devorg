            <targetReference>CXP_Premium_Not_Included</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Apollo CXP Premium is not included</defaultConnectorLabel>
        <rules>
            <name>Yes_Apollo_CXP_Premium_is_included</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ApolloCXPPremium</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CXP_Premium_Included</targetReference>
            </connector>
            <label>Yes, Apollo CXP Premium is included</label>
        </rules>
    </decisions>
