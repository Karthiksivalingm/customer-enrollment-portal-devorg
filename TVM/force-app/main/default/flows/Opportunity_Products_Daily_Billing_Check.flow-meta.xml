        <label>Update Record</label>
        <locationX>756</locationX>
        <locationY>576</locationY>
        <inputAssignments>
            <field>Billing_Amount_Static__c</field>
            <value>
                <elementReference>BillingAmountSet</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billing_Date_Static__c</field>
            <value>
