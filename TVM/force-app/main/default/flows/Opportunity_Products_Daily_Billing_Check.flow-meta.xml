        <locationY>50</locationY>
        <connector>
            <targetReference>Foundation_Account</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Billing_Date_Mismatch__c</field>
