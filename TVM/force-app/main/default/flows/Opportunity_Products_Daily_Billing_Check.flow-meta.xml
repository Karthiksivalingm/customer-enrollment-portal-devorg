    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Foundation_Account</name>
        <label>Foundation Account?</label>
        <locationX>784</locationX>
        <locationY>365</locationY>
        <defaultConnector>
            <targetReference>Update_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>TVM</defaultConnectorLabel>
        <rules>
            <name>Yes_Foundation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.Account.Foundation_Record__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes Foundation</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BillingAmountSet</name>
        <dataType>Currency</dataType>
        <expression>if(
({!$Record.Billing_Amount_Retention__c}) &gt;0, {!$Record.Billing_Amount_Retention__c},
if(
({!$Record.Billing_Amount_Website__c})&gt; 0, {!$Record.Billing_Amount_Website__c},
if(
({!$Record.Billing_Amount_Digital__c})&gt;0, {!$Record.Billing_Amount_Digital__c}, null
)))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>BillingDateSet</name>
        <dataType>Date</dataType>
        <expression>if(
IsBlank({!$Record.Billing_Date_Retention__c}) = false, {!$Record.Billing_Date_Retention__c},
if(
IsBlank({!$Record.Billing_Date_Website__c}) = false, {!$Record.Billing_Date_Website__c},
if(
IsBlank({!$Record.Billing_Date_Digital__c}) = false, {!$Record.Billing_Date_Digital__c}, null
)))</expression>
    </formulas>
    <interviewLabel>Opportunity Products - Daily Billing Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Products - Daily Billing Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
