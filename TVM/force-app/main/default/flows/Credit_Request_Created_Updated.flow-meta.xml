    <formulas>
        <name>ApprovalFormulaText</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Approval__c}) = &quot;Approved&quot;, &quot;Approved&quot;, &quot;Rejected&quot;)</expression>
    </formulas>
    <formulas>
        <name>ClientTeamRecipients_Formula</name>
        <dataType>String</dataType>
        <expression>if(isblank({!$Record.Account__r.VP_of_Client_Services__r.Email}), &quot;&quot;, &quot;sknox@teamvelocitymarketing.com,&quot; &amp;{!$Record.Account__r.VP_of_Client_Services__r.Email})</expression>
    </formulas>
    <formulas>
        <name>CreditApplied_MonthStamp</name>
        <dataType>String</dataType>
        <expression>CASE(If(TEXT({!$Record.Credit_Applied__c}) = &quot;Towards Next Month&quot;, IF(MONTH({!$Flow.CurrentDate}) = 12, 1,  MONTH({!$Flow.CurrentDate})+1),
IF(TEXT({!$Record.Credit_Applied__c}) = &quot;Towards Current Month&quot;, MONTH({!$Flow.CurrentDate}),
IF(TEXT({!$Record.Credit_Applied__c}) = &quot;Towards Mail&quot;,13,
IF(TEXT({!$Record.Credit_Applied__c}) = &quot;Cut Check Back to Dealer&quot;,14,
15)))),
    1, &quot;01 January&quot;,
    2, &quot;02 February&quot;,
    3, &quot;03 March&quot;,
    4, &quot;04 April&quot;,
    5, &quot;05 May&quot;,
    6, &quot;06 June&quot;,
    7, &quot;07 July&quot;,
    8, &quot;08 August&quot;,
    9, &quot;09 September&quot;,
    10, &quot;10 October&quot;,
    11, &quot;11 November&quot;,
    12, &quot;12 December&quot;,
    13,  &quot;Mail&quot;,
    14, &quot;Cut Check Back to Dealer&quot;,
&quot;No Credit Applied Selected&quot;
)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
