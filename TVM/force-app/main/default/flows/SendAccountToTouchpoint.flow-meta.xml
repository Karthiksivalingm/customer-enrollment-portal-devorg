        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_5</name>
        <label>Assign FID/Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FinalOutput</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{{!TempFID}||{!TempValue}}</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>FIDs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Get_Counts</name>
        <label>Get Counts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CountFIDValue</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>FIDValueList</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Initial_Validation</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Initialize_RID</name>
        <label>Initialize RID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FinalOutput</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>{!RID}-RID-</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>FIDs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>No_FID</name>
        <label>No FID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OutputStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No FID</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>RID_Empty</name>
        <label>RID Empty</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OutputStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No RIDs</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Initial_Validation</name>
        <label>Initial Validation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Initialize_RID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RID_List_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RID_Empty</targetReference>
            </connector>
            <label>RID Empty</label>
        </rules>
        <rules>
            <name>At_Least_1_FID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountFIDValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_FID</targetReference>
            </connector>
            <label>At Least 1 FID</label>
        </rules>
    </decisions>
    <description>Needs a Text Collection of FID, Value examples:
7618,&quot;Testme&quot;
7034,10</description>
    <environments>Default</environments>
    <formulas>
        <name>TempFID</name>
        <dataType>String</dataType>
        <expression>Left({!FIDs},FIND(&quot;,&quot;, {!FIDs})-1)</expression>
    </formulas>
    <formulas>
        <name>TempValue</name>
        <dataType>String</dataType>
        <expression>Right({!FIDs},LEN({!FIDs})-FIND(&quot;,&quot;,{!FIDs}))</expression>
    </formulas>
    <interviewLabel>SendAccountToTouchpoint {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SendAccountToTouchpoint</label>
