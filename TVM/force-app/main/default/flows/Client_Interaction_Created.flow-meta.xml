            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Previous_Interaction</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Older_interactions</name>
        <label>Any Older interactions?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Calc_Extra_Bits</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_continue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOlderInteractions.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UncheckOlder</targetReference>
            </connector>
            <label>Yes, continue</label>
        </rules>
    </decisions>
    <description>Calculates and maintains Monthly Budget scoring for Client Interactions.
Applies weighted scoring logic across key performance categories, including updated weights for Frequency of Visits and Monthly Reporting, and newly introduced Custom Creative and Mail scoring categories. Ensures all related records are recalculated and synchronized on creation of a Client Interaction.</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstDayOfCurrentMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), 1)</expression>
    </formulas>
    <formulas>
        <name>FirstDayOfNextMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()) + 1, 1)</expression>
    </formulas>
    <interviewLabel>Client Interaction - Created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Client Interaction - Created - erik v1</label>
    <processMetadataValues>
        <name>BuilderType</name>
