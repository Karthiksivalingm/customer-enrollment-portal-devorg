    <decisions>
        <name>First_Contact</name>
        <label>First Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Latter_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_first</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NumberOfContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Initial_Contact</targetReference>
            </connector>
            <label>Yes, first</label>
        </rules>
    </decisions>
    <description>Subflow | Builds List of Users Emails / Names / &amp; More</description>
    <environments>Default</environments>
    <formulas>
        <name>GreetingFormula</name>
        <dataType>String</dataType>
        <expression>IF({!NumberOfContacts} &gt; 2, &quot;everyone&quot;, {!GreetingVar})</expression>
    </formulas>
    <interviewLabel>Email List Builder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Email List Builder</label>
    <loops>
