    <description>This flow checks both Inventory_Provider__c and Used_Inventory_Provider__c the same way we did with the DocuSign vendor logic.
If a valid vendor is found, assign and update the Account.
If the provider does not match or conflicts, set Temporary_Flag__c = “Vendor Mismatch” so account teams can review in reports.</description>
    <environments>Default</environments>
    <formulas>
        <name>HasNEWprovideronly</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK($Record.New_Inventory_Provider__c)),
    ISBLANK($Record.Used_Inventory_Provider__c)
)</expression>
    </formulas>
    <formulas>
        <name>HasUSEDprovideronly</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK($Record.Used_Inventory_Provider__c)),
    ISBLANK($Record.New_Inventory_Provider__c)
)</expression>
    </formulas>
    <formulas>
        <name>InputNewInventory</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER({!$Record.New_Inventory_Provider__c}), &quot; &quot;, &quot;&quot;),&quot;.&quot;, &quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;&amp;&quot;, &quot;&quot;),&quot;#&quot;, &quot;&quot;)</expression>
    </formulas>
