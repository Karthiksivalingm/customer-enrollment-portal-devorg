    <decisions>
        <description>This example decision node looks at the Contact that is calling and decides which Queue they should be routed to. Here, it checks both the name and country of the customer.</description>
        <name>CustomerRoutingDecision</name>
        <label>How should the customer be routed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>All Other Customers</defaultConnectorLabel>
        <rules>
            <name>Contact_Owner_is_Sandip</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetContact.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Raghav</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_to_Contact_Owner</targetReference>
            </connector>
            <label>Contact Owner is Sandip</label>
        </rules>
        <rules>
            <name>CustomerLocationOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetContact.MailingCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>USA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RouteToQueueA</targetReference>
            </connector>
            <label>Customer is in USA</label>
        </rules>
    </decisions>
    <description>Routes each call to an agent or queue based on conditions that you define.</description>
