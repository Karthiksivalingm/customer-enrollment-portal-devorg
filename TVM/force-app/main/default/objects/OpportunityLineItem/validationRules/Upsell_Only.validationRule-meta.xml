<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Upsell_Only</fullName>
    <active>true</active>
    <errorConditionFormula>Contract_Product_Name__c = &quot;Upsell Only&quot; &amp;&amp;
Opportunity.Opportunity_Type__c != &quot;Upsell&quot;&amp;&amp;

$Profile.Name != &quot;System Administrator&quot;</errorConditionFormula>
    <errorMessage>You cannot add this product to a New Sale Opportunity. Please remove the Product(s)</errorMessage>
</ValidationRule>
