<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reporting_This_Month_25th__c</fullName>
    <formula>if(
DAY(Today())&gt;=25, YEAR(ADDMONTHS(Budget_Month_Date__c, -1))=YEAR(TODAY()) &amp;&amp; MONTH(ADDMONTHS(Budget_Month_Date__c,-1))=MONTH(TODAY()),
YEAR(Budget_Month_Date__c)=YEAR(TODAY()) &amp;&amp; MONTH(Budget_Month_Date__c)=MONTH(TODAY())
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Reporting This Month (25th)</label>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
