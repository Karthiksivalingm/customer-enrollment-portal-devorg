<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Retail_Lock</fullName>
    <active>false</active>
    <errorConditionFormula>IsNull( Min_Price__c )=false &amp;&amp;
 UnitPrice &lt; Min_Price__c</errorConditionFormula>
    <errorMessage>Your price cannot go below Min_Price__c</errorMessage>
</ValidationRule>
