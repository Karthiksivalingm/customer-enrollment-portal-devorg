<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>If_case_is_future_type</fullName>
    <active>false</active>
    <description>FND</description>
    <errorConditionFormula>IF(AND(ISPICKVAL(Status_Filtered__c,&apos;Future&apos;),ISPICKVAL(Start_Month__c,&apos;&apos;)),true,false)</errorConditionFormula>
    <errorDisplayField>Start_Month__c</errorDisplayField>
    <errorMessage>You must have to select start month.</errorMessage>
</ValidationRule>
