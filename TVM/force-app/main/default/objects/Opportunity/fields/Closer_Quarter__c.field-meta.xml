<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closer_Quarter__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
  ISBLANK(Close_Date_Actual__c),
  &quot;&quot;,
  TEXT(YEAR(Close_Date_Actual__c)) &amp; &quot; Q&quot; &amp;
  TEXT(CEILING(MONTH(Close_Date_Actual__c) / 3))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Closed Quarter</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
