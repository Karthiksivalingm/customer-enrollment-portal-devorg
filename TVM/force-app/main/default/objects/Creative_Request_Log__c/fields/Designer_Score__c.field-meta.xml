<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Designer_Score__c</fullName>
    <externalId>false</externalId>
    <formula>if(
Initial_Complete_Event__c , 1,

if(
Designer_Change_Bucket__c != &quot;&quot;, 0.5, 0
))

* 

if(Creative_Request_Link__r.of_Web_Banners__c &lt;= 10, 1,
Round(Creative_Request_Link__r.of_Web_Banners__c / 10, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Designer Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
