<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dependence_Lock</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  Dependence_Lock__c = TRUE,
  NOT(ISNEW()),
  ISCHANGED(Task_Group_Status__c)
)</errorConditionFormula>
    <errorMessage>This Task Group is locked because one or more of the prerequisite Task Groups are not completed.</errorMessage>
</ValidationRule>
