<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Created_Tix_Set_to_New</fullName>
    <active>false</active>
    <errorConditionFormula>ISNULL(LastModifiedDate) &amp;&amp;  NOT(ISPICKVAL(Status__c, &quot;New&quot;))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>New tickets have to have Status = New</errorMessage>
</ValidationRule>
