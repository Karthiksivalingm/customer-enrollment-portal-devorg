<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Assignment_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>ISBLANK(OwnerId__c) &amp;&amp;
NOT(ISPICKVAL(Status__c, &quot;New&quot;)) &amp;&amp;
ISCHANGED(Status__c)</errorConditionFormula>
    <errorDisplayField>OwnerId__c</errorDisplayField>
    <errorMessage>You must select an Owner so the system knows who the designer is</errorMessage>
</ValidationRule>
