<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Users_cannot_change_Account_Name</fullName>
    <active>true</active>
    <description>Restricts Non-Integration Users from changing the Account Name in Salesforce.</description>
    <errorConditionFormula>ISCHANGED(Name) &amp;&amp; ( Active_Account_C__c ||  Active__c ) &amp;&amp;
(
$User.FirstName &lt;&gt; &quot;Salesforce&quot; &amp;&amp; $User.FirstName &lt;&gt; &quot;Derrick&quot;  &amp;&amp;  $Profile.Name &lt;&gt; &quot;System Administrator&quot; &amp;&amp;  $User.LastName &lt;&gt; &quot;Calacci&quot; &amp;&amp; $User.LastName &lt;&gt; &quot;Rabung&quot;
)</errorConditionFormula>
    <errorMessage>Users do not have the ability to change the Account Name directly in SF. To change the Account Name, first change it in Touchpoint.</errorMessage>
</ValidationRule>
