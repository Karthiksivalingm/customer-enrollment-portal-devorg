<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RSD_Lock</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED( Regional_Sales_Director__c ),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Exec&quot;
)</errorConditionFormula>
    <errorDisplayField>Regional_Sales_Director__c</errorDisplayField>
    <errorMessage>You can&apos;t change the RSD</errorMessage>
</ValidationRule>
